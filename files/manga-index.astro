---
// src/pages/manga/index.astro
// Same pattern as novel/index.astro — just swap the stats and unitLabel

import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryStats from "@/components/CategoryStats.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const mangaPosts = allPosts
  .filter((p) => p.data.category === "manga")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Update as your manga reading list grows
const stats = {
  completed: 0,
  total: 0,
  units: 0,
  unitLabel: "Chapters",
  avgRating: 0,
  reviewCount: mangaPosts.length,
};
---

<BaseLayout title="Manga | LazyNoman" description="Browse all Manga reviews on LazyNoman.">
  <main class="max-w-4xl mx-auto px-4 py-10">

    <div class="mb-6">
      <p class="text-xs text-neutral-400 uppercase tracking-widest mb-1">lazynoman / manga</p>
      <h1 class="text-3xl font-bold mb-1">Manga</h1>
      <p class="text-neutral-500 dark:text-neutral-400">My reading history, stats, and honest reviews.</p>
    </div>

    <CategoryStats {...stats} />

    <div class="flex border-b border-neutral-200 dark:border-neutral-700 mb-8 gap-1">
      {["Reviews", "Reading list", "Rankings"].map((tab, i) => (
        <button
          class:list={[
            "px-4 py-2 text-sm -mb-px",
            i === 0
              ? "border-b-2 border-neutral-900 dark:border-neutral-100 font-medium text-neutral-900 dark:text-neutral-100"
              : "text-neutral-500 dark:text-neutral-400 border-b-2 border-transparent hover:text-neutral-700 dark:hover:text-neutral-300",
          ]}
        >
          {tab}
        </button>
      ))}
    </div>

    {mangaPosts.length === 0 ? (
      <div class="text-center py-20 text-neutral-400">
        <p class="text-4xl mb-3">📖</p>
        <p class="text-sm">No manga reviews yet. Coming soon.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {mangaPosts.map((post) => (
          <a
            href={`/manga/${post.slug}/`}
            class="group rounded-xl border border-neutral-200 dark:border-neutral-700 overflow-hidden flex flex-col hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors"
          >
            {post.data.heroImage && (
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-40 object-cover"
                loading="lazy"
              />
            )}
            <div class="p-4 flex flex-col flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 px-2 py-0.5 rounded">manga</span>
                <span class="text-xs text-neutral-400">
                  {post.data.publishDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                </span>
              </div>
              <p class="font-semibold text-sm leading-snug mb-1 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                {post.data.title}
              </p>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 mt-auto pt-2">
                {post.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}

  </main>
</BaseLayout>
