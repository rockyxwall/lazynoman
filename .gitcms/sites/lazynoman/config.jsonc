{
  "version": "1",
  "media_path": "/public",
  "ssg_framework": "astro",
  "default_branch": "cms-git",
  "frontmatter_format": "yaml",
  "sitemap_url": "https://lazynoman.com/sitemap-index.xml",
  "publishing_mode": "editorial_workflow",
  "collections": [
    {
      "name": "novel",
      "git_path": "/src/content/novel/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": true
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description",
          "required": true
        },
        {
          "name": "pubDate",
          "type": "datetime",
          "label": "Pub Date",
          "required": true
        },
        {
          "name": "updatedDate",
          "type": "datetime",
          "label": "Updated Date"
        },
        {
          "name": "tags",
          "type": "multiselect",
          "label": "Tags",
          "options": [
            "list",
            "litrpg",
            "system",
            "cultivation",
            "ranking",
            "binge-worthy"
          ],
          "color": "blue"
        },
        {
          "name": "heroImage",
          "type": "image",
          "label": "Hero Image"
        }
      ]
    },
    {
      "name": "manga",
      "git_path": "/src/content/manga/",
      "file_extension": ".md",
      "filename_pattern": "",
      "collection_type": "flat",
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title",
          "required": true
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description",
          "required": true
        },
        {
          "name": "pubDate",
          "type": "datetime",
          "label": "Pub Date",
          "required": true
        },
        {
          "name": "updatedDate",
          "type": "datetime",
          "label": "Updated Date"
        },
        {
          "name": "tags",
          "type": "multiselect",
          "label": "Tags",
          "options": [
            "manhua",
            "above myriads",
            "cultivation",
            "beyond myriad peoples",
            "above ten thousand people",
            "i am unaware that i am the peerless martial god",
            "web novel",
            "xianxia"
          ],
          "color": "blue"
        },
        {
          "name": "category",
          "type": "text",
          "label": "Category"
        },
        {
          "name": "readingTime",
          "type": "text",
          "label": "Reading Time"
        },
        {
          "name": "heroImage",
          "type": "image",
          "label": "Hero Image"
        },
        {
          "name": "draft",
          "type": "boolean",
          "label": "Draft",
          "default": false
        }
      ]
    }
  ]
}
