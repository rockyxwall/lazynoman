---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";

const title = `Contact Us | ${SITE_TITLE} - Novel Review Blog`;
const description = "Get in touch with rockyxwall. Join the Discord community or reach out via GitHub.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="max-w-2xl mx-auto">
				<h1 class="text-4xl md:text-6xl font-bold mb-6">Contact Us</h1>
				<p class="text-xl md:text-2xl text-muted-foreground mb-12 max-w-2xl leading-relaxed">
					Have a suggestion, found a bug, or just want to talk novels? Reach out through any of the channels below.
				</p>

				<div class="grid gap-6 sm:grid-cols-2">
					<a
						href="https://discord.gg/cunXbtHm5g"
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-xl border border-border bg-card p-6 transition-colors hover:border-primary/40 hover:bg-accent no-underline"
					>
						<div class="flex items-center gap-3 mb-3">
							<svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6 text-primary" fill="currentColor">
								<path d="M20.317 4.369A19.79 19.79 0 0 0 15.885 3c-.21.375-.45.88-.617 1.28a18.27 18.27 0 0 0-5.535 0C9.565 3.88 9.32 3.375 9.11 3a19.74 19.74 0 0 0-4.435 1.37C1.86 8.59 1.094 12.7 1.476 16.756a19.9 19.9 0 0 0 6.06 3.057c.49-.665.927-1.372 1.302-2.115-.714-.27-1.398-.603-2.043-.99.171-.125.34-.255.5-.39 3.94 1.81 8.2 1.81 12.092 0 .163.135.332.265.5.39-.646.388-1.33.72-2.045.99.375.743.81 1.45 1.3 2.115a19.84 19.84 0 0 0 6.063-3.057c.448-4.7-.766-8.775-3.2-12.387ZM8.02 14.331c-1.183 0-2.157-1.085-2.157-2.42 0-1.334.955-2.42 2.157-2.42 1.21 0 2.176 1.094 2.157 2.42 0 1.335-.955 2.42-2.157 2.42Zm7.962 0c-1.183 0-2.157-1.085-2.157-2.42 0-1.334.955-2.42 2.157-2.42 1.21 0 2.176 1.094 2.157 2.42 0 1.335-.946 2.42-2.157 2.42Z"></path>
							</svg>
							<h2 class="text-lg font-bold">Discord</h2>
						</div>
						<p class="text-sm text-muted-foreground mb-4">Join the community, ask questions, or chat about novels.</p>
						<span class="inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:underline">
							Join Server
							<svg aria-hidden="true" viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M5 12h14m-4-4 4 4-4 4"/>
							</svg>
						</span>
					</a>

					<a
						href="https://github.com/rockyxwall"
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-xl border border-border bg-card p-6 transition-colors hover:border-primary/40 hover:bg-accent no-underline"
					>
						<div class="flex items-center gap-3 mb-3">
							<svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6 text-primary" fill="currentColor">
								<path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5Z"></path>
							</svg>
							<h2 class="text-lg font-bold">GitHub</h2>
						</div>
						<p class="text-sm text-muted-foreground mb-4">Report issues, suggest features, or browse the source code.</p>
						<span class="inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:underline">
							Open Profile
							<svg aria-hidden="true" viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M5 12h14m-4-4 4 4-4 4"/>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
