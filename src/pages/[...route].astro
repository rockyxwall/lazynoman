---
import { render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Comments from "../components/Comments.astro";
import Pagination from "../components/Pagination.astro";
import PostList from "../components/PostList.astro";
import Button from "@/components/Button.astro";
import {
  displayDate,
  getPages,
  getPublishedPosts,
  readingMinutes,
  relatedPosts,
  site,
  summary,
  taxonomySlug,
} from "../lib/content";
import {
  buildPageDescriptors,
  routeParam,
  type PageDescriptor,
} from "../lib/routes";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const descriptors = buildPageDescriptors(posts, await getPages());
  return descriptors.map((descriptor) => {
    let prevPost: import("../lib/content").Post | undefined;
    let nextPost: import("../lib/content").Post | undefined;
    if (descriptor.kind === "post") {
      const idx = posts.findIndex((p) => p.id === descriptor.post.id);
      if (idx !== -1) {
        nextPost = idx > 0 ? posts[idx - 1] : undefined;
        prevPost = idx < posts.length - 1 ? posts[idx + 1] : undefined;
      }
    }
    return {
      params: { route: routeParam(descriptor.route) },
      props: {
        descriptor,
        related:
          descriptor.kind === "post"
            ? relatedPosts(descriptor.post, posts)
            : [],
        prevPost,
        nextPost,
      },
    };
  });
}

interface Props {
  descriptor: PageDescriptor;
  related: import("../lib/content").Post[];
  prevPost?: import("../lib/content").Post;
  nextPost?: import("../lib/content").Post;
}
const { descriptor, related, prevPost, nextPost } = Astro.props;
if (descriptor.kind === "redirect")
  return Astro.redirect(descriptor.target, 301);

let Content: any;
let headings: Array<{ depth: number; slug: string; text: string }> = [];
if (descriptor.kind === "post")
  ({ Content, headings } = await render(descriptor.post));
if (descriptor.kind === "page") ({ Content } = await render(descriptor.page));
const title =
  descriptor.kind === "post"
    ? descriptor.post.data.title
    : descriptor.kind === "page"
      ? descriptor.page.data.title
      : descriptor.kind === "listing"
        ? descriptor.listing.title
        : descriptor.title;
const description =
  descriptor.kind === "post"
    ? summary(descriptor.post)
    : descriptor.kind === "page"
      ? descriptor.page.data.description
      : descriptor.kind === "listing"
        ? descriptor.listing.description
        : undefined;
const canonicalUrl = new URL(descriptor.route, site.url).toString();
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(canonicalUrl);
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const articleImage =
  descriptor.kind === "post" && descriptor.post.data.image
    ? `/${descriptor.post.data.image.replace(/^\//, "")}`
    : undefined;
const listingImage =
  descriptor.kind === "listing" && descriptor.listing.posts[0]?.data.image
    ? `/${descriptor.listing.posts[0].data.image.replace(/^\//, "")}`
    : undefined;
const pagination =
  descriptor.kind === "listing"
    ? descriptor.listing
    : descriptor.kind === "terms"
      ? {
          page: descriptor.page,
          pages: descriptor.pages,
          base: descriptor.root,
        }
      : undefined;
const previous =
  pagination && pagination.page > 1
    ? pagination.page === 2
      ? pagination.base
      : `${pagination.base}page/${pagination.page - 1}/`
    : undefined;
const next =
  pagination && pagination.page < pagination.pages
    ? `${pagination.base}page/${pagination.page + 1}/`
    : undefined;
const robots =
  descriptor.kind === "page" && descriptor.page.data.sitemap?.disable === true
    ? "noindex, follow"
    : undefined;
const feed =
  descriptor.kind === "listing"
    ? `${descriptor.listing.base}index.xml`
    : descriptor.kind === "terms"
      ? `${descriptor.root}index.xml`
      : undefined;
---

<BaseLayout
  title={title}
  description={description}
  canonical={descriptor.route}
  image={descriptor.kind === "post" ? descriptor.post.data.image : undefined}
  type={descriptor.kind === "post" ? "article" : "website"}
  publishedTime={descriptor.kind === "post"
    ? descriptor.post.data.date
    : undefined}
  preloadImage={listingImage}
  previous={previous}
  next={next}
  robots={robots}
  feed={feed}
>
  {
    descriptor.kind === "post" && (
      <>
        <div
          class="reading-progress"
          data-reading-progress
          aria-hidden="true"
        />
        <section class="section">
          <div class="container article-shell">
            <article class="reading display-flex flex-direction-column">
              <nav class="breadcrumb" aria-label="Breadcrumb">
                <ol>
                  <li>
                    <a href="/" aria-label="Home">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <>
                          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                          <polyline points="9 22 9 12 15 12 15 22" />
                        </>
                      </svg>
                      <span>Home</span>
                    </a>
                  </li>
                  {descriptor.post.data.categories?.[0] && (
                    <>
                      <li class="breadcrumb-separator" aria-hidden="true">
                        <svg
                          width="12"
                          height="12"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                      </li>
                      <li>
                        <a
                          href={`/categories/${taxonomySlug(descriptor.post.data.categories[0])}/`}
                        >
                          {descriptor.post.data.categories[0]}
                        </a>
                      </li>
                    </>
                  )}
                  <li class="breadcrumb-separator" aria-hidden="true">
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </li>
                  <li class="current" aria-current="page">
                    <span class="line-clamp-1">
                      {descriptor.post.data.title}
                    </span>
                  </li>
                </ol>
              </nav>

              <h1 class="heading text-style-h1">
                {descriptor.post.data.title}
              </h1>

              <div class="display-flex align-center flex-flow-wrap gap-3 margin-block-small text-style-small color-muted">
                {descriptor.post.data.categories.map((category) => (
                  <a
                    href={`/categories/${taxonomySlug(category)}/`}
                    class="VPBadge info"
                  >
                    {category}
                  </a>
                ))}
                <span class="display-flex align-center gap-1">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                    <line x1="16" x2="16" y1="2" y2="6" />
                    <line x1="8" x2="8" y1="2" y2="6" />
                    <line x1="3" x2="21" y1="10" y2="10" />
                  </svg>
                  <time datetime={descriptor.post.data.date}>
                    {displayDate(descriptor.post)}
                  </time>
                </span>
                <span>·</span>
                <span class="display-flex align-center gap-1">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  {readingMinutes(descriptor.post)} min read
                </span>
              </div>

              {articleImage && (
                <img
                  src={articleImage}
                  data-cf-image
                  alt={`${descriptor.post.data.title} featured image`}
                  width="1200"
                  height="675"
                  class="post-featured-image width-100 margin-top-2"
                />
              )}

              <div class="display-flex align-center flex-flow-wrap gap-2 margin-block-small">
                <span class="text-style-small color-muted">Share:</span>
                <Button
                  element="link"
                  href={`https://x.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
                  emphasis="secondary"
                  size="small"
                >
                  X (Twitter)
                </Button>
                <Button
                  element="link"
                  href={`https://bsky.app/intent/compose?text=${shareText}%20${shareUrl}`}
                  emphasis="secondary"
                  size="small"
                >
                  Bluesky
                </Button>
                <Button
                  element="link"
                  href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareText}`}
                  emphasis="secondary"
                  size="small"
                >
                  Reddit
                </Button>
                <Button
                  type="button"
                  data-copy-page
                  emphasis="secondary"
                  size="small"
                >
                  Copy link
                </Button>
              </div>

              <div class="rich-text article-body vp-doc width-100 margin-block-large">
                <Content />
              </div>

              {descriptor.post.data.tags.length > 0 && (
                <div class="display-flex flex-direction-column gap-2 margin-top-large width-100">
                  <h2 class="heading text-style-h2">Tags</h2>
                  <div class="button-wrapper">
                    {descriptor.post.data.tags.map((tag) => (
                      <Button
                        element="link"
                        href={`/tags/${taxonomySlug(tag)}/`}
                        emphasis="secondary"
                        size="small"
                      >
                        #{tag}
                      </Button>
                    ))}
                  </div>
                </div>
              )}

              {(prevPost || nextPost) && (
                <div class="doc-pager">
                  {prevPost ? (
                    <a class="pager-link prev" href={prevPost.data.url}>
                      <span class="pager-link-desc">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m15 18-6-6 6-6" />
                        </svg>
                        Previous post
                      </span>
                      <span class="pager-link-title">
                        {prevPost.data.title}
                      </span>
                    </a>
                  ) : (
                    <div />
                  )}
                  {nextPost ? (
                    <a class="pager-link next" href={nextPost.data.url}>
                      <span class="pager-link-desc">
                        Next post
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                      </span>
                      <span class="pager-link-title">
                        {nextPost.data.title}
                      </span>
                    </a>
                  ) : (
                    <div />
                  )}
                </div>
              )}

              {related.length > 0 && (
                <div
                  class="display-flex flex-direction-column gap-4 margin-top-large width-100"
                  aria-labelledby="related-heading"
                >
                  <h2 class="heading text-style-h2" id="related-heading">
                    Related posts
                  </h2>
                  <PostList posts={related} heading="h3" />
                </div>
              )}

              <Comments />
            </article>

            {toc.length > 0 && (
              <aside class="article-toc" aria-label="On this page">
                <details class="article-toc-details" data-responsive-toc open>
                  <summary>On this page</summary>
                  <nav data-toc>
                    <p class="eyebrow text-style-eyebrow">On this page</p>
                    <ol>
                      {toc.map((heading) => (
                        <li class:list={{ nested: heading.depth === 3 }}>
                          <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                </details>
              </aside>
            )}
          </div>
        </section>
      </>
    )
  }
  {
    descriptor.kind === "page" && (
      <section class="section">
        <div class="container">
          <article class="reading display-flex flex-direction-column">
            <h1 class="heading text-style-h1">{descriptor.page.data.title}</h1>
            {descriptor.page.data.description && (
              <p class="text text-style-large">
                {descriptor.page.data.description}
              </p>
            )}
            <div class="rich-text article-body vp-doc width-100 margin-block-large">
              <Content />
            </div>
          </article>
        </div>
      </section>
    )
  }
  {
    descriptor.kind === "listing" && (
      <section class="section">
        <div class="container">
          <p class="eyebrow text-style-eyebrow">
            {descriptor.route.startsWith("/categories/")
              ? "Topic"
              : descriptor.route.startsWith("/tags/")
                ? "Tag"
                : "Archive"}
          </p>
          <h1 class="heading text-style-h1">{descriptor.listing.title}</h1>
          {descriptor.listing.description && (
            <p class="text text-style-large">
              {descriptor.listing.description}
            </p>
          )}
          <PostList posts={descriptor.listing.posts} prioritizeFirst />
          <Pagination
            page={descriptor.listing.page}
            pages={descriptor.listing.pages}
            base={descriptor.listing.base}
          />
        </div>
      </section>
    )
  }
  {
    descriptor.kind === "terms" && (
      <section class="section">
        <div class="container">
          <h1 class="heading text-style-h1">{descriptor.title}</h1>
          <div class="button-wrapper">
            {descriptor.terms.map((term) => (
              <Button
                element="link"
                href={`${descriptor.root}${term.slug}/`}
                emphasis="secondary"
                size="small"
              >
                {term.name} ({term.count})
              </Button>
            ))}
          </div>
          <Pagination
            page={descriptor.page}
            pages={descriptor.pages}
            base={descriptor.root}
          />
        </div>
      </section>
    )
  }
</BaseLayout>
