---
import { render } from "astro:content";
import { List, ChevronDown } from "@lucide/astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import Comments from "../components/Comments.astro";
import NovelInfo from "../components/NovelInfo.astro";
import Pagination from "../components/Pagination.astro";
import PostList from "../components/PostList.astro";
import ShareButton from "../components/ShareButton.astro";
import {
  displayDate,
  getPages,
  getPublishedPosts,
  readingMinutes,
  relatedPosts,
  site,
  summary,
  taxonomySlug,
} from "../lib/content";
import { getNovelData } from "../lib/novel";
import {
  buildPageDescriptors,
  routeParam,
  type PageDescriptor,
} from "../lib/routes";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const descriptors = buildPageDescriptors(posts, await getPages());
  return descriptors.map((descriptor) => ({
    params: { route: routeParam(descriptor.route) },
    props: {
      descriptor,
      related:
        descriptor.kind === "post" ? relatedPosts(descriptor.post, posts) : [],
    },
  }));
}

interface Props {
  descriptor: PageDescriptor;
  related: import("../lib/content").Post[];
}
const { descriptor, related } = Astro.props;
if (descriptor.kind === "redirect")
  return Astro.redirect(descriptor.target, 301);

let Content: any;
let headings: Array<{ depth: number; slug: string; text: string }> = [];
if (descriptor.kind === "post")
  ({ Content, headings } = await render(descriptor.post));
if (descriptor.kind === "page") ({ Content } = await render(descriptor.page));
const title =
  descriptor.kind === "post"
    ? descriptor.post.data.title
    : descriptor.kind === "page"
      ? descriptor.page.data.title
      : descriptor.kind === "listing"
        ? descriptor.listing.title
        : descriptor.title;
const description =
  descriptor.kind === "post"
    ? summary(descriptor.post)
    : descriptor.kind === "page"
      ? descriptor.page.data.description
      : descriptor.kind === "listing"
        ? descriptor.listing.description
        : undefined;
const canonicalUrl = new URL(descriptor.route, site.url).toString();
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const articleImage =
  descriptor.kind === "post" && descriptor.post.data.image
    ? `/${descriptor.post.data.image.replace(/^\//, "")}`
    : undefined;
const listingImage =
  descriptor.kind === "listing" && descriptor.listing.posts[0]?.data.image
    ? `/${descriptor.listing.posts[0].data.image.replace(/^\//, "")}`
    : undefined;
const pagination =
  descriptor.kind === "listing"
    ? descriptor.listing
    : descriptor.kind === "terms"
      ? {
          page: descriptor.page,
          pages: descriptor.pages,
          base: descriptor.root,
        }
      : undefined;
const previous =
  pagination && pagination.page > 1
    ? pagination.page === 2
      ? pagination.base
      : `${pagination.base}page/${pagination.page - 1}/`
    : undefined;
const next =
  pagination && pagination.page < pagination.pages
    ? `${pagination.base}page/${pagination.page + 1}/`
    : undefined;
const robots =
  descriptor.kind === "page" && descriptor.page.data.sitemap?.disable === true
    ? "noindex, follow"
    : undefined;
const feed =
  descriptor.kind === "listing"
    ? `${descriptor.listing.base}index.xml`
    : descriptor.kind === "terms"
      ? `${descriptor.root}index.xml`
      : undefined;
const novelSlug =
  descriptor.kind === "post" ? descriptor.post.data.novel : undefined;
const novel = novelSlug ? getNovelData(novelSlug) : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={descriptor.route}
  image={descriptor.kind === "post" ? descriptor.post.data.image : undefined}
  type={descriptor.kind === "post" ? "article" : "website"}
  publishedTime={descriptor.kind === "post"
    ? descriptor.post.data.date
    : undefined}
  preloadImage={listingImage}
  previous={previous}
  next={next}
  robots={robots}
  feed={feed}
>
  {
    descriptor.kind === "post" && (
      <>
        <div
          class="reading-progress"
          data-reading-progress
          aria-hidden="true"
        />
        <article class="article-shell container">
          {toc.length > 0 && (
            <aside class="article-toc" aria-label="On this page">
              <div class="toc-sidebar-header">
                <List class="w-3.5 h-3.5 text-[var(--accent)]" />
                <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted)]">
                  On this page
                </span>
              </div>
              <nav data-toc>
                <ol>
                  {toc.map((heading) => (
                    <li class:list={{ nested: heading.depth === 3 }}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )}
          <div class="reading">
            {novel ? (
              <NovelInfo
                novel={novel}
                image={articleImage}
                post={descriptor.post}
                canonicalUrl={canonicalUrl}
              />
            ) : (
              <>
                <header class="article-header">
                  <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--text)] mb-3">
                    {descriptor.post.data.title}
                  </h1>
                  <div class="meta flex items-center justify-between gap-3 text-sm text-[var(--muted)] mb-3 flex-wrap">
                    <p class="flex items-center gap-2 m-0 p-0">
                      <time datetime={descriptor.post.data.date}>
                        {displayDate(descriptor.post)}
                      </time>{" "}
                      · {readingMinutes(descriptor.post)} min read
                    </p>
                    <ShareButton
                      title={descriptor.post.data.title}
                      url={canonicalUrl}
                    />
                  </div>
                  <div class="chips">
                    {descriptor.post.data.categories.map((category) => (
                      <a
                        class="chip"
                        href={`/categories/${taxonomySlug(category)}/`}
                      >
                        {category}
                      </a>
                    ))}
                  </div>
                </header>
                {articleImage && (
                  <img
                    class="article-image"
                    src={articleImage}
                    data-cf-image
                    alt={`${descriptor.post.data.title} featured image`}
                    width="1200"
                    height="675"
                  />
                )}
              </>
            )}

            {toc.length > 0 && (
              <aside
                class="article-toc-inline"
                aria-label="Table of contents"
                data-responsive-toc
              >
                <details class="toc-inline-details">
                  <summary class="toc-inline-summary">
                    <span class="flex items-center gap-2 text-sm font-bold text-[var(--text)]">
                      <List class="w-4 h-4 text-[var(--accent)]" />
                      <span>Table of Contents</span>
                      <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--surface-elv)] text-[var(--muted)] border border-[var(--border)] font-mono font-normal">
                        {toc.length}
                      </span>
                    </span>
                    <ChevronDown class="w-4 h-4 text-[var(--muted)] toc-chevron transition-transform duration-200" />
                  </summary>
                  <nav data-toc>
                    <ol class="toc-inline-list">
                      {toc.map((heading) => (
                        <li class:list={{ nested: heading.depth === 3 }}>
                          <a href={`#${heading.slug}`}>
                            <span class="toc-bullet" aria-hidden="true">
                              {heading.depth === 3 ? "›" : "•"}
                            </span>
                            <span>{heading.text}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                </details>
              </aside>
            )}

            <div class="article-body">
              <Content />
            </div>
            <aside class="ad-slot" data-ad-slot aria-label="Advertisement">
              <span>Advertisement</span>
              <ins
                class="adsbygoogle"
                style="display:block"
                data-ad-client="ca-pub-5027399024636019"
                data-ad-slot="2001915683"
                data-ad-format="auto"
                data-full-width-responsive="true"
              />
            </aside>
            {descriptor.post.data.tags.length > 0 && (
              <footer>
                <h2 class="text-xl font-bold mb-2">Tags</h2>
                <div class="chips">
                  {descriptor.post.data.tags.map((tag) => (
                    <a class="chip" href={`/tags/${taxonomySlug(tag)}/`}>
                      {tag}
                    </a>
                  ))}
                </div>
              </footer>
            )}
            {related.length > 0 && (
              <section aria-labelledby="related-heading">
                <h2 id="related-heading" class="text-2xl font-bold mb-4">
                  Related posts
                </h2>
                <PostList posts={related} heading="h3" />
              </section>
            )}
            <Comments />
          </div>
        </article>
      </>
    )
  }
  {
    descriptor.kind === "page" && (
      <article class="reading">
        <>
          <header class="article-header">
            <h1 class="text-3xl sm:text-4xl font-bold mb-3">
              {descriptor.page.data.title}
            </h1>
            {descriptor.page.data.description && (
              <p class="lede">{descriptor.page.data.description}</p>
            )}
          </header>
          <div class="article-body">
            <Content />
          </div>
        </>
      </article>
    )
  }
  {
    descriptor.kind === "listing" && (
      <section class="container listing-page">
        <>
          <header class="article-header">
            <h1 class="text-3xl sm:text-4xl font-bold mb-2">
              {descriptor.listing.title}
            </h1>
            {descriptor.listing.description && (
              <p class="lede">{descriptor.listing.description}</p>
            )}
          </header>
          <PostList posts={descriptor.listing.posts} prioritizeFirst />
          <Pagination
            page={descriptor.listing.page}
            pages={descriptor.listing.pages}
            base={descriptor.listing.base}
          />
        </>
      </section>
    )
  }
  {
    descriptor.kind === "terms" && (
      <section class="container">
        <>
          <h1 class="text-3xl sm:text-4xl font-bold mb-4">
            {descriptor.title}
          </h1>
          <div class="chips">
            {descriptor.terms.map((term) => (
              <a class="chip" href={`${descriptor.root}${term.slug}/`}>
                {term.name} ({term.count})
              </a>
            ))}
          </div>
          <Pagination
            page={descriptor.page}
            pages={descriptor.pages}
            base={descriptor.root}
          />
        </>
      </section>
    )
  }
</BaseLayout>
