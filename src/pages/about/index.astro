---
// src/pages/about/index.astro
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FeatureCard from '../../components/custom-ui/FeatureCard.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "../../components/ui/breadcrumb";

const SITE_TITLE = 'LazyNoman';
const SITE_DESCRIPTION = 'The philosophy and the mission behind LazyNoman.';

const writers = [
  {
    slug: 'rockyxwall',
    name: 'rockyxwall',
    role: 'Founder & Lead Reviewer',
    initial: 'R',
    tagline: 'Reads everything. Finishes most of it.',
  },
  {
    slug: 'nione',
    name: 'nione',
    role: 'Contributor',
    initial: 'N',
    tagline: 'Passionate about games and immersive simulations.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <Header />

    <main class="mx-auto w-full max-w-4xl px-4 pt-12 pb-24 overflow-x-hidden">
      <!-- Breadcrumb -->
      <Breadcrumb className="mb-8">
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href="/">Home</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>About</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>

      <article>
        <span class="inline-block text-xs font-medium text-muted-foreground tracking-widest uppercase mb-4">
          lazynoman.com — mission
        </span>

        <h1 class="text-4xl md:text-6xl font-bold mb-6">the purpose of this site</h1>
        <p class="text-xl md:text-2xl text-muted-foreground mb-12 max-w-2xl leading-relaxed">
          a place for personal reviews. no more, no less.
        </p>

        <hr class="my-12 border-border" />

        <div class="space-y-8">
          <p>
            LazyNoman is a space dedicated to sharing personal reviews on novels, manga, anime, and games. 
          </p>

          <p>
            The mission is simple: to document how I felt about a specific work. These reviews are entirely subjective. 
            They might not match your taste, and other people might have completely different opinions. **I don't care about that.**
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-10">
            <div class="bg-muted/50 border border-border rounded-xl px-5 py-4">
              <span class="block text-xl font-bold text-foreground mb-1">Personal</span>
              <p class="text-sm text-muted-foreground leading-snug">Every word is based on individual experience and feeling.</p>
            </div>
            <div class="bg-muted/50 border border-border rounded-xl px-5 py-4">
              <span class="block text-xl font-bold text-foreground mb-1">Subjective</span>
              <p class="text-sm text-muted-foreground leading-snug">Taste varies. We share ours without worrying if others agree.</p>
            </div>
            <div class="bg-muted/50 border border-border rounded-xl px-5 py-4">
              <span class="block text-xl font-bold text-foreground mb-1">Direct</span>
              <p class="text-sm text-muted-foreground leading-snug">No sugarcoating. Just an honest account of the experience.</p>
            </div>
          </div>

          <p>
            I won't try to be an "objective critic" or write reviews that please everyone. If I enjoyed something, I'll say why. 
            If I hated it or felt it was a waste of time, I'll say that too. 
          </p>

          <FeatureCard title="the core idea" class="my-12">
            this site exists because i wanted a record of my own journey through stories. if you find something useful here, great. if not, that's fine too.
          </FeatureCard>
        </div>
      </article>

      <hr class="my-20 border-border" />

      <!-- Team Section -->
      <section>
        <h2 class="text-sm font-bold tracking-widest uppercase text-muted-foreground mb-12">meet the writers</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {writers.map(w => (
            <a href={`/about/${w.slug}`} class="group flex items-center gap-6 p-6 bg-muted/30 border border-border rounded-3xl transition-all hover:bg-muted/50 hover:shadow-xl hover:border-muted-foreground/30">
              <div class="w-16 h-16 rounded-2xl bg-foreground text-background flex items-center justify-center text-3xl font-black group-hover:scale-110 transition-transform">
                {w.initial}
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">{w.name}</h3>
                <p class="text-sm text-muted-foreground font-medium mb-2 uppercase tracking-wide">{w.role}</p>
                <p class="text-sm text-muted-foreground italic truncate">"{w.tagline}"</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
