---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { Badge } from '../../components/ui/badge.tsx';
import { SITE_TITLE } from '../../consts';

const title = `About | ${SITE_TITLE}`;
const description = "who is rockyxwall?";

const GITHUB_URL = 'https://github.com/rockyxwall';
const DISCORD_URL = 'https://discord.gg/cunXbtHm5g';

// Reading-preference tags with color mappings
const readingTags = [
	{ label: 'cheat', className: 'bg-amber-100 dark:bg-amber-900 text-amber-900 dark:text-amber-100 hover:bg-amber-200 dark:hover:bg-amber-800' },
	{ label: 'system', className: 'bg-blue-100 dark:bg-blue-900 text-blue-900 dark:text-blue-100 hover:bg-blue-200 dark:hover:bg-blue-800' },
	{ label: 'transmigration', className: 'bg-purple-100 dark:bg-purple-900 text-purple-900 dark:text-purple-100 hover:bg-purple-200 dark:hover:bg-purple-800' },
	{ label: 'reincarnation', className: 'bg-pink-100 dark:bg-pink-900 text-pink-900 dark:text-pink-100 hover:bg-pink-200 dark:hover:bg-pink-800' },
	{ label: 'overpowered mc', className: 'bg-red-100 dark:bg-red-900 text-red-900 dark:text-red-100 hover:bg-red-200 dark:hover:bg-red-800' },
	{ label: 'male mc', className: 'bg-cyan-100 dark:bg-cyan-900 text-cyan-900 dark:text-cyan-100 hover:bg-cyan-200 dark:hover:bg-cyan-800' },
	{ label: 'fantasy', className: 'bg-indigo-100 dark:bg-indigo-900 text-indigo-900 dark:text-indigo-100 hover:bg-indigo-200 dark:hover:bg-indigo-800' },
	{ label: 'cultivation', className: 'bg-orange-100 dark:bg-orange-900 text-orange-900 dark:text-orange-100 hover:bg-orange-200 dark:hover:bg-orange-800' },
	{ label: 'xianxia', className: 'bg-emerald-100 dark:bg-emerald-900 text-emerald-900 dark:text-emerald-100 hover:bg-emerald-200 dark:hover:bg-emerald-800' },
	{ label: 'xuanhuan', className: 'bg-teal-100 dark:bg-teal-900 text-teal-900 dark:text-teal-100 hover:bg-teal-200 dark:hover:bg-teal-800' },
	{ label: 'low-key mc', className: 'bg-slate-100 dark:bg-slate-900 text-slate-900 dark:text-slate-100 hover:bg-slate-200 dark:hover:bg-slate-800' },
	{ label: 'cold mc', className: 'bg-sky-100 dark:bg-sky-900 text-sky-900 dark:text-sky-100 hover:bg-sky-200 dark:hover:bg-sky-800' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
				<!-- LEFT -->
				<div class="min-w-0 flex-1">
					<article>
						<h1 class="text-4xl md:text-6xl font-bold mb-6">who am i?</h1>
						<p class="text-xl md:text-2xl text-muted-foreground mb-8 max-w-2xl leading-relaxed">
							i'm <span class="text-foreground font-semibold">rockyxwall</span> — the person behind lazynoman.
							i read a stupid amount of webnovels and write down what i actually think.
						</p>

				<hr class="my-12" />

				<!-- bio -->
				<section class="space-y-8">
					<p>
						okay so. i read. a lot. webnovels mostly — the long, sprawling, hundreds-of-chapters kind that other
						people bounce off of. i'm not a 30-minutes-today, 30-minutes-tomorrow type either. when i'm into something
						i sit down and i go. full day. i don't rewatch, i don't reread, i just keep moving forward until there's
						nothing left.
					</p>

					<p>
						somewhere along the way i'd read so much that i started running out of stuff that actually matched my taste.
						and when you've consumed that much, two things happen. one — you develop opinions, strong ones. you can tell
						what actually works in a story from what's just filler dressed up nice. two — you start wanting to point other
						people at the good stuff so they don't waste their time on the rest.
					</p>

					<p>
						so that's what i do here. i read webnovels and i write honest reviews of them. i'm not a critic, i'm not a
						journalist, i'm just someone who's been neck-deep in this world long enough to have a real read on it. if
						something's mid, i'll say it's mid. if something wrecked me in the best way, i'll tell you that too.
					</p>

					<div class="flex flex-wrap gap-4 my-10">
						<div class="bg-muted/50 border border-border rounded-xl px-5 py-3 text-base">
							<strong class="text-foreground">6,675</strong> episodes watched
						</div>
						<div class="bg-muted/50 border border-border rounded-xl px-5 py-3 text-base">
							<strong class="text-foreground">14,653</strong> manga/manhua chapters read
						</div>
						<div class="bg-muted/50 border border-border rounded-xl px-5 py-3 text-base">
							<strong class="text-foreground">41,468</strong> novel chapters read
						</div>
					</div>
				</section>

				<hr class="my-12" />

				<!-- reading preferences as colored badges -->
				<section class="mb-12">
					<h2 class="text-sm font-bold tracking-widest uppercase text-muted-foreground mb-6">
						my taste in novels
					</h2>
					<p class="text-muted-foreground mb-6 max-w-2xl">
						the flavors i keep coming back to. if a novel has a few of these, odds are i've already read it.
					</p>
					<div class="flex flex-wrap gap-2">
						{readingTags.map(({ label, className }) => (
							<Badge className={className} client:load>
								{label}
							</Badge>
						))}
					</div>
				</section>

				<p class="text-xl">
					if you also ran out of good things to read and you're hunting for the next story that won't let you down —
					you're in the right place. welcome.
				</p>

				<p class="text-muted-foreground mt-16 flex items-center gap-2">
					— <span class="font-bold text-foreground text-lg tracking-tight">rockyxwall</span>
				</p>
			</article>
			</div>

			<!-- RIGHT: Contact sidebar (desktop) -->
			<aside class="hidden lg:block w-72 shrink-0">
				<div class="sticky top-24 space-y-4">
					<h3 class="text-sm font-semibold tracking-tight">Connect</h3>
					<a
						href={GITHUB_URL}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub profile"
						class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
					>
						<svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor">
							<path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5Z"/>
						</svg>
						GitHub
					</a>
					<a
						href={DISCORD_URL}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Discord server"
						class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
					>
						<svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor">
							<path d="M20.317 4.369A19.79 19.79 0 0 0 15.885 3c-.21.375-.45.88-.617 1.28a18.27 18.27 0 0 0-5.535 0C9.565 3.88 9.32 3.375 9.11 3a19.74 19.74 0 0 0-4.435 1.37C1.86 8.59 1.094 12.7 1.476 16.756a19.9 19.9 0 0 0 6.06 3.057c.49-.665.927-1.372 1.302-2.115-.714-.27-1.398-.603-2.043-.99.171-.125.34-.255.5-.39 3.94 1.81 8.2 1.81 12.092 0 .163.135.332.265.5.39-.646.388-1.33.72-2.045.99.375.743.81 1.45 1.3 2.115a19.84 19.84 0 0 0 6.063-3.057c.448-4.7-.766-8.775-3.2-12.387ZM8.02 14.331c-1.183 0-2.157-1.085-2.157-2.42 0-1.334.955-2.42 2.157-2.42 1.21 0 2.176 1.094 2.157 2.42 0 1.335-.955 2.42-2.157 2.42Zm7.962 0c-1.183 0-2.157-1.085-2.157-2.42 0-1.334.955-2.42 2.157-2.42 1.21 0 2.176 1.094 2.157 2.42 0 1.335-.946 2.42-2.157 2.42Z"/>
						</svg>
						Discord
					</a>
				</div>
			</aside>
		</div>
		</main>
		<Footer />
	</body>
</html>
