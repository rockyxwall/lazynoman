---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Under Construction | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-32 text-center">
			<div class="space-y-8">
				<div class="inline-block p-4 rounded-full bg-primary/10 text-primary animate-pulse">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-construction"><rect x="2" y="18" width="20" height="2" /><path d="M10 10l-6 8" /><path d="M14 10l6 8" /><path d="M7 6l3 4" /><path d="M17 6l-3 4" /><path d="M10 10l4 0" /><path d="M8 2l8 0" /><path d="M12 2l0 4" /></svg>
				</div>
				<h1 class="text-5xl font-black tracking-tighter italic uppercase italic">Under Construction</h1>
				<p class="text-xl text-muted-foreground max-w-lg mx-auto font-medium">
					This section of the archive is currently being built. I'm busy importing data and writing reviews. Check back soon!
				</p>
				<div class="pt-8">
					<a href="/novel" class="px-8 py-3 bg-primary text-primary-foreground rounded-xl font-black italic uppercase tracking-widest hover:opacity-90 transition-all shadow-lg shadow-primary/20 inline-block no-underline">
						Browse Novels Instead
					</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
