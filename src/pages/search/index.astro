---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Search"
  description="Search LazyNoman posts and reviews"
  canonical="/search/"
  robots="noindex, follow"
>
  <Section>
    <ContentWrapper>
      <Heading tag="h1">Search</Heading>
      <form role="search" data-search-form class="display-flex flex-direction-column gap-3 width-100">
        <label for="search-query" class="text-style-small">Search reviews and posts</label>
        <div class="display-flex gap-2 width-100">
          <input
            id="search-query"
            name="s"
            type="search"
            autocomplete="off"
            class="input_field flex-grow"
          />
          <Button type="submit">Search</Button>
        </div>
      </form>
      <p class="text-style-small color-muted" aria-live="polite" data-search-status>
        Enter a search term.
      </p>
      <div class="display-flex flex-direction-column gap-4 width-100" data-search-results></div>
    </ContentWrapper>
  </Section>
  <script>
    const form = document.querySelector<HTMLFormElement>("[data-search-form]");
    const input = document.querySelector<HTMLInputElement>("#search-query");
    const status = document.querySelector<HTMLElement>("[data-search-status]");
    const results = document.querySelector<HTMLElement>(
      "[data-search-results]",
    );
    let index:
      | Array<{
          title: string;
          tags: string[];
          categories: string[];
          contents: string;
          permalink: string;
        }>
      | undefined;
    let searchGeneration = 0;
    async function search(query: string) {
      if (!status || !results) return;
      const generation = ++searchGeneration;
      status.textContent = "Loading search index...";
      try {
        index ??= await fetch("/index.json").then((response) => {
          if (!response.ok) throw new Error("Search index failed to load");
          return response.json();
        });
        if (generation !== searchGeneration) return;
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
        const searchIndex = index ?? [];
        const matches = searchIndex
          .filter((item) => {
            const value = [
              item.title,
              item.contents,
              ...item.tags,
              ...item.categories,
            ]
              .join(" ")
              .toLowerCase();
            return terms.every((term) => value.includes(term));
          })
          .slice(0, 50);
        status.textContent = matches.length
          ? `${matches.length} result${matches.length === 1 ? "" : "s"}`
          : "No results found.";
        results.replaceChildren(
          ...matches.map((item) => {
            const article = document.createElement("article");
            article.className = "card card-body";
            const heading = document.createElement("h2");
            const link = document.createElement("a");
            link.href = item.permalink;
            link.textContent = item.title;
            heading.append(link);
            article.append(heading);
            return article;
          }),
        );
      } catch (error) {
        if (generation === searchGeneration)
          status.textContent =
            error instanceof Error ? error.message : "Search failed.";
      }
    }
    const initial = new URLSearchParams(location.search).get("s") ?? "";
    if (input) input.value = initial;
    if (initial) void search(initial);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input?.value.trim() ?? "";
      history.replaceState(
        {},
        "",
        query ? `/search/?s=${encodeURIComponent(query)}` : "/search/",
      );
      if (query) void search(query);
      else {
        searchGeneration += 1;
        results?.replaceChildren();
        if (status) status.textContent = "Enter a search term.";
      }
    });
  </script>
</BaseLayout>
