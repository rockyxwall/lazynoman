---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Search"
  description="Search LazyNoman posts and reviews"
  canonical="/search/"
  robots="noindex, follow"
>
  <section class="section">
    <div class="container">
      <h1 class="heading text-style-h1">Search</h1>
      <form
        role="search"
        data-search-form
        class="display-flex flex-direction-column gap-3 width-100"
      >
        <label for="search-query" class="text-style-small"
          >Search reviews and posts</label
        >
        <div class="display-flex gap-2 width-100">
          <input
            id="search-query"
            name="s"
            type="search"
            autocomplete="off"
            class="input_field flex-grow"
          />
          <Button type="submit">Search</Button>
        </div>
      </form>
      <p
        class="text-style-small color-muted"
        aria-live="polite"
        data-search-status
      >
        Enter a search term.
      </p>
      <div class="wotaku-grid" data-search-results></div>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>("[data-search-form]");
    const input = document.querySelector<HTMLInputElement>("#search-query");
    const status = document.querySelector<HTMLElement>("[data-search-status]");
    const results = document.querySelector<HTMLElement>(
      "[data-search-results]",
    );
    let index:
      | Array<{
          title: string;
          tags: string[];
          categories: string[];
          contents: string;
          permalink: string;
        }>
      | undefined;
    let searchGeneration = 0;
    async function search(query: string) {
      if (!status || !results) return;
      const generation = ++searchGeneration;
      status.textContent = "Loading search index...";
      try {
        index ??= await fetch("/index.json").then((response) => {
          if (!response.ok) throw new Error("Search index failed to load");
          return response.json();
        });
        if (generation !== searchGeneration) return;
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
        const searchIndex = index ?? [];
        const matches = searchIndex
          .filter((item) => {
            const value = [
              item.title,
              item.contents,
              ...item.tags,
              ...item.categories,
            ]
              .join(" ")
              .toLowerCase();
            return terms.every((term) => value.includes(term));
          })
          .slice(0, 50);
        status.textContent = matches.length
          ? `${matches.length} result${matches.length === 1 ? "" : "s"}`
          : "No results found.";
        results.replaceChildren(
          ...matches.map((item) => {
            const article = document.createElement("article");
            article.className = "wotaku-card quick-card";
            const body = document.createElement("div");
            body.className = "card-body";
            if (item.categories?.length) {
              const meta = document.createElement("div");
              meta.className = "card-meta";
              const badge = document.createElement("span");
              badge.className = "card-badge";
              badge.textContent = item.categories[0];
              meta.append(badge);
              body.append(meta);
            }
            const heading = document.createElement("h2");
            heading.className = "card-title";
            const link = document.createElement("a");
            link.href = item.permalink;
            link.textContent = item.title;
            heading.append(link);
            body.append(heading);
            if (item.contents) {
              const text = document.createElement("p");
              text.className = "card-text";
              text.textContent =
                item.contents.length > 140
                  ? `${item.contents.slice(0, 140)}...`
                  : item.contents;
              body.append(text);
            }
            const cta = document.createElement("span");
            cta.className = "card-cta";
            cta.textContent = "Read review →";
            body.append(cta);
            article.append(body);
            return article;
          }),
        );
      } catch (error) {
        if (generation === searchGeneration)
          status.textContent =
            error instanceof Error ? error.message : "Search failed.";
      }
    }
    const initial = new URLSearchParams(location.search).get("s") ?? "";
    if (input) input.value = initial;
    if (initial) void search(initial);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input?.value.trim() ?? "";
      history.replaceState(
        {},
        "",
        query ? `/search/?s=${encodeURIComponent(query)}` : "/search/",
      );
      if (query) void search(query);
      else {
        searchGeneration += 1;
        results?.replaceChildren();
        if (status) status.textContent = "Enter a search term.";
      }
    });
  </script>
</BaseLayout>
