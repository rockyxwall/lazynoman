---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/layout/BaseHead.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getStats, getAllNovels } from '../../lib/parseNovels';
import CategoryStats from '../../components/CategoryStats.astro';
import CategoryView from '../../components/common/CategoryView';
import PostCard from '../../components/blog/PostCard.astro';
import anilistData from '../../data/anilist.json';
import { db as dbStatic } from '../../lib/turso';

import { getCategories } from '../../lib/categories';

export const prerender = true;

export async function getStaticPaths() {
  const categories = getCategories();
  return categories.map(category => ({
    params: { category },
  }));
}

const { category } = Astro.params;

const posts = await getCollection('post');
const categoryPosts = posts
  .filter((p) => p.data.category === category)
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());

const db = Astro.locals.db || dbStatic;
const statsData = await getStats(db);
const categoryStats = (statsData as any)[category] || { total_finished: 0, total_read: 0, total_chapters: 0, avg_rating: 0 };
const categoryItems = await getAllNovels(db, category);

const unitLabels: Record<string, string> = {
  novel: "Chapters",
  manga: "Chapters",
  anime: "Episodes",
  movie: "Movies",
  game: "Games"
};

const unitActions: Record<string, string> = {
  novel: "read",
  manga: "read",
  anime: "watched",
  movie: "watched",
  game: "played"
};

// Calculate stats based on category source
let completed = 0;
let total = 0;
let units = 0;
let avgRating = 0;

if (categoryStats) {
  completed = categoryStats.total_finished;
  total = categoryStats.total_read;
  units = categoryStats.total_chapters;
  avgRating = categoryStats.avg_rating;
} else if (category === 'anime') {
  completed = anilistData.anime.statuses.find(s => s.status === 'COMPLETED')?.count || 0;
  total = anilistData.anime.count;
  units = anilistData.anime.episodesWatched;
  avgRating = anilistData.anime.meanScore / 10;
} else if (category === 'manga') {
  completed = anilistData.manga.statuses.find(s => s.status === 'COMPLETED')?.count || 0;
  total = anilistData.manga.count;
  units = anilistData.manga.chaptersRead;
  avgRating = anilistData.manga.meanScore / 10;
} else if (category === 'movie') {
  const movieCount = anilistData.anime.formats.find(f => f.format === 'MOVIE')?.count || 0;
  completed = movieCount; // Approximate
  total = movieCount;
  units = movieCount;
  avgRating = anilistData.anime.meanScore / 10;
}

// Override avgRating with review average if available
const reviewsWithRating = categoryPosts.filter(p => p.data.rating !== undefined);
if (reviewsWithRating.length > 0) {
    avgRating = reviewsWithRating.reduce((acc, p) => acc + (p.data.rating || 0), 0) / reviewsWithRating.length;
}

const stats = {
  completed,
  total,
  units,
  unitLabel: unitLabels[category] || "Units",
  unitAction: unitActions[category] || "tracked",
  avgRating,
  reviewCount: categoryPosts.length,
};

const statuses = ['Reading', 'Finished', 'Paused', 'Dropped', 'Plan to Read'];

const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-10">
			<!-- Page header -->
			<div class="mb-6">
				<h1 class="text-3xl font-bold mb-1 uppercase tracking-tight">{categoryName}</h1>
				<p class="text-neutral-500 dark:text-neutral-400">My {category === 'anime' ? 'watch' : 'reading'} history, stats, and honest reviews.</p>
			</div>

			<!-- Stats banner -->
			<CategoryStats {...stats} />

			<!-- Category View (Tabs, Search, Grid/List) -->
			<CategoryView 
				client:load 
				category={category} 
				reviews={categoryPosts} 
				items={categoryItems} 
				statuses={statuses} 
                anilistStats={(anilistData as any)[category === 'movie' ? 'anime' : (category || '')]}
			>
                {categoryPosts.map(post => (
                    <div slot="reviewsSlot" data-search-title={post.data.title}>
                        <PostCard post={post} />
                    </div>
                ))}
            </CategoryView>
		</main>
		<Footer />
	</body>
</html>
