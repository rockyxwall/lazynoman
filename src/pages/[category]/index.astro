---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('post');
  const categories = [...new Set(allPosts.map(post => post.id.split('/')[0]))];
  
  return categories.map(category => ({
    params: { category },
    props: { 
      categoryName: category.charAt(0).toUpperCase() + category.slice(1),
      posts: allPosts
        .filter(post => post.id.startsWith(category + '/'))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    }
  }));
}

const { categoryName, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
                max-width: 100%;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: 100%;
			}
			.card {
				display: flex;
				flex-direction: row;
				gap: 1.5rem;
				padding: 1.5rem;
				border: 1px solid var(--border);
				border-radius: 12px;
				background: var(--card);
				text-decoration: none;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
                color: inherit;
			}
			.card:hover {
				border-color: var(--primary);
                box-shadow: var(--box-shadow);
			}
			.card-image {
				flex: 0 0 240px;
				height: 160px;
				object-fit: cover;
				border-radius: 8px;
			}
			.card-content {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.title {
				margin: 0;
				color: var(--foreground);
				line-height: 1.2;
                font-size: 1.75rem;
                font-weight: 700;
			}
			.dates {
				margin: 0;
				color: var(--muted-foreground);
                font-size: 0.9rem;
                display: flex;
                gap: 1.5rem;
                flex-wrap: wrap;
                border-bottom: 1px solid var(--border);
                padding-bottom: 0.5rem;
			}
            .description {
                margin: 0;
                color: var(--foreground);
                opacity: 0.8;
                font-size: 1.1rem;
                line-height: 1.6;
                display: -webkit-box;
                -webkit-line-clamp: 4;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .read-more {
                margin-top: auto;
                font-weight: 600;
                color: var(--primary);
                display: flex;
                align-items: center;
                gap: 0.25rem;
            }
			@media (max-width: 720px) {
				.card {
					flex-direction: column;
                    padding: 1rem;
				}
                .card-image {
                    flex: 0 0 auto;
                    width: 100%;
                    height: 200px;
                }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
            <h1 class="mb-8">{categoryName}</h1>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/${post.id}/`} class="card">
									{post.data.heroImage && (
										<Image 
                                            width={480} 
                                            height={320} 
                                            src={post.data.heroImage} 
                                            alt="" 
                                            class="card-image"
                                        />
									)}
                                    <div class="card-content">
                                        <h2 class="title">{post.data.title}</h2>
                                        <div class="dates">
                                            <span>
                                                <strong>Published:</strong> <FormattedDate date={post.data.pubDate} />
                                            </span>
                                            {post.data.updatedDate && (
                                                <span>
                                                    <strong>Updated:</strong> <FormattedDate date={post.data.updatedDate} />
                                                </span>
                                            )}
                                        </div>
                                        <p class="description">{post.data.description}</p>
                                        <div class="read-more">
                                            Read Review &rarr;
                                        </div>
                                    </div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
