---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('post');
  const categories = [...new Set(allPosts.map(post => post.id.split('/')[0]))];

  return categories.map(category => ({
    params: { category },
    props: {
      categoryName: category.charAt(0).toUpperCase() + category.slice(1),
      posts: allPosts
        .filter(post => post.id.startsWith(category + '/'))
        .sort((a, b) => {
          const aDate = a.data.updatedDate ?? a.data.pubDate;
          const bDate = b.data.updatedDate ?? b.data.pubDate;
          return bDate.valueOf() - aDate.valueOf();
        }),
    },
  }));
}

const { categoryName, posts } = Astro.props;
const { category } = Astro.params;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${categoryName} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{categoryName}</h1>
        <p class="text-lg text-muted-foreground">
          All {categoryName.toLowerCase()} reviews — honest takes, no fluff.
        </p>
      </header>

      <section>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {posts.map((post) => (
            <PostCard
              client:load
              post={post}
              heroSrc={post.data.heroImage?.src}
              heroAlt={post.data.title}
            />
          ))}
        </div>

        {posts.length === 0 && (
          <div class="py-20 text-center">
            <p class="text-xl text-muted-foreground">No posts found in this category.</p>
            <a href="/" class="mt-4 inline-block text-primary font-bold hover:underline">&larr; Back to Home</a>
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
