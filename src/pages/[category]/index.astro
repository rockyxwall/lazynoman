---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('post');
  const categories = [...new Set(allPosts.map(post => post.id.split('/')[0]))];
  
  return categories.map(category => ({
    params: { category },
    props: { 
      categoryName: category.charAt(0).toUpperCase() + category.slice(1),
      posts: allPosts
        .filter(post => post.id.startsWith(category + '/'))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    }
  }));
}

const { categoryName, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow">
            <h1 class="text-3xl font-bold mb-8">{categoryName}</h1>
			<section>
				<ul class="flex flex-col gap-6">
					{
						posts.map((post) => (
							<li>
								<a href={`/${post.id}/`} class="flex flex-col md:flex-row gap-6 p-4 md:p-6 rounded-xl border border-border bg-card hover:border-primary hover:shadow-lg transition-all group no-underline text-foreground">
									{post.data.heroImage && (
										<div class="md:w-64 flex-shrink-0">
                                            <Image 
                                                width={480} 
                                                height={320} 
                                                src={post.data.heroImage} 
                                                alt="" 
                                                class="w-full h-48 md:h-40 object-cover rounded-lg shadow-sm"
                                            />
                                        </div>
									)}
                                    <div class="flex flex-col flex-grow gap-3">
                                        <h2 class="text-2xl font-bold group-hover:text-primary transition-colors leading-tight">{post.data.title}</h2>
                                        <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted-foreground border-b border-border pb-2">
                                            <span>
                                                <strong class="font-semibold">Published:</strong> <FormattedDate date={post.data.pubDate} />
                                            </span>
                                            {post.data.updatedDate && (
                                                <span>
                                                    <strong class="font-semibold">Updated:</strong> <FormattedDate date={post.data.updatedDate} />
                                                </span>
                                            )}
                                        </div>
                                        <p class="text-muted-foreground line-clamp-3 md:line-clamp-4 leading-relaxed">{post.data.description}</p>
                                        <div class="mt-auto pt-2 font-bold text-primary flex items-center gap-1">
                                            Read Review <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                                        </div>
                                    </div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
