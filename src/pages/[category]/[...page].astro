---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostCard from "../../components/PostCard";
import { PaginationBar } from "@/components/ui/pagination";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

export async function getStaticPaths({ paginate }) {
  const ITEMS_PER_PAGE = 9;
  const allPosts = await getCollection("post");
  const categories = [
    ...new Set(allPosts.map((post) => post.id.split("/")[0])),
  ];

  const paths = [];
  for (const category of categories) {
    const filtered = allPosts
      .filter((post) => post.id.startsWith(category + "/"))
      .sort((a, b) => {
        const aDate = a.data.updatedDate ?? a.data.pubDate;
        const bDate = b.data.updatedDate ?? b.data.pubDate;
        return bDate.valueOf() - aDate.valueOf();
      });

    const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
    const paginated = paginate(filtered, {
      params: { category },
      props: { categoryName },
      pageSize: ITEMS_PER_PAGE,
    });
    paths.push(...paginated);
  }
  return paths;
}

const { page, categoryName } = Astro.props;
const { category } = Astro.params;

const cards = await Promise.all(
  page.data.map(async (post) => ({
    post,
    heroSrc: post.data.heroImage
      ? (await getImage({ src: post.data.heroImage })).src
      : undefined,
  })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${categoryName} - ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <Header />
    <main>
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{categoryName}</h1>
        <p class="text-lg text-muted-foreground">
          All {categoryName.toLowerCase()} reviews.
        </p>
      </header>

      <section>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            cards.map(({ post, heroSrc }) => (
              <PostCard
                client:load
                post={post}
                heroSrc={heroSrc}
                heroAlt={post.data.title}
              />
            ))
          }
        </div>

        {
          cards.length === 0 && (
            <div class="py-20 text-center">
              <p class="text-xl text-muted-foreground">
                No posts found in this category.
              </p>
              <a
                href="/"
                class="mt-4 inline-block text-primary font-bold hover:underline"
              >
                &larr; Back to Home
              </a>
            </div>
          )
        }
      </section>

      <div class="mt-12 pt-8 border-t" style="border-color:var(--border)">
        <PaginationBar
          client:load
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          baseUrl={`/${category}/`}
        />
      </div>
    </main>
    <Footer />
  </body>
</html>
