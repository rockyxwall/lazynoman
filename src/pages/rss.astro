---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import { getPublishedPosts, taxonomy } from "../lib/content";

const categories = [
  ...taxonomy(await getPublishedPosts(), "categories").entries(),
].sort((a, b) => a[1].name.localeCompare(b[1].name));
---

<BaseLayout
  title="RSS Feeds"
  description="Subscribe to LazyNoman posts and reviews by RSS"
  canonical="/rss/"
  robots="noindex, follow"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow text-style-eyebrow">Subscribe your way</p>
      <h1 class="heading text-style-h1">RSS Feeds</h1>
      <p class="text text-style-large">
        Follow every post or choose a topic-specific feed.
      </p>

      <a
        href="/index.xml"
        class="feature-card width-100"
        style="max-width: 560px;"
      >
        <div class="feature-card-inner">
          <div class="feature-icon-box" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M4 11a9 9 0 0 1 9 9"></path><path
                d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"
              ></circle></svg
            >
          </div>
          <h2 class="card-title">All posts</h2>
          <p class="card-text">
            Subscribe to the main RSS feed for all reviews, recommendations, and
            updates.
          </p>
        </div>
      </a>

      <h2 class="heading text-style-h2">Topics</h2>
      <div class="button-wrapper">
        {
          categories.map(([slug, group]) => (
            <Button
              element="link"
              href={`/categories/${slug}/index.xml`}
              emphasis="secondary"
              size="small"
            >
              {group.name} RSS
            </Button>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
