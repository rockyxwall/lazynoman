---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { loadNovels } from '../../lib/parseNovels';
import { Badge } from '../../components/ui/badge';

import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "../../components/ui/breadcrumb";

const novels = await loadNovels();
const reviews = await getCollection('post', ({ id }) => id.startsWith('novel/'));

// Sort by startDate (desc)
const sortedNovels = [...novels].sort((a, b) => {
  if (!a.startDate) return 1;
  if (!b.startDate) return -1;
  return new Date(b.startDate).getTime() - new Date(a.startDate).getTime();
});

const statusColors: Record<string, string> = {
  Reading: "bg-blue-500/10 text-blue-500 border-blue-500/20",
  Finished: "bg-green-500/10 text-green-500 border-green-500/20",
  Dropped: "bg-red-500/10 text-red-500 border-red-500/20",
  Paused: "bg-yellow-500/10 text-yellow-500 border-yellow-500/20",
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Novels | ${SITE_TITLE}`} description={`Tracking my reading progress across various web novels. ${novels.length} titles and counting.`} />
	</head>
	<body>
		<Header />
		<main>
            <Breadcrumb className="mb-8">
                <BreadcrumbList>
                    <BreadcrumbItem>
                        <BreadcrumbLink href="/">Home</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem>
                        <BreadcrumbPage>Novels</BreadcrumbPage>
                    </BreadcrumbItem>
                </BreadcrumbList>
            </Breadcrumb>

            <header class="mb-12">
                <h1 class="text-4xl md:text-5xl font-bold mb-4">Novel Tracker</h1>
                <p class="text-lg text-muted-foreground">
                    My personal log of every web novel I've touched.
                </p>
            </header>
			
			<section>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{
						sortedNovels.map((novel) => (
							<a href={`/novel/${novel.slug}`} class="group block p-5 bg-card border border-border rounded-xl hover:border-primary transition-colors no-underline">
                <div class="flex justify-between items-start mb-3">
                  <Badge variant="outline" class={`${statusColors[novel.status] || "bg-muted text-muted-foreground"} text-[10px] uppercase font-bold tracking-tighter px-2 py-0`}>
                    {novel.status}
                  </Badge>
                  {novel.rating > 0 && <span class="text-xs font-bold text-primary">⭐ {novel.rating}</span>}
                </div>
                <h3 class="text-lg font-bold group-hover:text-primary transition-colors line-clamp-2 mb-2 leading-tight">
                  {novel.name}
                </h3>
                <div class="flex items-end justify-between mt-auto pt-2 border-t border-border/50">
                  <div class="text-xs text-muted-foreground">
                    <span class="font-bold text-foreground">{novel.readChapters}</span> chapters read
                  </div>
                  {novel.totalChapters > 0 && (
                    <div class="text-[10px] text-muted-foreground/60 italic">
                      of {novel.totalChapters}
                    </div>
                  )}
                </div>
              </a>
						))
					}
				</div>
                
                {novels.length === 0 && (
                    <div class="py-20 text-center">
                        <p class="text-xl text-muted-foreground">No novels found. Export your Notion CSV to src/data/novels.csv.</p>
                        <a href="/" class="mt-4 inline-block text-primary font-bold hover:underline">&larr; Back to Home</a>
                    </div>
                )}
			</section>
		</main>
		<Footer />
	</body>
</html>
