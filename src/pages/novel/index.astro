---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getAllNovels } from '../../lib/parseNovels';
import NovelList from '../../components/NovelList';
import { getCollection } from 'astro:content';

const db = Astro.locals.db;
const novels = await getAllNovels(db);
const reviewedReviews = (await getCollection('post'))

	.filter(p => p.data.category === 'novel')
	.map(p => ({ id: p.id, heroImage: p.data.heroImage }));
const genres = [...new Set(novels.flatMap(n => n.genres))].sort();
const statuses = ['Reading', 'Finished', 'Paused', 'Dropped', 'Plan to Read'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Novel Tracker | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-6xl mx-auto px-4 py-12">
			<NovelList client:load initialNovels={novels} genres={genres} statuses={statuses} reviewedReviews={reviewedReviews} />
		</main>
		<Footer />

		<style is:global>
			.novel-card {
				--hd: 'Atkinson', sans-serif;
				--mn: 'Geist Mono', monospace;
				--sn: 'Inter', sans-serif;
			}
			.novel-card .title {
				font-family: var(--hd);
			}
			.novel-card .font-mono {
				font-family: var(--mn);
			}
			.novel-card .cover-typo-bg {
				font-family: var(--hd);
				user-select: none;
				pointer-events: none;
			}
		</style>
	</body>
</html>
