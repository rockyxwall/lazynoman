---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/layout/BaseHead.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getStats, getAllNovels } from '../../lib/parseNovels';
import CategoryStats from '../../components/CategoryStats.astro';
import CategoryView from '../../components/common/CategoryView';
import PostCard from '../../components/blog/PostCard.astro';

const db = Astro.locals.db;
const statsData = await getStats(db);
const novelStats = statsData.novel;

const novelPosts = (await getCollection('post'))
  .filter((p) => p.data.category === 'novel')
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());

const novelItems = await getAllNovels(db, 'novel');

const stats = {
  completed: novelStats.total_finished,
  total: novelStats.total_read,
  units: novelStats.total_chapters,
  unitLabel: "Chapters",
  avgRating: novelStats.avg_rating,
  reviewCount: novelPosts.length,
};

const statuses = ['Reading', 'Finished', 'Paused', 'Dropped', 'Plan to Read'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Novel | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-10">
			<!-- Page header -->
			<div class="mb-6">
				<h1 class="text-3xl font-bold mb-1 uppercase tracking-tight">Novel</h1>
				<p class="text-neutral-500 dark:text-neutral-400">My reading history, stats, and honest reviews.</p>
			</div>

			<!-- Stats banner -->
			<CategoryStats {...stats} />

			<!-- Category View (Tabs, Search, Grid/List) -->
			<CategoryView 
				client:load 
				category="novel" 
				reviews={novelPosts} 
				items={novelItems} 
				statuses={statuses} 
			>
                {novelPosts.map(post => (
                    <div slot="reviewsSlot" data-search-title={post.data.title}>
                        <PostCard post={post} />
                    </div>
                ))}
            </CategoryView>
		</main>
		<Footer />
	</body>
</html>
