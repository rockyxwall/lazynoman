---
import { getCollection, render } from 'astro:content';
import { getNovelBySlug } from '../../lib/parseNovels';
import InfoLayout from '../../layouts/InfoLayout.astro';

const { slug } = Astro.params;
const db = Astro.locals.db;

if (!slug) {
	return Astro.rewrite('/404');
}

// Redirect old Google indexed review URLs to the novel's canonical URL
if (slug.endsWith('-review')) {
	return Astro.redirect(`/novel/${slug.replace(/-review$/, '')}`, 301);
}

const novel = await getNovelBySlug(slug, db);

if (!novel) {
	return Astro.rewrite('/404');
}

// Try to find a matching review in content collections
const allPosts = await getCollection('post');
const review = allPosts.find(p => {
	if (p.data.category !== 'novel') return false;
	const postId = p.id.toLowerCase();
	const novelSlug = novel.slug.toLowerCase();
	return postId.includes(novelSlug) || novelSlug.includes(postId.split('/').pop() || '');
});
const { Content } = review ? await render(review) : { Content: null };
---

<InfoLayout novel={novel} review={review}>
	{Content ? (
		<div class="prose prose-lg dark:prose-invert max-w-none prose-headings:font-black prose-headings:tracking-tighter prose-a:text-primary">
			<Content />
		</div>
	) : (
		<section class="p-8 rounded-xl bg-muted/30 border border-border text-center space-y-4">
			<p class="text-muted-foreground font-medium">No detailed review available yet for this title.</p>
		</section>
	)}
</InfoLayout>
