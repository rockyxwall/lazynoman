---
import { getCollection, render } from 'astro:content';
import { getNovelBySlug } from '../../lib/parseNovels';
import PostLayout from '../../layouts/PostLayout.astro';

const { slug } = Astro.params;
const db = Astro.locals.db;

if (!slug) {
	return Astro.rewrite('/404');
}

// Redirect old Google indexed review URLs to the novel's canonical URL
if (slug.endsWith('-review')) {
	return Astro.redirect(`/novel/${slug.replace(/-review$/, '')}`, 301);
}

const novel = await getNovelBySlug(slug, db);

if (!novel) {
	return Astro.rewrite('/404');
}

// Try to find a matching review in content collections
const allPosts = await getCollection('post');
const review = allPosts.find(p => {
	if (p.data.category !== 'novel') return false;
	const postId = p.id.toLowerCase();
	const novelSlug = novel.slug.toLowerCase();
	return postId.includes(novelSlug) || novelSlug.includes(postId.split('/').pop() || '');
});

if (!review) {
	return Astro.rewrite('/404');
}

const { Content } = await render(review);
---

<PostLayout {...review.data}>
	<Content />
</PostLayout>
