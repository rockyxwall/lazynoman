---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/bloxfruit.css";

const mcImage = "/images/2026/infinite-mana-in-the-apocalypse.webp";
---

<BaseLayout
  title="BloxFruit RPG Review UI Demo - LazyNoman"
  description="Blox Fruits Wiki UI styling tailored for webnovel reviews"
  canonical="/bloxfruit-demo/"
>
  <!-- Full canvas wrapper with authentic Blox Fruits Wiki background #161714 -->
  <div
    style="background-color: #161714; color: #e2e8f0; min-height: 100vh; padding: 2.5rem 1rem;"
  >
    <main style="max-width: 920px; margin: 0 auto;">
      <!-- Title & Eyebrow with Traffic-03 -->
      <header style="margin-bottom: 2rem;">
        <p
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.1rem; margin-bottom: 0.5rem; letter-spacing: 0.5px;"
        >
          ★ SYSTEM INTERFACE · BLOXFRUIT RPG THEME
        </p>
        <h1
          class="Traffic-03"
          style="font-size: 2.4rem; color: #ffffff; margin: 0 0 0.5rem 0;"
        >
          Webnovel Review RPG Components
        </h1>
        <p style="color: #9ca3af; font-size: 1rem;">
          Pruned of wiki bloat (crafting/gacha). Kept high-leverage UI for
          progression fantasy reviews.
        </p>
      </header>

      <!-- 1. Editorial Alert Box (System Notification) -->
      <div class="hatnote" style="margin-bottom: 2.5rem;">
        <strong class="Traffic-03" style="color: #ffd700;"
          >SYSTEM NOTICE:</strong
        >
        This review contains in-depth cultivation realm spoilers and power system
        breakdowns.
        <span class="legendarychroma" style="margin-left: 8px;"
          >[VERIFIED SSS-TIER NOVEL]</span
        >
      </div>

      <!-- 2. Authentic BFW Arcade Buttons -->
      <section
        style="background: #20201b; padding: 1.5rem; border-radius: 8px; border: 1px solid #3b3b3b; margin-bottom: 2.5rem;"
      >
        <h2
          class="Traffic-03"
          style="font-size: 1.3rem; margin-top: 0; color: #ffd700; margin-bottom: 1rem;"
        >
          1. Arcade Action Buttons
        </h2>
        <p style="color: #9ca3af; font-size: 0.9rem; margin-bottom: 1rem;">
          High-contrast, tactile CTAs for novel links and spoiler toggles:
        </p>
        <div
          style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center;"
        >
          <a href="#status-window" class="bfw-button"> Read First Chapter </a>
          <a href="#scorecard" class="bfw-button"> Jump to Verdict </a>
          <button type="button" class="bfw-button-toggle">
            Hide Spoilers
          </button>
          <button type="button" class="button1"> Bookmark Review </button>
        </div>
      </section>

      <!-- 3. Rarity Tier Badges & Glowing Cards -->
      <section
        style="background: #20201b; padding: 1.5rem; border-radius: 8px; border: 1px solid #3b3b3b; margin-bottom: 2.5rem;"
      >
        <h2
          class="Traffic-03"
          style="font-size: 1.3rem; margin-top: 0; color: #ffd700; margin-bottom: 1rem;"
        >
          2. Novel Rating & Tier Badges
        </h2>

        <p style="color: #9ca3af; font-size: 0.9rem; margin-bottom: 1rem;">
          Pill tags for tier lists, recommendation cards, and article headers:
        </p>
        <div
          style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1.5rem;"
        >
          <span
            class="Bg(--Mythical) Bd(--Mythical) Bxsh(--Mythical) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
          >
            ★ MYTHICAL · SSS TIER
          </span>
          <span
            class="Bg(--Legendary) Bd(--Legendary) Bxsh(--Legendary) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
          >
            ◆ LEGENDARY · S TIER
          </span>
          <span
            class="Bg(--Rare) Bd(--Rare) Bxsh(--Rare) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
          >
            ▲ RARE · A TIER
          </span>
          <span
            class="Bg(--Uncommon) Bd(--Uncommon) Bxsh(--Uncommon) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
          >
            ● UNCOMMON · B TIER
          </span>
          <span
            class="Bg(--Common) Bd(--Common) Bxsh(--Common) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
          >
            ■ COMMON · C TIER
          </span>
        </div>

        <p style="color: #9ca3af; font-size: 0.9rem; margin-bottom: 0.8rem;">
          Full Glowing Rarity Cards (For Recommended Novels):
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px;">
          <div class="card-tooltips(Mythical)">
            Infinite Mana in the Apocalypse
          </div>
          <div class="card-tooltips(Legendary)">Fantasy Simulator</div>
          <div class="card-tooltips(Rare)">The Innkeeper</div>
        </div>
      </section>

      <!-- 4. Protagonist RPG System Status Window -->
      <section
        id="status-window"
        style="background: #252427; padding: 1.5rem; border-radius: 8px; border: 2px solid #d5ac04; box-shadow: inset 0 0 5px 0 #ffe00059, 0 6px 20px 2px #ffe0001a; margin-bottom: 2.5rem;"
      >
        <h2
          class="Traffic-03"
          style="font-size: 1.3rem; margin-top: 0; color: #ffd700; margin-bottom: 1.2rem;"
        >
          3. Protagonist System Status Card
        </h2>

        <div
          style="display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start;"
        >
          <!-- Boss / MC Box -->
          <div
            class="boss-box1"
            style="width: 160px; text-align: center; padding-bottom: 10px;"
          >
            <div
              style="width: 160px; height: 180px; background: #0c121c; overflow: hidden;"
            >
              <img
                src={mcImage}
                alt="Noah Osmont"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
            </div>
            <p
              class="Traffic-03"
              style="margin: 8px 0 2px; font-size: 0.95rem; color: #ffd700;"
            >
              Noah Osmont
            </p>
            <span class="C(--Mythical) Traffic-03" style="font-size: 0.8rem;"
              >Apex Paragon</span
            >
          </div>

          <!-- Right Side: Stats & Skill Card -->
          <div style="flex: 1; min-width: 280px;">
            <!-- Currencies / Stat Counters -->
            <div
              style="display: flex; gap: 14px; margin-bottom: 1.2rem; flex-wrap: wrap;"
            >
              <span class="color-currency(Money)">Mana: ∞ INFINITE</span>
              <span class="color-currency(Fragment)">Fragments: 999,999+</span>
              <span class="color-currency(Valor)">Dao: Slaughter & Fate</span>
            </div>

            <!-- Cheat / Skill Card -->
            <div class="EventShop" style="width: 100%;">
              <table style="width: 100%; border-collapse: collapse;">
                <thead>
                  <tr>
                    <th style="text-align: left;">Innate Cheat Ability</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td style="padding: 8px;">
                      <div class="EventShop_Item">
                        <div class="EventShop_Item_Name">
                          <span style="color: #67e8f9;"
                            >Infinite Mana Engine</span
                          >
                        </div>
                        <div class="EventShop_Item_Box">
                          <span
                            style="font-size: 0.85rem; color: #e2e8f0; text-align: center; line-height: 1.4;"
                          >
                            Allows continuous casting of Universal and Cosmic
                            forbidden spells with 0 cooldown and 0 mana
                            exhaustion.
                          </span>
                          <div class="EventShop_Item_Price">COST: 0 MP</div>
                        </div>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Novel Scorecard Table -->
      <section id="scorecard" style="margin-bottom: 2.5rem;">
        <h2
          class="Traffic-03"
          style="font-size: 1.3rem; margin-top: 0; color: #ffd700; margin-bottom: 1rem;"
        >
          4. Novel Spec Scorecard Table
        </h2>
        <table class="bfw-table">
          <thead>
            <tr>
              <th colspan="2"
                >Infinite Mana in the Apocalypse — Review Scorecard</th
              >
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="width: 50%;">
                <div class="bfw-table-cell">
                  <b>Progression Speed:</b> Instant Cheat / Exponential Growth
                </div>
              </td>
              <td style="width: 50%;">
                <div class="bfw-table-cell">
                  <b>World Scope:</b> Infinite Universes & Dimensional Realms
                </div>
              </td>
            </tr>
            <tr>
              <td>
                <div class="bfw-table-cell">
                  <b>Romance / Harem:</b> Conquest Focused (Zero Drama)
                </div>
              </td>
              <td>
                <div class="bfw-table-cell">
                  <b>Final Verdict:</b>
                  <span class="C(--Mythical) Traffic-03"
                    >9.8 / 10 · Must Read</span
                  >
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Navigation link -->
      <footer
        style="text-align: center; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #282824;"
      >
        <a
          href="/"
          class="Traffic-03"
          style="color: #ffd700; text-decoration: none; font-size: 1.1rem;"
        >
          ← Back to LazyNoman Home
        </a>
      </footer>
    </main>
  </div>
</BaseLayout>
