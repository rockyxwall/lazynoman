---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/bloxfruit.css";
---

<BaseLayout
  title="Blox Fruits Wiki UI Components - LazyNoman"
  description="Complete showcase of all Blox Fruits wiki components and official theme background"
  canonical="/bloxfruit-demo/"
>
  <div class="bloxfruit-page-wrapper">
    <div style="max-width: 1040px; margin: 0 auto; padding: 2.5rem 1rem;">
      <!-- Top Title Badge -->
      <header
        style="text-align: center; margin-bottom: 2.5rem; position: relative;"
      >
        <div class="bfw-header-badge" style="margin-bottom: 1rem;">
          BLOX FRUITS WIKI UI · SYSTEM SHOWCASE
        </div>
        <p
          style="color: #ffd700; font-family: Traffic-03; font-size: 1.1rem; margin: 0 0 0.5rem 0;"
        >
          Loaded with Official Wiki Background & Local Assets
        </p>
        <p style="color: #94a3b8; font-size: 0.95rem;">
          Every component from the CSS loaded below on the authentic dark
          background (<code>/images/bloxfruit-bg.png</code>).
        </p>
      </header>

      <!-- 1. Editorial Alert & Chroma Text -->
      <div class="hatnote" style="margin-bottom: 2rem;">
        <strong class="Traffic-03" style="color: #ffd700;"
          >SYSTEM NOTICE:</strong
        >
        This demo displays all 18+ components extracted from the Blox Fruits Fandom
        wiki stylesheets.
        <span class="legendarychroma" style="margin-left: 8px;"
          >★ RAINBOW CHROMA ACTIVE ★</span
        >
      </div>

      <!-- 2. Main Notice Button -->
      <div style="margin-bottom: 2rem;">
        <a href="#item-cards" class="main-notice-button">
          ⚡ CLICK TO JUMP TO AUTHENTIC WIKI ITEM CARDS ⚡
        </a>
      </div>

      <!-- 3. Arcade Buttons -->
      <section
        style="background: var(--tbl-Secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--tbl-Line); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          1. Official BFW Arcade Buttons
        </h2>
        <div
          style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center;"
        >
          <button type="button" class="bfw-button">Read Novel</button>
          <button type="button" class="bfw-button">Tier List</button>
          <button type="button" class="bfw-button-toggle">Spoiler Toggle</button
          >
          <button type="button" class="button1">Arcade Bevel Button</button>
          <button type="button" class="codes-notifier-subscribe-button"
            >★ Codes Subscribe</button
          >
        </div>
      </section>

      <!-- 4. Authentic Item Cards (with downloaded wiki card frames) -->
      <section
        id="item-cards"
        style="background: var(--tbl-Primary); padding: 1.5rem; border-radius: 8px; border: 2px solid var(--main-bd-c); box-shadow: var(--main-bxsh); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 0.5rem;"
        >
          2. Authentic Wiki Item Cards (Using Real Card Backgrounds)
        </h2>
        <p style="color: #cbd5e1; font-size: 0.9rem; margin-bottom: 1rem;">
          Rendered using <code>Card_Mythical.png</code>, <code
            >Card_Legendary.png</code
          >, etc., with <code>.card-text</code> and <code>.card-text-sup</code>:
        </p>

        <div
          style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center;"
        >
          <!-- Mythical Card -->
          <div class="card-item(Mythical)">
            <span class="card-text-sup">V3</span>
            <img
              src="/images/bannerbackground.webp"
              alt="Fruit"
              style="width: 72px; height: 72px; object-fit: cover; border-radius: 6px;"
            />
            <div class="card-text">Infinite Mana</div>
            <div class="card-text-default">MYTHICAL</div>
          </div>

          <!-- Legendary Card -->
          <div class="card-item(Legendary)">
            <span class="card-text-sup">Max</span>
            <img
              src="/images/bannerbackground.webp"
              alt="Fruit"
              style="width: 72px; height: 72px; object-fit: cover; border-radius: 6px;"
            />
            <div class="card-text">Dragon Soul</div>
            <div class="card-text-default">LEGENDARY</div>
          </div>

          <!-- Rare Card -->
          <div class="card-item(Rare)">
            <span class="card-text-sup">Lv. 50</span>
            <img
              src="/images/bannerbackground.webp"
              alt="Fruit"
              style="width: 72px; height: 72px; object-fit: cover; border-radius: 6px;"
            />
            <div class="card-text">Dao Insight</div>
            <div class="card-text-default">RARE</div>
          </div>

          <!-- Uncommon Card -->
          <div class="card-item(Uncommon)">
            <img
              src="/images/bannerbackground.webp"
              alt="Fruit"
              style="width: 72px; height: 72px; object-fit: cover; border-radius: 6px;"
            />
            <div class="card-text">Iron Body</div>
            <div class="card-text-default">UNCOMMON</div>
          </div>

          <!-- Common Card -->
          <div class="card-item(Common)">
            <img
              src="/images/bannerbackground.webp"
              alt="Fruit"
              style="width: 72px; height: 72px; object-fit: cover; border-radius: 6px;"
            />
            <div class="card-text">Qi Gathering</div>
            <div class="card-text-default">COMMON</div>
          </div>
        </div>
      </section>

      <!-- 5. Mini-Cards & Inventory Stock Box -->
      <section
        style="background: var(--tbl-Secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--tbl-Line); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          3. Mini Inventory Cards & Stock Box
        </h2>
        <div
          style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;"
        >
          <div>
            <p style="color: #94a3b8; font-size: 0.85rem; margin: 0 0 6px 0;">
              Mini Cards (Cyan hover glow):
            </p>
            <div style="display: flex; gap: 8px;">
              <div class="mini-card">
                <img
                  src="/images/bannerbackground.webp"
                  alt="mini"
                  style="width: 46px; height: 46px; object-fit: cover;"
                />
              </div>
              <div class="mini-card">
                <img
                  src="/images/bannerbackground.webp"
                  alt="mini"
                  style="width: 46px; height: 46px; object-fit: cover;"
                />
              </div>
              <div class="mini-card">
                <img
                  src="/images/bannerbackground.webp"
                  alt="mini"
                  style="width: 46px; height: 46px; object-fit: cover;"
                />
              </div>
            </div>
          </div>

          <div>
            <p style="color: #94a3b8; font-size: 0.85rem; margin: 0 0 6px 0;">
              Stock Box:
            </p>
            <div class="stock-box">
              <span
                class="Traffic-03"
                style="color: #ffd700; font-size: 0.9rem;">IN STOCK:</span
              >
              <span class="C(--Mythical) Traffic-03">Infinite Mana (1)</span>
              <span class="C(--Legendary) Traffic-03">Simulator (3)</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 6. Boss Card Box & Event Shop -->
      <section
        style="background: var(--tbl-Primary); padding: 1.5rem; border-radius: 8px; border: 2px solid var(--main-bd-c); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1.2rem;"
        >
          4. Boss Card Box & Event Shop Item
        </h2>

        <div
          style="display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start;"
        >
          <!-- Boss Box 1 -->
          <div
            class="boss-box1"
            style="width: 150px; text-align: center; padding-bottom: 10px;"
          >
            <div
              style="width: 150px; height: 170px; background: #0c121c; overflow: hidden;"
            >
              <img
                src="/images/bannerbackground.webp"
                alt="Boss"
                style="width: 100%; height: 100%; object-fit: cover;"
              />
            </div>
            <p
              class="Traffic-03"
              style="margin: 8px 0 2px; font-size: 0.95rem; color: #ffd700;"
            >
              Noah Osmont
            </p>
            <span class="C(--Mythical) Traffic-03" style="font-size: 0.8rem;"
              >Apex Paragon</span
            >
          </div>

          <!-- Event Shop Item -->
          <div style="flex: 1; min-width: 280px;">
            <div class="EventShop" style="width: 100%;">
              <table style="width: 100%; border-collapse: collapse;">
                <thead>
                  <tr><th>Event Shop Item Panel</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td style="padding: 10px;">
                      <div class="EventShop_Item">
                        <div class="EventShop_Item_Name">
                          <span style="color: #67e8f9;"
                            >Primordial Dao Core</span
                          >
                        </div>
                        <div class="EventShop_Item_Box">
                          <span
                            style="font-size: 0.85rem; color: #e2e8f0; text-align: center;"
                          >
                            Grants infinite cosmic energy and bypasses realm
                            bottlenecks.
                          </span>
                          <div class="EventShop_Item_Price">
                            5,000,000 FRAGMENTS
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Currency Counters & Gacha Calc Input -->
      <section
        style="background: var(--tbl-Secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--tbl-Line); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          5. Currency Counters & Gacha Number Input
        </h2>
        <div
          style="display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-bottom: 1rem;"
        >
          <span class="color-currency(Robux)">Robux: 2,500 R$</span>
          <span class="color-currency(Money)">Beli: $50,000,000</span>
          <span class="color-currency(Fragment)">Fragments: 150,000 ƒ</span>
          <span class="color-currency(Valor)">Valor: 9,999 V</span>
        </div>

        <div
          style="display: flex; gap: 12px; align-items: center; margin-top: 1rem;"
        >
          <span class="Traffic-03" style="color: #e2e8f0;">Gacha Spins:</span>
          <input type="number" min="1" max="999" value="10" />
          <button
            type="button"
            class="bfw-button"
            style="height: 32px; min-width: 80px !important;">ROLL</button
          >
        </div>
      </section>

      <!-- 8. Rarity Badges & Tooltip Glows -->
      <section
        style="background: var(--tbl-Secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--tbl-Line); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          6. Rarity Badges & Inset Tooltips
        </h2>

        <div
          style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 1.2rem;"
        >
          <span
            class="Bg(--Mythical) Bd(--Mythical) Bxsh(--Mythical) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
            >★ MYTHICAL</span
          >
          <span
            class="Bg(--Legendary) Bd(--Legendary) Bxsh(--Legendary) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
            >◆ LEGENDARY</span
          >
          <span
            class="Bg(--Rare) Bd(--Rare) Bxsh(--Rare) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
            >▲ RARE</span
          >
          <span
            class="Bg(--Uncommon) Bd(--Uncommon) Bxsh(--Uncommon) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
            >● UNCOMMON</span
          >
          <span
            class="Bg(--Common) Bd(--Common) Bxsh(--Common) Traffic-03"
            style="padding: 4px 14px; border-radius: 6px; font-size: 0.85rem;"
            >■ COMMON</span
          >
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          <div class="card-tooltips(Mythical)">Mythical Inset Tooltip</div>
          <div class="card-tooltips(Legendary)">Legendary Inset Tooltip</div>
          <div class="card-tooltips(Rare)">Rare Inset Tooltip</div>
          <div class="card-tooltips(Common)">Common Inset Tooltip</div>
        </div>
      </section>

      <!-- 9. Update Log Animated Box -->
      <section
        style="background: var(--tbl-Secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--tbl-Line); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          7. Animated Pulsing Update Log Box
        </h2>
        <div class="update-log-container">
          <div class="update-log-title">Update 24: Dragon Rework</div>
          <div class="update-log-next">
            <div class="update-log-next-event">NEXT UPDATE EVENT</div>
            <div class="update-log-timer">02 : 14 : 58</div>
          </div>
        </div>
      </section>

      <!-- 10. Upgrading / Crafting Table -->
      <section
        style="background: var(--tbl-Secondary); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--tbl-Line); margin-bottom: 2rem;"
      >
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          8. Upgrading & Crafting Layout
        </h2>
        <div class="upgrading-container">
          <div style="text-align: center;">
            <div class="mini-card" style="width: 64px; height: 64px;">
              <img
                src="/images/bannerbackground.webp"
                alt="base"
                style="width: 56px; height: 56px; object-fit: cover;"
              />
            </div>
            <div class="upgrading-name">Dark Blade</div>
            <span class="upgrading-eff">+25% ATK</span>
          </div>

          <div class="upgrading-arrow">➔</div>

          <div class="material-wrapper">
            <div class="mini-card" title="Material 1">
              <img
                src="/images/bannerbackground.webp"
                alt="mat"
                style="width: 46px; height: 46px; object-fit: cover;"
              />
            </div>
            <div class="mini-card" title="Material 2">
              <img
                src="/images/bannerbackground.webp"
                alt="mat"
                style="width: 46px; height: 46px; object-fit: cover;"
              />
            </div>
            <div class="mini-card" title="Material 3">
              <img
                src="/images/bannerbackground.webp"
                alt="mat"
                style="width: 46px; height: 46px; object-fit: cover;"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- 11. BFW Table & Roblox Wikis Table -->
      <section style="margin-bottom: 2rem;">
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;"
        >
          9. BFW Structured Table
        </h2>
        <table class="bfw-table">
          <thead>
            <tr><th colspan="2">System Novel Power Ranking Matrix</th></tr>
          </thead>
          <tbody>
            <tr>
              <td style="width: 50%;"
                ><div class="bfw-table-cell">
                  <b>Cultivation Speed:</b> 100x Cheat Speed
                </div></td
              >
              <td style="width: 50%;"
                ><div class="bfw-table-cell">
                  <b>Domain Size:</b> Universal Multiverse
                </div></td
              >
            </tr>
            <tr>
              <td
                ><div class="bfw-table-cell">
                  <b>MC Temperament:</b> Cautious / Decisive
                </div></td
              >
              <td
                ><div class="bfw-table-cell">
                  <b>Overall Tier:</b>
                  <span class="C(--Mythical) Traffic-03">SSS+ Masterpiece</span>
                </div></td
              >
            </tr>
          </tbody>
        </table>

        <!-- Roblox Wikis Navbox -->
        <h2
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.3rem; margin-top: 2rem; margin-bottom: 0.5rem;"
        >
          10. Roblox Wikis Checkered Navbox
        </h2>
        <div class="RobloxWikis">
          <div class="RobloxWikis-Head">
            <a class="RobloxWikis-HeadButton">Fruits</a>
            <a class="RobloxWikis-HeadButton">Swords</a>
            <a class="RobloxWikis-HeadButton">Guns</a>
            <a class="RobloxWikis-HeadButton">Accessories</a>
          </div>
          <table class="RobloxWikis-TableAll">
            <tbody>
              <tr class="RobloxWikis-OddRow">
                <td><b>Combat Style:</b> Godhuman</td>
                <td><b>Weapon:</b> Cursed Dual Katana</td>
              </tr>
              <tr class="RobloxWikis-EvenRow">
                <td><b>Race:</b> Cyborg V4</td>
                <td><b>Accessory:</b> Leviathan Shield</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Back link -->
      <div style="text-align: center; margin-top: 2.5rem;">
        <a
          href="/"
          class="Traffic-03"
          style="color: #ffd700; font-size: 1.1rem; text-decoration: none;"
        >
          ← Back to LazyNoman Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
