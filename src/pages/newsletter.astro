---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="LazyNoman Newsletter"
  description="Get LazyNoman updates and new review announcements"
  canonical="/newsletter/"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow text-style-eyebrow">Stay current</p>
      <h1 class="heading text-style-h1">Be the first to know</h1>
      <p class="text text-style-large">
        Get updates, new review drops, and curated webnovel tier lists directly
        to your inbox.
      </p>
      <form
        class="display-flex flex-direction-column gap-3 width-100 padding-all-large background-2 radius-main"
        data-newsletter-form
      >
        <label for="newsletter-name" class="text-style-small">Name</label>
        <input
          type="text"
          name="name"
          id="newsletter-name"
          autocomplete="name"
          placeholder="Your name"
          class="input_field"
        />
        <label for="newsletter-email" class="text-style-small">Email</label>
        <input
          type="email"
          name="email"
          id="newsletter-email"
          autocomplete="email"
          placeholder="your@email.com"
          required
          class="input_field"
        />
        <div>
          <Button type="submit" name="submit">Sign me up</Button>
        </div>
        <p
          class="padding-all-medium border-width-main border-color-brand radius-small"
          data-newsletter-notice
          hidden
        >
          Newsletter subscription is coming soon!
        </p>
        <p class="text-style-tiny color-muted">
          You are signing up to receive updates from LazyNoman.
        </p>
      </form>
    </div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>(
      "[data-newsletter-form]",
    );
    const notice = document.querySelector<HTMLElement>(
      "[data-newsletter-notice]",
    );
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (notice) notice.hidden = false;
    });
  </script>
</BaseLayout>
