---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="LazyNoman Newsletter" description="Get LazyNoman updates and new review announcements" canonical="/newsletter/">
  <section class="reading newsletter-page">
    <header class="article-header">
      <p class="eyebrow">Stay current</p>
      <h1>Be the first to know</h1>
      <p class="lede">Get updates, new review drops, and curated webnovel tier lists directly to your inbox.</p>
    </header>
    <form class="newsletter-form card" data-newsletter-form>
      <div class="card-body">
        <label for="newsletter-name">Name</label>
        <input type="text" name="name" id="newsletter-name" autocomplete="name" placeholder="Your name" />
        <label for="newsletter-email">Email</label>
        <input type="email" name="email" id="newsletter-email" autocomplete="email" placeholder="your@email.com" required />
        <button class="primary-button" type="submit" name="submit">Sign me up</button>
        <p class="muted">You are signing up to receive updates from LazyNoman.</p>
      </div>
    </form>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      alert("Newsletter subscription is coming soon!");
    });
  </script>
</BaseLayout>
