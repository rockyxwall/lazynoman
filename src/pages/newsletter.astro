---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="LazyNoman Newsletter"
  description="Get LazyNoman updates and new review announcements"
  canonical="/newsletter/"
>
  <Section>
    <ContentWrapper>
      <Eyebrow>Stay current</Eyebrow>
      <Heading tag="h1">Be the first to know</Heading>
      <Paragraph variant="large">
        Get updates, new review drops, and curated webnovel tier lists directly
        to your inbox.
      </Paragraph>
      <form
        class="display-flex flex-direction-column gap-3 width-100 padding-all-large background-2 radius-main"
        data-newsletter-form
      >
        <label for="newsletter-name" class="text-style-small">Name</label>
        <input
          type="text"
          name="name"
          id="newsletter-name"
          autocomplete="name"
          placeholder="Your name"
          class="input_field"
        />
        <label for="newsletter-email" class="text-style-small">Email</label>
        <input
          type="email"
          name="email"
          id="newsletter-email"
          autocomplete="email"
          placeholder="your@email.com"
          required
          class="input_field"
        />
        <div>
          <Button type="submit" name="submit">Sign me up</Button>
        </div>
        <p
          class="padding-all-medium border-width-main border-color-brand radius-small"
          data-newsletter-notice
          hidden
        >
          Newsletter subscription is coming soon!
        </p>
        <p class="text-style-tiny color-muted">
          You are signing up to receive updates from LazyNoman.
        </p>
      </form>
    </ContentWrapper>
  </Section>
  <script>
    const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
    const notice = document.querySelector<HTMLElement>("[data-newsletter-notice]");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (notice) notice.hidden = false;
    });
  </script>
</BaseLayout>
