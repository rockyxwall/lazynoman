---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { loadNovels } from '../lib/parseNovels';
import { computeStats } from '../lib/stats';
import { Badge } from '../components/ui/badge';

const novels = await loadNovels();
const stats = computeStats(novels);

const posts = (await getCollection('post'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WC6RL4N6"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		
		<main>
			{/* Stats Dashboard Hero */}
			<section class="py-12 md:py-20 mb-12 border-b border-border">
				<div class="max-w-4xl mx-auto space-y-12">
					<div class="text-center space-y-4">
						<h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter">
							Lazy<span class="text-primary">Noman</span>
						</h1>
						<p class="text-xl text-muted-foreground font-medium">Reading Stats & Reviews</p>
					</div>

					<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black text-primary mb-1">{stats.totalChapters.toLocaleString()}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Chapters Read</p>
						</div>
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black mb-1">{stats.finishedCount}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Finished</p>
						</div>
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black mb-1 text-red-500">{stats.droppedCount}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Dropped</p>
						</div>
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black mb-1 text-yellow-500">{stats.avgRating}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Avg Rating</p>
						</div>
					</div>

					<div class="space-y-6">
						<div class="flex items-center justify-between">
							<h3 class="text-sm uppercase tracking-[0.2em] font-black text-muted-foreground/60 italic">Achievements</h3>
							<div class="h-px flex-grow mx-4 bg-border/50"></div>
						</div>
						<div class="flex flex-wrap justify-center gap-3">
							{stats.achievements.map(ach => (
								<div class={`group relative flex items-center gap-2 px-4 py-2 rounded-full border transition-all ${ach.unlocked ? 'bg-primary/10 border-primary/30 text-primary' : 'bg-muted/30 border-border text-muted-foreground grayscale opacity-50'}`}>
									<span class="text-lg">{ach.icon}</span>
									<span class="text-sm font-bold">{ach.label}</span>
									
									<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1 bg-popover text-popover-foreground text-xs rounded shadow-xl border border-border opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10">
										{ach.description}
									</div>
								</div>
							))}
						</div>
					</div>

					<div class="flex flex-wrap justify-center gap-4 pt-4">
						<a href="/novel" class="px-10 py-4 bg-primary text-primary-foreground font-black rounded-xl shadow-xl shadow-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all no-underline">
							Browse Novel Tracker
						</a>
						<a href="/manga" class="px-10 py-4 bg-secondary text-secondary-foreground font-black rounded-xl border border-border hover:bg-muted transition-all no-underline">
							Explore Manga
						</a>
					</div>
				</div>
			</section>

			{/* About rockyxwall Section */}
			<section class="max-w-4xl mx-auto space-y-12">
				<div class="flex flex-col md:flex-row gap-8 items-start">
					<div class="w-full md:w-1/3 flex-shrink-0">
						<div class="aspect-square bg-primary/10 rounded-3xl flex items-center justify-center text-7xl border border-primary/20 shadow-inner">
							R
						</div>
						<div class="mt-6 space-y-4">
							<div>
								<p class="text-xs uppercase tracking-widest font-black text-muted-foreground/60 mb-1 italic">Identity</p>
								<p class="text-xl font-bold">rockyxwall</p>
							</div>
							<div>
								<p class="text-xs uppercase tracking-widest font-black text-muted-foreground/60 mb-1 italic">Role</p>
								<p class="text-sm font-medium">Founder & Lead Reviewer</p>
							</div>
							<div class="flex flex-wrap gap-2 pt-2">
								<Badge variant="secondary" class="font-bold">Fantasy</Badge>
								<Badge variant="secondary" class="font-bold">Isekai</Badge>
								<Badge variant="secondary" class="font-bold">Cultivation</Badge>
							</div>
						</div>
					</div>
					
					<div class="flex-grow space-y-6">
						<h2 class="text-3xl font-black tracking-tight">who even is rockyxwall?</h2>
						<div class="prose prose-lg dark:prose-invert text-muted-foreground leading-relaxed">
							<p>
								okay so. at some point i hit a wall. i had read so many webnovels, so many manga chapters, watched so much anime
								that i genuinely ran out of stuff that matched my taste. not like "i can't find anything right now" — i mean i
								actually exhausted the genres i liked.
							</p>
							<p>
								i'm not a 30-minutes-today, 30-minutes-tomorrow type of person. when i'm into something i sit down and i go.
								full day. if a manga has finished its story in novel form, i'm reading the novel. i don't rewatch. i don't reread. 
								i just keep moving forward until there's nothing left.
							</p>
							<p>
								so when you've consumed that much, two things happen. one — you develop opinions. strong ones. you know what
								actually works in a story and what's just filler dressed up in pretty art. two — you start wanting to tell
								other people what's worth their time so they don't have to waste it on the stuff that isn't.
							</p>
							<p>
								that's what this site is. i'm not a critic, i'm not a journalist, i'm just someone who's been deep in this
								world long enough to have a real read on it. i won't sugarcoat. if something is mid i'll say it's mid. if
								something actually wrecked me in the best way i'll tell you that too.
							</p>
						</div>
					</div>
				</div>
			</section>

			{/* Project Vision */}
			<section class="max-w-4xl mx-auto mt-20 p-8 md:p-12 rounded-3xl bg-muted/30 border border-border text-center space-y-6">
				<h2 class="text-2xl font-black italic uppercase tracking-widest text-muted-foreground/60">The Mission</h2>
				<p class="text-xl md:text-2xl font-bold leading-relaxed max-w-2xl mx-auto">
					I started this site because I wanted a place to share how I truly feel about the things I consume, <span class="text-primary underline decoration-2 underline-offset-8">without filter or compromise.</span>
				</p>
				<p class="text-muted-foreground max-w-xl mx-auto">
					If you're also someone who ran out of good things to read and you're desperately hunting for the next story that won't disappoint you — you're in the right place.
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>
