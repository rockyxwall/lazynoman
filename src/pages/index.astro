---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Hello, LazyNoman!</h1>
			<p>
				Welcome to the LazyNoman blog. This is a space for sharing thoughts, projects, and ideas.
			</p>
			<p>
				The site is built with efficiency and simplicity in mind, providing a clean interface for reading and exploration.
			</p>
			<p>Feel free to explore the content:</p>
			<ul>
				<li>Read our latest blog posts in the <strong>Blog</strong> section.</li>
				<li>Learn more about the project in the <strong>About</strong> page.</li>
			</ul>
			<p>
				Stay tuned for more updates and content!
			</p>
		</main>
		<Footer />
	</body>
</html>
