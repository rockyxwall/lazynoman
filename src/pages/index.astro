---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getAllNovels, getStats } from '../lib/parseNovels';
import NovelCard from '../components/NovelCard';

const novels = await getAllNovels();
const stats = await getStats();
const currentlyReading = novels.filter(n => n.status === 'Reading');

const allPosts = await getCollection('post');
const reviewedSlugs = allPosts
	.filter(p => p.data.category === 'novel')
	.map(p => p.id);

const latestPosts = allPosts
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 4);

const hasReview = (novelSlug: string) => {
  return reviewedSlugs.some(id => {
    const postId = id.toLowerCase();
    const slug = novelSlug.toLowerCase();
    return postId.includes(slug) || slug.includes(postId.split('/').pop() || '');
  });
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="max-w-6xl mx-auto px-4 py-12 md:py-24">
			{/* Dashboard Header */}
			<section class="mb-24 space-y-12">
				<div class="space-y-4">
					<h1 class="text-5xl md:text-7xl font-black tracking-tighter italic uppercase leading-none">
						Lazy<span class="text-muted-foreground/20">Noman</span>
					</h1>
					<p class="text-xl md:text-2xl text-muted-foreground font-medium max-w-2xl">
						A personal archive of every novel, show, and game I've finished.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
					{[
						{ label: 'Novels', stats: stats.novel, color: 'text-primary' },
						{ label: 'Anime', stats: stats.anime, color: 'text-blue-500' },
						{ label: 'Manga', stats: stats.manga, color: 'text-purple-500' },
						{ label: 'Movies', stats: stats.movie, color: 'text-red-500' },
						{ label: 'Games', stats: stats.game, color: 'text-green-500' }
					].map(cat => (
						<div class="bg-card border border-border p-6 rounded-lg group relative transition-all duration-300 hover:border-primary/50">
							{/* --- EXTERNAL CORNER GLOW ACCENTS (CONCENTRIC BENDS) --- */}
							<div class="absolute -top-1 -left-1 w-5 h-5 border-t-2 border-l-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-tl-[12px]"></div>
							<div class="absolute -top-1 -right-1 w-5 h-5 border-t-2 border-r-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-tr-[12px]"></div>
							<div class="absolute -bottom-1 -left-1 w-5 h-5 border-b-2 border-l-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-bl-[12px]"></div>
							<div class="absolute -bottom-1 -right-1 w-5 h-5 border-b-2 border-r-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-br-[12px]"></div>

							<p class="text-[13px] uppercase tracking-[0.2em] font-black text-muted-foreground mb-3 font-mono">{cat.label}</p>
							<div class="space-y-1">
								<p class={`text-3xl font-black italic tracking-tighter ${cat.color}`}>
									{cat.stats.total_finished || 0} <span class="text-muted-foreground/30 text-xl">/ {cat.stats.total_read}</span>
								</p>
								<p class="text-[12px] uppercase tracking-widest font-bold text-muted-foreground/50 font-mono">
									Completed
								</p>
							</div>
							<div class="mt-4 pt-4 border-t border-border/50 flex justify-between items-end">
								<div class="min-w-0">
									<p class="text-lg font-black italic truncate">{cat.stats.total_chapters.toLocaleString()}</p>
									<p class="text-[10px] uppercase tracking-widest text-muted-foreground/40 font-mono leading-none">
										{cat.label === 'Novels' ? 'Chapters' : 'Units'}
									</p>
								</div>
								<div class="text-right">
									<p class="text-lg font-black italic">{(cat.stats.avg_rating || 0).toFixed(1)}</p>
									<p class="text-[10px] uppercase tracking-widest text-muted-foreground/40 font-mono leading-none">Rating</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			{/* 
			<section class="space-y-8">
				<div class="flex items-center gap-4">
					<h2 class="text-2xl font-black italic uppercase tracking-widest">Milestones</h2>
					<div class="h-px grow bg-border/50"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					{stats.achievements.map(ach => (
						<div class={`group relative flex items-center gap-4 p-4 rounded-xl border transition-all ${ach.unlocked ? 'bg-primary text-primary-foreground border-primary' : 'bg-muted/30 border-border text-muted-foreground grayscale opacity-50'}`}>
							<span class="text-2xl">{ach.icon}</span>
							<div class="min-w-0">
								<p class="text-xs font-black uppercase tracking-widest leading-none mb-1">{ach.label}</p>
								<p class={`text-[10px] truncate ${ach.unlocked ? 'text-primary-foreground/70' : 'text-muted-foreground/60'}`}>
									{ach.unlocked ? ach.description : ach.hint}
								</p>
							</div>
						</div>
					))}
				</div>
			</section>
			*/}
		</main>

		<Footer />

		<style is:global>
			.novel-card {
				--hd: 'Atkinson', sans-serif;
				--mn: 'Geist Mono', monospace;
				--sn: 'Inter', sans-serif;
			}
		</style>
	</body>
</html>
