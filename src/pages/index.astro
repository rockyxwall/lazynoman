---
import { getCollection } from 'astro:content';
import BaseHead from '../components/layout/BaseHead.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getStats } from '../lib/parseNovels';
import { getCategoryMetadata } from '../lib/categories';
import PostCard from '../components/blog/PostCard.astro';
import { Button } from '@/components/ui/button';
import { ArrowRight } from 'lucide-react';
import anilistData from '../data/anilist.json';

const db = Astro.locals.db;
const dbStats = await getStats(db);
const categories = getCategoryMetadata();

const allPosts = await getCollection('post');
const latestPosts = allPosts
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 4);

const categoryColors: Record<string, string> = {
  novel: 'text-primary',
  anime: 'text-blue-500',
  manga: 'text-purple-500',
  movie: 'text-red-500',
  game: 'text-green-500'
};

const categoryUnits: Record<string, string> = {
  novel: 'Chapters',
  manga: 'Chapters',
  anime: 'Episodes',
  movie: 'Movies',
  game: 'Games'
};

// Map stats for each category, merging DB and AniList data
const categoryStats = categories.map(cat => {
  let completed = 0;
  let total = 0;
  let units = 0;
  let avgRating = 0;

  const catId = cat.id.toLowerCase();
  const catPosts = allPosts.filter(p => p.data.category?.toLowerCase() === catId);

  if (catId === 'anime') {
    completed = anilistData.anime.statuses.find(s => s.status === 'COMPLETED')?.count || 0;
    total = anilistData.anime.count;
    units = anilistData.anime.episodesWatched;
    avgRating = anilistData.anime.meanScore / 10;
  } else if (catId === 'manga') {
    completed = anilistData.manga.statuses.find(s => s.status === 'COMPLETED')?.count || 0;
    total = anilistData.manga.count;
    units = anilistData.manga.chaptersRead;
    avgRating = anilistData.manga.meanScore / 10;
  } else if (catId === 'movie') {
    const movieCount = anilistData.anime.formats.find(f => f.format === 'MOVIE')?.count || 0;
    completed = movieCount;
    total = movieCount;
    units = movieCount;
    avgRating = anilistData.anime.meanScore / 10;
  } else {
    const dbCatStats = (dbStats as any)[catId];
    if (dbCatStats) {
      completed = dbCatStats.total_finished;
      total = dbCatStats.total_read;
      units = dbCatStats.total_chapters;
      avgRating = dbCatStats.avg_rating;
    }
  }

  return {
    ...cat,
    completed,
    total,
    units,
    avgRating,
    reviewCount: catPosts.length
  };
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-background text-foreground selection:bg-primary/20">
		<Header />
		
		<main class="max-w-6xl mx-auto px-4 space-y-24 py-16 md:py-32">
			
			{/* HERO SECTION */}
			<section class="flex flex-col items-center text-center space-y-8">
				<div class="space-y-4 max-w-3xl">
					<h1 class="text-6xl sm:text-7xl md:text-9xl font-black tracking-tighter italic uppercase leading-[0.85] animate-in fade-in slide-in-from-bottom-4 duration-700">
						Lazy<span class="text-muted-foreground/20">Noman</span>
					</h1>
					<div class="space-y-2 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-150">
						<p class="text-lg sm:text-xl md:text-2xl font-bold tracking-tight uppercase">
							<span class="text-primary">No</span>vel <span class="text-primary">M</span>anga <span class="text-primary">An</span>ime
						</p>
						<p class="text-muted-foreground font-medium text-sm sm:text-base md:text-lg">
							My personal display site for how much time I have wasted in life.
                            <br />
                            A collection of personal stats and honest reviews.
						</p>
					</div>
				</div>
				<div class="animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300">
					<Button asChild size="lg" className="rounded-full font-bold uppercase tracking-widest text-[10px] h-11 px-8 group">
						<a href="/about" class="flex items-center gap-2">
							Read More About Me
							<ArrowRight className="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
						</a>
					</Button>
				</div>
			</section>

			{/* GLOBAL STATS SECTION */}
			<section class="space-y-12">
				<div class="flex items-center gap-4">
					<h2 class="text-xs font-black uppercase tracking-[0.3em] text-muted-foreground whitespace-nowrap">Global Statistics</h2>
					<div class="h-px w-full bg-border/50"></div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
					{categoryStats.map(cat => (
						<div class="bg-card border border-border p-6 rounded-lg group relative transition-all duration-300 hover:border-primary/50">
							{/* --- EXTERNAL CORNER GLOW ACCENTS (CONCENTRIC BENDS) --- */}
							<div class="absolute -top-1 -left-1 w-5 h-5 border-t-2 border-l-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-tl-[12px]"></div>
							<div class="absolute -top-1 -right-1 w-5 h-5 border-t-2 border-r-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-tr-[12px]"></div>
							<div class="absolute -bottom-1 -left-1 w-5 h-5 border-b-2 border-l-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-bl-[12px]"></div>
							<div class="absolute -bottom-1 -right-1 w-5 h-5 border-b-2 border-r-2 border-primary opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-0 blur-[1px] rounded-br-[12px]"></div>

							<p class="text-[13px] uppercase tracking-[0.2em] font-black text-muted-foreground mb-3 font-mono">{cat.name}</p>
							<div class="space-y-1">
								<p class:list={["text-3xl font-black italic tracking-tighter", categoryColors[cat.id] || "text-primary"]}>
									{cat.completed} <span class="text-muted-foreground/30 text-xl">/ {cat.total}</span>
								</p>
								<p class="text-[12px] uppercase tracking-widest font-bold text-muted-foreground/50 font-mono">
									Completed
								</p>
							</div>
							<div class="mt-4 pt-4 border-t border-border/50 flex justify-between items-end">
								<div class="min-w-0">
									<p class="text-lg font-black italic truncate">{cat.units.toLocaleString()}</p>
									<p class="text-[10px] uppercase tracking-widest text-muted-foreground/40 font-mono leading-none">
										{categoryUnits[cat.id] || 'Units'}
									</p>
								</div>
								<div class="text-right">
									<p class="text-lg font-black italic">{cat.avgRating.toFixed(1)}</p>
									<p class="text-[10px] uppercase tracking-widest text-muted-foreground/40 font-mono leading-none">Rating</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			{/* LATEST REVIEWS SECTION */}
			<section class="space-y-12">
				<div class="flex items-center gap-4">
					<h2 class="text-xs font-black uppercase tracking-[0.3em] text-muted-foreground whitespace-nowrap">Latest Written Reviews</h2>
					<div class="h-px w-full bg-border/50"></div>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
					{latestPosts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			</section>

		</main>

		<Footer />

		<style is:global>
			.novel-card {
				--hd: 'Atkinson', sans-serif;
				--mn: 'Geist Mono', monospace;
				--sn: 'Inter', sans-serif;
			}
		</style>
	</body>
</html>
