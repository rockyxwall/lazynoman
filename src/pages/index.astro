---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getAllNovels } from '../lib/fetchNovels';
import { computeStats } from '../lib/stats';
import { Badge } from '../components/ui/badge';

const novels = await getAllNovels();
const stats = computeStats(novels);
const currentlyReading = novels.filter(n => n.status === 'Reading');

const posts = (await getCollection('post'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main>
			{/* Stats Dashboard Hero */}
			<section class="py-12 md:py-20 mb-12 border-b border-border">
				<div class="max-w-4xl mx-auto space-y-12">
					<div class="text-center space-y-4">
						<h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter">
							Lazy<span class="text-primary">Noman</span>
						</h1>
						<p class="text-xl text-muted-foreground font-medium">Reading Stats & Reviews</p>
					</div>

					<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black text-primary mb-1">{stats.totalChapters.toLocaleString()}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Chapters Read</p>
						</div>
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black mb-1">{stats.totalFinished}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Finished</p>
						</div>
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black mb-1 text-red-500">{stats.totalDropped}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Dropped</p>
						</div>
						<div class="bg-card border border-border p-6 rounded-2xl text-center shadow-sm">
							<p class="text-3xl md:text-4xl font-black mb-1 text-yellow-500">{stats.avgRating.toFixed(1)}</p>
							<p class="text-xs uppercase tracking-widest font-bold text-muted-foreground">Avg Rating</p>
						</div>
					</div>

					<div class="space-y-6">
						<div class="flex items-center justify-between">
							<h3 class="text-sm uppercase tracking-[0.2em] font-black text-muted-foreground/60 italic">Achievements</h3>
							<div class="h-px flex-grow mx-4 bg-border/50"></div>
						</div>
						<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
							{stats.achievements.map(ach => (
								<div class={`group relative flex flex-col items-center gap-2 px-3 py-4 rounded-2xl border transition-all ${ach.unlocked ? 'bg-primary/5 border-primary/20 text-primary' : 'bg-muted/30 border-border text-muted-foreground grayscale opacity-50'}`}>
									<span class="text-3xl">{ach.icon}</span>
									<span class="text-xs font-bold text-center">{ach.label}</span>
									
									<div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 bg-popover text-popover-foreground text-xs rounded-xl shadow-xl border border-border opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none w-48 z-10 text-center">
										<p class="font-bold mb-1">{ach.label}</p>
										<p class="text-muted-foreground">{ach.unlocked ? ach.description : ach.hint}</p>
									</div>
								</div>
							))}
						</div>
					</div>

                    {currentlyReading.length > 0 && (
                        <div class="space-y-6 pt-8">
                            <div class="flex items-center justify-between">
                                <h3 class="text-sm uppercase tracking-[0.2em] font-black text-muted-foreground/60 italic">Currently Reading</h3>
                                <div class="h-px flex-grow mx-4 bg-border/50"></div>
                                <a href="/novel" class="text-xs font-bold text-primary hover:underline">View All &rarr;</a>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                {currentlyReading.slice(0, 4).map(novel => (
                                    <a href={`/novel/${novel.slug}`} class="flex items-center gap-4 p-4 rounded-2xl bg-card border border-border hover:border-primary/50 transition-all no-underline group">
                                        <div class="w-16 h-20 bg-muted rounded-lg overflow-hidden flex-shrink-0 border border-border">
                                            <img 
                                                src={novel.coverUrl || '/img/placeholder.webp'} 
                                                alt={novel.name} 
                                                class="w-full h-full object-cover"
                                            />
                                        </div>
                                        <div class="flex-grow min-w-0">
                                            <h4 class="font-bold truncate group-hover:text-primary transition-colors">{novel.name}</h4>
                                            <p class="text-xs text-muted-foreground mt-1">
                                                Chapter {novel.readChapters} 
                                                {novel.totalChapters > 0 && ` / ${novel.totalChapters}`}
                                            </p>
                                            <div class="flex gap-1 mt-2">
                                                {novel.genres.slice(0, 2).map(g => (
                                                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-muted border border-border font-medium">#{g}</span>
                                                ))}
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}
				</div>
			</section>

            {/* Posts section... */}
		</main>

		<Footer />
	</body>
</html>
