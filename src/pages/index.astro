---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import PostList from "../components/PostList.astro";
import { getAllPosts, getPublishedPosts, homepagePosts, taxonomy } from "../lib/content";

const allPosts = await getAllPosts();
const posts = await getPublishedPosts();
const featured = homepagePosts(allPosts);
const featuredImage = featured[0]?.data.image ? `/${featured[0].data.image.replace(/^\//, "")}` : undefined;
const topics = [...taxonomy(posts, "categories").entries()]
  .map(([slug, group]) => ({ slug, name: group.name, count: group.posts.length }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name))
  .slice(0, 8);
---
<BaseLayout preloadImage={featuredImage} feed="/index.xml">
  <section class="hero container">
    <p class="eyebrow">Webnovel Reviews & Recommendations</p>
    <h1>Unfiltered webnovel reviews and recommendations.</h1>
    <p class="lede">Honest reviews of cultivation, progression fantasy, system novels, and webnovels — zero fluff.</p>
  </section>
  <section class="container">
    <h2>Featured Reviews</h2>
    <div class="grid post-grid">{featured.map((post, index) => <PostCard post={post} heading="h3" priority={index === 0} />)}</div>
  </section>
  <section class="container hero">
    <h2>Explore Genres</h2>
    <div class="chips">{topics.map((topic) => <a class="chip" href={`/categories/${topic.slug}/`}>{topic.name} ({topic.count})</a>)}</div>
  </section>
  <section class="container">
    <h2>Latest Reviews</h2>
    <PostList posts={posts.slice(0, 10)} heading="h3" />
    <p><a href="/posts/">Browse all reviews →</a></p>
  </section>
  <section class="container hero" aria-labelledby="hub-heading">
    <p class="eyebrow">Quick Navigation</p>
    <h2 id="hub-heading">Explore the Archive</h2>
    <div class="grid action-grid">
      <article class="card"><div class="card-body"><h3>All Reviews</h3><p>Browse full catalog of reviewed webnovels.</p><a href="/posts/">Browse reviews →</a></div></article>
      <article class="card"><div class="card-body"><h3>Genres</h3><p>Filter by Cultivation, System, Progression Fantasy, and more.</p><a href="/categories/">Browse genres →</a></div></article>
      <article class="card"><div class="card-body"><h3>Tags</h3><p>Browse all specific tropes, character traits, and novel tags.</p><a href="/tags/">Browse tags →</a></div></article>
      <article class="card"><div class="card-body"><h3>RSS Feed</h3><p>Subscribe to latest reviews in your favorite RSS reader.</p><a href="/rss/">Get feed →</a></div></article>
    </div>
  </section>
</BaseLayout>
