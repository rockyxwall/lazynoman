---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Card from "@/components/Item/Card.astro";
import { getAllPosts, getPublishedPosts, homepagePosts, taxonomy } from "../lib/content";

const allPosts = await getAllPosts();
const posts = await getPublishedPosts();
const featured = homepagePosts(allPosts);
const featuredImage = featured[0]?.data.image ? `/${featured[0].data.image.replace(/^\//, "")}` : undefined;
const topics = [...taxonomy(posts, "categories").entries()]
  .map(([slug, group]) => ({ slug, name: group.name, count: group.posts.length }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name))
  .slice(0, 8);
---

<BaseLayout preloadImage={featuredImage} feed="/index.xml">
  <Section>
    <ContentWrapper>
      <Eyebrow>Webnovels, Anime & Gaming</Eyebrow>
      <Heading tag="h1">Honest reviews, recommendations, and guides.</Heading>
      <Paragraph variant="large">Webnovels, light novels, anime, manga, games, tier lists, and top picks — zero fluff.</Paragraph>
    </ContentWrapper>
  </Section>

  <Section>
    <ContentWrapper>
      <Heading tag="h2">Featured Posts</Heading>
      <Grid small={1} medium={2} large={3}>
        {featured.map((post, index) => <PostCard post={post} heading="h3" priority={index === 0} />)}
      </Grid>
    </ContentWrapper>
  </Section>

  <Section>
    <ContentWrapper>
      <Heading tag="h2">Explore Topics</Heading>
      <ButtonWrapper>
        {topics.map((topic) => (
          <Button element="link" href={`/categories/${topic.slug}/`} emphasis="secondary">
            {topic.name} ({topic.count})
          </Button>
        ))}
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <Section>
    <ContentWrapper>
      <Heading tag="h2">Latest Posts</Heading>
      <Grid small={1} medium={2} large={3}>
        {posts.slice(0, 6).map((post) => <PostCard post={post} heading="h3" />)}
      </Grid>
      <ButtonWrapper>
        <Button element="link" href="/posts/">Browse all posts →</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <Section aria-labelledby="hub-heading">
    <ContentWrapper>
      <Eyebrow>Quick Navigation</Eyebrow>
      <Heading tag="h2" id="hub-heading">Explore the Archive</Heading>
      <Grid small={1} medium={2} large={4}>
        <Card
          heading="All Posts"
          text="Browse full catalog of posts and reviews."
          buttonLabel="Browse posts →"
          buttonHref="/posts/"
        />
        <Card
          heading="Topics"
          text="Filter by Novels, Anime, Manga, Games, Recommendations, and more."
          buttonLabel="Browse topics →"
          buttonHref="/categories/"
        />
        <Card
          heading="Tags"
          text="Browse all specific tropes, character traits, and tags."
          buttonLabel="Browse tags →"
          buttonHref="/tags/"
        />
        <Card
          heading="RSS Feed"
          text="Subscribe to latest updates in your favorite RSS reader."
          buttonLabel="Get feed →"
          buttonHref="/rss/"
        />
      </Grid>
    </ContentWrapper>
  </Section>
</BaseLayout>
