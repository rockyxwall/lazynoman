---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('post'))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WC6RL4N6"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		
		<main>
			{/* Hero Section */}
			<section class="py-12 md:py-20 mb-12 border-b border-border">
				<div class="max-w-4xl mx-auto text-center space-y-6">
					<h1 class="text-4xl md:text-7xl font-bold tracking-tight">
						Welcome to <span class="text-primary">{SITE_TITLE}</span>
					</h1>
					<p class="text-xl md:text-2xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
						In-depth <span class="font-semibold text-foreground underline decoration-primary decoration-2 underline-offset-4">novel reviews</span> — honest takes, no fluff.
					</p>
					<div class="flex flex-wrap justify-center gap-4 pt-4">
						<a href="/novel" class="px-8 py-3 bg-primary text-primary-foreground font-bold rounded-lg shadow-lg hover:opacity-90 transition-all no-underline">Browse Novels</a>
					</div>
				</div>
			</section>

			{/* Recent Updates */}
			<section class="max-w-4xl mx-auto">
				<div class="mb-8">
					<h2 class="text-3xl font-bold">Recent Updates</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			</section>

			{/* About Brief */}
			<section class="max-w-4xl mx-auto mt-20 p-8 rounded-2xl bg-muted/50 border border-border text-center">
				<h2 class="text-2xl font-bold mb-4">About the Project</h2>
				<p class="text-lg text-muted-foreground mb-6 max-w-2xl mx-auto">
					LazyNoman is a space built for clarity and efficiency. Looking for your next novel? We've got honest, in-depth reviews to help you decide.
				</p>
				<a href="/about" class="inline-flex items-center font-bold text-primary hover:underline">
					Learn more about me <span class="ml-1">&rarr;</span>
				</a>
			</section>
		</main>

		<Footer />
	</body>
</html>
