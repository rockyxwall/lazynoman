---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/layout/BaseHead.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getStats, getAllNovels } from '../../lib/parseNovels';
import CategoryStats from '../../components/CategoryStats.astro';
import CategoryView from '../../components/common/CategoryView';

const db = Astro.locals.db;
const statsData = await getStats(db);
const animeStats = statsData.anime;

const animePosts = (await getCollection('post'))
  .filter((p) => p.data.category === 'anime')
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());

const animeItems = await getAllNovels(db, 'anime');

const stats = {
  completed: animeStats.total_finished,
  total: animeStats.total_read,
  units: animeStats.total_chapters,
  unitLabel: "Episodes",
  avgRating: animeStats.avg_rating,
  reviewCount: animePosts.length,
};

const statuses = ['Reading', 'Finished', 'Paused', 'Dropped', 'Plan to Read'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Anime | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-4xl mx-auto px-4 py-10">
			<!-- Page header -->
			<div class="mb-6">
				<h1 class="text-3xl font-bold mb-1 uppercase tracking-tight">Anime</h1>
				<p class="text-neutral-500 dark:text-neutral-400">My watch history, stats, and honest reviews.</p>
			</div>

			<!-- Stats banner -->
			<CategoryStats {...stats} />

			<!-- Category View -->
			<CategoryView 
				client:load 
				category="anime" 
				reviews={animePosts} 
				items={animeItems} 
				statuses={statuses} 
			/>
		</main>
		<Footer />
	</body>
</html>
