---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found"
  canonical="/404.html"
  robots="noindex, nofollow"
>
  <section class="section flex-grow">
    <div class="container alignment-center">
      <p class="eyebrow text-style-eyebrow">404</p>
      <h1 class="heading text-style-h1">That page wandered off.</h1>
      <p class="text text-style-large">
        Try a search, browse the latest posts, or head back home.
      </p>
      <div class="button-wrapper">
        <Button element="link" href="/search/">Search the site</Button>
        <Button element="link" href="/" emphasis="secondary">Return home</Button
        >
      </div>
    </div>
  </section>
</BaseLayout>
