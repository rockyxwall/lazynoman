---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`404 - Page Not Found | ${SITE_TITLE}`}
      description={`The page you're looking for doesn't exist. | ${SITE_DESCRIPTION}`}
    />
  </head>
  <body class="flex flex-col min-h-screen">
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WC6RL4N6"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe></noscript
    >
    <Header />

    <main class="flex-1 flex items-center justify-center">
      <div class="py-20 text-center px-4">
        <h1 class="text-7xl font-heading font-black mb-4">404</h1>
        <p class="text-xl text-muted-foreground">
          Page not found — it may have moved or never existed.
        </p>
        <a
          href="/"
          class="mt-4 inline-block text-muted-foreground font-bold transition-colors hover:text-foreground"
        >
          &larr; Back to Home
        </a>
      </div>
    </main>

    <Footer />
  </body>
</html>
