---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found"
  canonical="/404.html"
  robots="noindex, nofollow"
>
  <Section class="flex-grow">
    <ContentWrapper centered={true}>
      <Eyebrow>404</Eyebrow>
      <Heading tag="h1">That page wandered off.</Heading>
      <Paragraph variant="large">
        Try a search, browse the latest posts, or head back home.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/search/">Search the site</Button>
        <Button element="link" href="/" emphasis="secondary">Return home</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</BaseLayout>
