---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found"
  canonical="/404.html"
  robots="noindex, nofollow"
>
  <section class="section flex-grow">
    <div class="wotaku-hero" style="margin: auto;">
      <div class="wotaku-hero-badge">
        <span class="VPBadge danger">404</span>
        <span>Page Not Found</span>
      </div>
      <h1 class="wotaku-hero-title">That page wandered off.</h1>
      <p class="wotaku-hero-description">
        The page you are looking for does not exist or may have been moved.
      </p>
      <div class="wotaku-hero-actions">
        <Button element="link" href="/search/">Search the site</Button>
        <Button element="link" href="/" emphasis="secondary">Return home</Button
        >
      </div>
    </div>
  </section>
</BaseLayout>
