---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { ModeToggle } from '@/components/ModeToggle';
---

<header class="border-b bg-background shadow-sm px-4">
	<nav class="container mx-auto flex items-center justify-between max-w-4xl">
		<h2 class="text-xl font-bold m-0 leading-none">
			<a href="/" class="no-underline text-foreground hover:text-primary transition-colors">{SITE_TITLE}</a>
		</h2>
		<div class="flex items-center gap-2 sm:gap-4">
			<HeaderLink href="/novel">Novels</HeaderLink>
			<HeaderLink href="/manga">Manga</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<div class="ml-2 py-4">
				<ModeToggle client:load />
			</div>
		</div>
	</nav>
</header>
