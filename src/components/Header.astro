---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { ModeToggle } from '@/components/ModeToggle';
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur-sm shadow-sm">
	<nav class="container mx-auto flex items-center justify-between h-16 max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="flex items-center h-full">
			<h2 class="text-lg sm:text-xl font-bold m-0 leading-none">
				<a href="/" class="no-underline text-foreground hover:text-primary transition-colors">{SITE_TITLE}</a>
			</h2>
		</div>
		<div class="flex items-center gap-1 sm:gap-4 h-full">
			<HeaderLink href="/novel">Novel</HeaderLink>
			<HeaderLink href="/manga">Manga</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<div class="ml-1 sm:ml-2 flex items-center h-full">
				<ModeToggle client:load />
			</div>
		</div>
	</nav>
</header>
