---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { ModeToggle } from '@/components/ModeToggle';
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur-sm shadow-sm">
	<nav class="mx-auto flex items-center justify-between h-16 max-w-6xl px-4">
		{/* Left: Logo */}
		<div class="flex items-center">
			<h2 class="m-0 leading-none">
				<a href="/" class="flex items-center no-underline transition-opacity hover:opacity-80" aria-label={SITE_TITLE}>
					<img src="/favicons/favicon.svg" alt="lazynoman_logo" class="w-8 h-8 sm:w-9 sm:h-9" />
				</a>
			</h2>
		</div>

		{/* Center: Nav Links */}
		<div class="flex items-center gap-1 sm:gap-4 h-full">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/novel">Novel</HeaderLink>
			<HeaderLink href="/under-construction">Manga</HeaderLink>
			<HeaderLink href="/under-construction">Anime</HeaderLink>
			<HeaderLink href="/under-construction">Movie</HeaderLink>
			<HeaderLink href="/under-construction">Game</HeaderLink>
		</div>

		{/* Right: Toggle */}
		<div class="flex items-center">
			<ModeToggle client:load />
		</div>
	</nav>
</header>
