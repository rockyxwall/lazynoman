---
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
import { ModeToggle } from '@/components/common/ModeToggle';
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur-sm">
	<nav class="mx-auto flex items-center justify-between h-16 max-w-6xl px-4 gap-4">
		{/* Left: Logo */}
		<div class="flex items-center shrink-0">
			<h2 class="m-0 leading-none">
				<a href="/" class="flex items-center no-underline transition-opacity hover:opacity-80" aria-label={SITE_TITLE}>
					<img src="/favicons/favicon.svg" alt="lazynoman_logo" class="w-8 h-8 sm:w-9 sm:h-9" />
				</a>
			</h2>
		</div>

		{/* Center: Nav Links (Responsive Normal) */}
		<div class="flex-1 flex justify-center min-w-0">
			<div class="flex items-center gap-1 sm:gap-2 overflow-x-auto no-scrollbar max-w-full py-1">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/novel">Novel</HeaderLink>
				<HeaderLink href="/manga">Manga</HeaderLink>
				<HeaderLink href="/anime">Anime</HeaderLink>
				<HeaderLink href="/movie">Movie</HeaderLink>
				<HeaderLink href="/game">Games</HeaderLink>
			</div>
		</div>

		{/* Right: Toggle */}
		<div class="flex items-center shrink-0">
			<ModeToggle client:only="react" />
		</div>
	</nav>

	<style>
		/* Hide scrollbar for Chrome, Safari and Opera */
		.no-scrollbar::-webkit-scrollbar {
			display: none;
		}
		/* Hide scrollbar for IE, Edge and Firefox */
		.no-scrollbar {
			-ms-overflow-style: none;  /* IE and Edge */
			scrollbar-width: none;  /* Firefox */
		}
	</style>
</header>
