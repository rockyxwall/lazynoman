---
interface Props {
  value?: string;
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class:list={["bg-muted/50 border border-border rounded-xl px-5 py-3 text-base", className]}>
  {value && <strong class="text-foreground">{value}</strong>} {label}
</div>
