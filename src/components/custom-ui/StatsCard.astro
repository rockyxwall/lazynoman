---
interface Props {
  value?: string;
  label: string;
  class?: string;
}

const { value, label, class: className } = Astro.props;
---

<div class:list={["bg-muted/50 border border-border rounded-2xl px-6 py-4 transition-colors hover:bg-muted/80", className]}>
  {value && <span class="block text-2xl font-bold text-foreground">{value}</span>}
  <span class:list={[
    value ? "text-sm text-muted-foreground uppercase tracking-wider font-bold" : "font-bold text-foreground italic uppercase tracking-tight"
  ]}>
    {label}
  </span>
</div>
