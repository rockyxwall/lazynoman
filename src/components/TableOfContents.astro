---
/**
 * TableOfContents Component
 * Port of shadcn/ui DocsTableOfContents (list variant).
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

const show = tocHeadings.length >= 2;
---

{
  show && (
    <div class="toc" aria-label="Table of contents">
      <details class="toc__details">
        <summary class="toc__summary">
          <span>On This Page</span>
          <svg class="toc__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="toc__content">
          {tocHeadings.map((heading) => (
            <a
              class="toc__link"
              href={`#${heading.slug}`}
              data-depth={heading.depth}
            >
              {heading.text}
            </a>
          ))}
        </div>
      </details>
    </div>
  )
}

<script>
  let cleanup: (() => void) | null = null

  function initTableOfContents() {
    cleanup?.()
    cleanup = null

    const container = document.querySelector<HTMLElement>('.toc')
    if (!container) return

    const links = Array.from(
      container.querySelectorAll<HTMLAnchorElement>('.toc__link')
    )
    if (links.length === 0) return

    const itemIds = links
      .map((link) => link.getAttribute('href')?.replace('#', ''))
      .filter((id): id is string => !!id)

    const setActive = (id: string | null) => {
      links.forEach((link) => {
        const isActive = link.getAttribute('href') === (id ? `#${id}` : null)
        link.classList.toggle('is-active', isActive)
        link.toggleAttribute('data-active', isActive)
      })
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id)
          }
        }
      },
      { rootMargin: '0% 0% -80% 0%' }
    )

    for (const id of itemIds) {
      const el = document.getElementById(id)
      if (el) observer.observe(el)
    }

    cleanup = () => observer.disconnect()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTableOfContents)
  } else {
    initTableOfContents()
  }

  document.addEventListener('astro:page-load', initTableOfContents)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>

<style is:global>
  .markdown-body :is(h2, h3, h4) {
    scroll-margin-top: 5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>

<style>
  .toc {
    margin-bottom: 2.5rem;
  }

  .toc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    list-style: none;
    cursor: pointer;
    user-select: none;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--p-muted);
    padding: 0.6rem 0 0.5rem;
    border-bottom: 1px solid var(--p-border);
  }

  .toc__summary::-webkit-details-marker {
    display: none;
  }

  .toc__summary:hover {
    opacity: 0.8;
  }

  .toc__chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--p-muted);
    transition: transform 0.25s ease;
  }

  .toc__details[open] .toc__chevron {
    transform: rotate(180deg);
  }

  .toc__content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toc__link {
    font-size: clamp(1rem, 0.4vw + 0.925rem, 1.125rem);
    line-height: 1.7;
    color: var(--p-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc__link:hover {
    color: var(--p-fg);
  }

  .toc__link[data-active="true"] {
    color: var(--p-fg);
    font-weight: 500;
  }

  .toc__link[data-depth="3"] {
    padding-left: 1rem;
  }

  .toc__link[data-depth="4"] {
    padding-left: 1.5rem;
  }
</style>
