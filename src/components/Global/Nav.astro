---
import NavLink from "@/components/Global/NavLink.astro";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <img src="/images/navlogo.webp" width="32" height="32" alt="" />
          <span class="nav_site_title">{SITE_NAME}</span>
        </a>
        <div class="nav_right">
          <nav class="nav_menu" id="nav-menu" aria-label="Main">
            <div class="nav_menu_inner">
              <ul class="nav_links">
                <NavLink href="/">Home</NavLink>
                <NavLink href="/posts/">Posts</NavLink>
                <NavLink href="/categories/">Topics</NavLink>
                <NavLink href="/tags/">Tags</NavLink>
              </ul>
            </div>
          </nav>
          <a
            href="/search/"
            class="nav_search_btn"
            aria-label="Search reviews and posts"
          >
            <svg
              class="search_icon"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span class="nav_search_text">Search</span>
            <kbd class="nav_search_key">Ctrl K</kbd>
          </a>
          <div class="nav_actions">
            <a
              href="/search/"
              class="nav_action_btn nav_action_search"
              aria-label="Search"
              title="Search"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
              </svg>
            </a>
            <a
              href="/rss/"
              class="nav_action_btn"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" />
              </svg>
            </a>
            <button
              class="theme_toggle"
              type="button"
              data-theme-toggle
              aria-label="Switch color theme"
            >
              <svg
                class="theme_icon theme_icon_sun"
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2" />
                <path d="M12 20v2" />
                <path d="m4.93 4.93 1.41 1.41" />
                <path d="m17.66 17.66 1.41 1.41" />
                <path d="M2 12h2" />
                <path d="M20 12h2" />
                <path d="m6.34 17.66-1.41 1.41" />
                <path d="m19.07 4.93-1.41 1.41" />
              </svg>
              <svg
                class="theme_icon theme_icon_moon"
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
            </button>
            <button
              class="nav_toggle"
              type="button"
              aria-label="Menu"
              aria-expanded="false"
              aria-controls="nav-menu"
            >
              <span class="nav_toggle_icon" />
            </button>
          </div>
        </div>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        const target = event.target;
        if (
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement
        )
          return;
        event.preventDefault();
        window.location.href = "/search/";
      }
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: color-mix(in srgb, var(--background) 82%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      color: var(--text);
      border-bottom: 1px solid var(--divider, var(--border));

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-4);
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: auto;
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.8;
        }
      }
    }

    .nav_logo img {
      width: 1.75rem;
      height: 1.75rem;
      max-width: 1.75rem;
      max-height: 1.75rem;
      object-fit: contain;
      flex-shrink: 0;
      border-radius: var(--radius-small);
    }

    .nav_site_title {
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .nav_right {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .nav_search_btn {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.75rem;
      font-size: 0.8125rem;
      color: var(--text-2);
      background-color: var(--background-2);
      border: 1px solid var(--border-strong, #3d3d3d);
      border-radius: var(--radius-pill);
      text-decoration: none;
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      @media (min-width: 48rem) {
        display: inline-flex;
      }
      @media (hover: hover) {
        &:hover {
          border-color: var(--brand-500);
          color: var(--text);
        }
      }
    }

    :root[data-theme="light"] .nav_search_btn {
      border-color: var(--border);
    }

    .nav_search_key {
      font-family: inherit;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.1em 0.45em;
      border-radius: 4px;
      background-color: var(--background-3);
      color: var(--text-3);
      border: 1px solid var(--border);
    }

    .nav_actions {
      display: flex;
      align-items: center;
      gap: 2px;
      height: 2.25rem;
      padding: 0 4px;
      border-radius: var(--radius-pill);
      background: var(--nav-pill-bg, rgba(23, 23, 23, 0.75));
      border: 1px solid var(--nav-pill-border, rgba(212, 212, 212, 0.12));
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    :root[data-theme="light"] .nav_actions {
      background: rgba(255, 255, 255, 0.85);
      border-color: rgba(64, 64, 64, 0.1);
    }

    .nav_action_btn,
    .theme_toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.875rem;
      height: 1.875rem;
      border: none;
      border-radius: var(--radius-pill);
      background: transparent;
      color: var(--text-2);
      cursor: pointer;
      text-decoration: none;
      transition:
        color var(--hover-duration) var(--hover-ease),
        background-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
          background-color: color-mix(in srgb, var(--text) 10%, transparent);
        }
      }
    }

    .nav_action_search {
      display: inline-flex;
      @media (width >= 48rem) {
        display: none;
      }
    }

    .theme_icon_sun,
    .theme_icon_moon {
      display: block;
    }

    :root[data-theme="dark"] .theme_icon_sun {
      display: block;
    }
    :root[data-theme="dark"] .theme_icon_moon {
      display: none;
    }

    :root[data-theme="light"] .theme_icon_sun {
      display: none;
    }
    :root[data-theme="light"] .theme_icon_moon {
      display: block;
    }

    .nav_toggle {
      --_icon-width: 1.25rem;
      --_bar-gap: 0.375rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.875rem;
      height: 1.875rem;
      color: inherit;
      border-radius: var(--radius-pill);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: 1px solid var(--divider, var(--border));
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text-2);
      text-decoration: none;
      font-weight: 500;
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--brand-400);
        font-weight: 600;
      }
      @media (hover: hover) {
        &:hover {
          color: var(--brand-400);
        }
      }
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-4);
        font-size: var(--text-small);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding-block: 0;
        &[aria-current="page"] {
          text-decoration: none;
          color: var(--brand-400);
        }
      }
    }
  }
</style>
