---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_top">
          <nav aria-label="Footer">
            <ul class="footer_links">
              <li>
                <a class="footer_link" href="/posts/">
                  Posts
                </a>
              </li>
              <li>
                <a class="footer_link" href="/categories/">
                  Topics
                </a>
              </li>
              <li>
                <a class="footer_link" href="/tags/">
                  Tags
                </a>
              </li>
              <li>
                <a class="footer_link" href="/rss/">
                  RSS
                </a>
              </li>
              <li>
                <a class="footer_link" href="/privacy/">
                  Privacy
                </a>
              </li>
              <li>
                <a class="footer_link" href="/terms-conditions/">
                  Terms
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <div class="footer_bottom">
          <p class="footer_copyright text-style-small">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}
          </p>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--space-6, 2rem);
      padding-inline: var(--site-margin);
      background-color: var(--background-alt);
      color: var(--text);
      border-top: 1px solid var(--divider);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      align-items: center;
      text-align: center;
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--space-4);
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_link {
      color: var(--text-2);
      text-decoration-line: underline;
      text-decoration-style: dashed;
      text-underline-offset: 5px;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_bottom {
      padding-top: var(--space-4);
      border-top: 1px solid var(--divider);
    }

    .footer_copyright {
      color: var(--text-3, var(--text-2));
    }
  }
</style>
