---
type ReadStatus = 'completed' | 'on-hold' | 'dropped' | 'reading'

interface Props {
  infoMyReadingStats: {
    startedReading?: string
    stoppedReading?: string
    chaptersRead?: number
    totalChapters?: number
    myRating?: number
    status: ReadStatus
  }
}

const {
  startedReading,
  stoppedReading,
  chaptersRead,
  totalChapters,
  myRating,
  status,
} = Astro.props.infoMyReadingStats

const STATUS_CONFIG: Record<ReadStatus, { label: string; classes: string; dot: string }> = {
  completed: {
    label: 'Completed',
    classes: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-400',
    dot: 'bg-emerald-400',
  },
  'on-hold': {
    label: 'On Hold',
    classes: 'border-amber-500/40 bg-amber-500/10 text-amber-400',
    dot: 'bg-amber-400',
  },
  dropped: {
    label: 'Dropped',
    classes: 'border-rose-500/40 bg-rose-500/10 text-rose-400',
    dot: 'bg-rose-400',
  },
  reading: {
    label: 'Reading',
    classes: 'border-sky-500/40 bg-sky-500/10 text-sky-400',
    dot: 'bg-sky-400',
  },
}

const cfg = STATUS_CONFIG[status]

const stoppedLabel =
  status === 'completed' ? 'Finished'
  : status === 'dropped'  ? 'Dropped'
  : 'Paused'

const stars = myRating
  ? Array.from({ length: 10 }, (_, i) => i < myRating ? '★' : '☆').join('')
  : null

const progress =
  chaptersRead != null && totalChapters != null && totalChapters > 0
    ? Math.round((chaptersRead / totalChapters) * 100)
    : null
---

<div class="mt-3 pt-3 border-t border-border grid gap-2.5">

  <!-- Sub-header -->
  <h4 class="text-xs font-bold uppercase tracking-widest text-amber-400/80">
    My Reading Stats
  </h4>

  <!-- 2-col stat grid -->
  <div class="grid grid-cols-2 gap-x-4 gap-y-2">

    {startedReading && (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Started</p>
        <p class="text-sm text-muted-foreground">{startedReading}</p>
      </div>
    )}

    {stoppedReading && (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{stoppedLabel}</p>
        <p class="text-sm text-muted-foreground">{stoppedReading}</p>
      </div>
    )}

    {chaptersRead != null && (
      <div class={totalChapters != null ? 'col-span-2' : ''}>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Chapters Read</p>
        <div class="flex items-center gap-2 mt-0.5">
          <p class="text-sm text-foreground">
            {chaptersRead}
            {totalChapters != null && (
              <span class="text-muted-foreground"> / {totalChapters}</span>
            )}
          </p>
          {progress != null && (
            <span class="text-xs text-muted-foreground/70">{progress}%</span>
          )}
        </div>
        {progress != null && (
          <div class="mt-1.5 h-1 w-full rounded-full bg-secondary overflow-hidden">
            <div
              class="h-full rounded-full bg-amber-400/70 transition-all"
              style={`width: ${progress}%`}
            />
          </div>
        )}
      </div>
    )}

    <!-- Status badge — full width -->
    <div class="col-span-2 flex items-center gap-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Status</p>
      <span class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold ${cfg.classes}`}>
        <span class={`h-1.5 w-1.5 rounded-full ${cfg.dot}`} />
        {cfg.label}
      </span>
    </div>

  </div>

  <!-- Rating — separate row, stars are wider -->
  {stars && myRating && (
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-0.5">My Rating</p>
      <div class="flex items-baseline gap-2">
        <span class="text-sm tracking-tight text-amber-400">{stars}</span>
        <span class="text-sm font-semibold">{myRating}<span class="text-muted-foreground font-normal">/10</span></span>
      </div>
    </div>
  )}

</div>
