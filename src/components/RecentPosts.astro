---
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('post'))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 5);
---

<div>
  <h3 class="text-sm font-bold uppercase tracking-wider text-muted-foreground mb-4 pb-2 border-b border-border">
    Recent Posts
  </h3>
  <ul class="space-y-3">
    {recentPosts.map((post) => (
      <li>
        <a href={`/${post.id}/`} class="group block no-underline py-1.5">
          <time datetime={post.data.pubDate.toISOString()} class="block text-xs text-muted-foreground">
            {new Date(post.data.pubDate).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </time>
          <span class="block text-sm font-medium leading-snug mt-0.5 transition-colors group-hover:text-primary">
            {post.data.title}
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>
