---
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('post', ({ data }) => import.meta.env.PROD ? data.draft !== true : true))
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 8);
---

<div>
  <h3 class="text-sm font-bold uppercase tracking-wider text-muted-foreground mb-4 pb-2 border-b border-border">
    Recent Posts
  </h3>
  <div class="divide-y divide-border">
    {recentPosts.map((post) => (
      <div class="py-3">
        <a href={`/${post.id}/`} class="group block no-underline">
          <span class="block text-sm font-medium leading-snug transition-colors group-hover:text-primary">{post.data.title}</span>
        </a>
      </div>
    ))}
  </div>
</div>
