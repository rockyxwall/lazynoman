---
import { Star, ExternalLink, BookOpen } from "@lucide/astro";

interface Props {
  rank: number | string;
  tier?: "s" | "a" | "b" | "c";
  title: string;
  url?: string;
  sourceUrl?: string;
  status?: "Ongoing" | "Completed" | "Hiatus";
  score?: string;
  tropes?: string[];
  verdict: string;
  author?: string;
}

const {
  rank,
  tier = "s",
  title,
  url,
  sourceUrl,
  status = "Ongoing",
  score = "9.5",
  tropes = [],
  verdict,
  author,
} = Astro.props;

const tierClass = `tier-${tier.toLowerCase()}`;
const statusClass = status === "Ongoing" ? "status-ongoing" : status === "Completed" ? "status-completed" : "status-hiatus";
---

<article class="novel-rank-card p-4 rounded-xl border border-[var(--border)] bg-[var(--surface)] hover:border-[var(--border-strong)] transition-all shadow-sm">
  <div class="flex items-start justify-between gap-3 mb-2.5">
    <div class="flex items-center gap-2.5 flex-wrap">
      <span class={`tier-badge ${tierClass}`}>
        {typeof rank === "number" ? `#${rank} ${tier.toUpperCase()}-TIER` : tier.toUpperCase()}
      </span>
      <h3 class="text-base font-bold text-[var(--text)] m-0 leading-snug">
        {url ? (
          <a href={url} class="hover:text-[var(--accent)] transition-colors no-underline">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>
    </div>

    <div class="flex items-center gap-1.5 flex-shrink-0 text-xs font-bold text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded-full border border-amber-400/20">
      <Star class="w-3.5 h-3.5 fill-current" />
      <span>{score}</span>
    </div>
  </div>

  <div class="flex items-center gap-3 text-xs text-[var(--muted)] mb-3 flex-wrap">
    {author && (
      <span class="flex items-center gap-1">
        <span>By {author}</span>
      </span>
    )}
    <span class="flex items-center">
      <span class={`status-dot ${statusClass}`} />
      <span>{status}</span>
    </span>
  </div>

  <p class="text-xs text-[var(--text)] leading-relaxed mb-3">
    {verdict}
  </p>

  <div class="flex items-center justify-between gap-2 pt-2.5 border-t border-[var(--border-subtle)] flex-wrap">
    <div class="flex items-center gap-1.5 flex-wrap">
      {tropes.map((t) => (
        <span class="text-[0.72rem] px-2 py-0.5 rounded-full bg-[var(--surface-2)] text-[var(--muted)] border border-[var(--border)]">
          {t}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-2 text-xs">
      {sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[var(--muted)] hover:text-[var(--text)] transition-colors"
          title="Raw or NovelUpdates Source"
        >
          <ExternalLink class="w-3.5 h-3.5" />
          <span>Source</span>
        </a>
      )}
      {url && (
        <a
          href={url}
          class="inline-flex items-center gap-1 font-semibold text-[var(--accent)] hover:text-[var(--accent-strong)] transition-colors"
        >
          <BookOpen class="w-3.5 h-3.5" />
          <span>Full Review</span>
        </a>
      )}
    </div>
  </div>
</article>
