---
interface Props {
  title: string
  infoNovel?: {
    officialTitle?: string
    itemAuthor?: string
    rating?: number
    novelGenres?: string[]
    novelTags?: string[]
    status?: string
    chapterCount?: number
    platform?: string
    novelDescription?: string
    novelType?: string
  }
  placement: 'mobile' | 'desktop'
}

const { title, infoNovel = {}, placement } = Astro.props
const {
  officialTitle,
  itemAuthor,
  rating,
  novelGenres = [],
  novelTags = [],
  status,
  chapterCount,
  platform,
  novelDescription,
  novelType,
} = infoNovel

const novelName = officialTitle || title
const VISIBLE_LIMIT = 5

const genreVisible = novelGenres.slice(0, VISIBLE_LIMIT)
const genreHidden  = novelGenres.slice(VISIBLE_LIMIT)
const tagVisible   = novelTags.slice(0, VISIBLE_LIMIT)
const tagHidden    = novelTags.slice(VISIBLE_LIMIT)

const wrapperClass =
  placement === 'mobile'
    ? 'mb-6 lg:hidden'
    : 'hidden lg:block sticky top-24'

const uid = Math.random().toString(36).slice(2, 7)
---

<div class={wrapperClass}>
  <div class="grid gap-3">

    <!-- Section header -->
    <h3 class="text-xs font-bold uppercase tracking-widest text-muted-foreground pb-2 border-b border-border">
      Quick Info
    </h3>

    <!-- Title -->
    <div class="grid gap-0.5">
      <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Title</span>
      <p class="text-sm font-semibold leading-snug">{novelName}</p>
    </div>

    <!-- Author -->
    {itemAuthor && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Author</span>
        <p class="text-sm text-muted-foreground">{itemAuthor}</p>
      </div>
    )}

    <!-- Type -->
    {novelType && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Type</span>
        <p class="text-sm text-muted-foreground">{novelType}</p>
      </div>
    )}

    <!-- Status -->
    {status && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Status</span>
        <p class="text-sm text-muted-foreground">{status}</p>
      </div>
    )}

    <!-- Chapters -->
    {chapterCount && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Chapters</span>
        <p class="text-sm text-muted-foreground">~{chapterCount}</p>
      </div>
    )}

    <!-- Platform -->
    {platform && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Platform</span>
        <p class="text-sm text-muted-foreground">{platform}</p>
      </div>
    )}

    <!-- Rating -->
    {rating && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Rating</span>
        <p class="text-sm text-muted-foreground">{rating}/10</p>
      </div>
    )}

    <!-- Description -->
    {novelDescription && (
      <div class="grid gap-0.5">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Description</span>
        <p class="text-sm leading-relaxed text-muted-foreground">{novelDescription}</p>
      </div>
    )}

    <!-- Genres -->
    {novelGenres.length > 0 && (
      <div class="grid gap-1.5" data-qi-section>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Genres</span>
          {genreHidden.length > 0 && (
            <button
              type="button"
              data-qi-toggle
              data-count={genreHidden.length}
              class="text-xs text-muted-foreground/60 hover:text-foreground underline underline-offset-2 transition-colors cursor-pointer"
            >
              +{genreHidden.length} more
            </button>
          )}
        </div>
        <div class="flex flex-wrap gap-1.5" data-qi-items>
          {genreVisible.map((g) => (
            <span class="inline-flex items-center rounded-full border border-border bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">
              {g}
            </span>
          ))}
          {genreHidden.map((g) => (
            <span
              class="inline-flex items-center rounded-full border border-border bg-secondary px-2 py-0.5 text-xs text-secondary-foreground qi-hidden"
              data-qi-hidden
            >
              {g}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Tags -->
    {novelTags.length > 0 && (
      <div class="grid gap-1.5" data-qi-section>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Tags</span>
          {tagHidden.length > 0 && (
            <button
              type="button"
              data-qi-toggle
              data-count={tagHidden.length}
              class="text-xs text-muted-foreground/60 hover:text-foreground underline underline-offset-2 transition-colors cursor-pointer"
            >
              +{tagHidden.length} more
            </button>
          )}
        </div>
        <div class="flex flex-wrap gap-1.5" data-qi-items>
          {tagVisible.map((t) => (
            <span class="inline-flex items-center rounded-full border border-border bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">
              {t}
            </span>
          ))}
          {tagHidden.map((t) => (
            <span
              class="inline-flex items-center rounded-full border border-border bg-secondary px-2 py-0.5 text-xs text-secondary-foreground qi-hidden"
              data-qi-hidden
            >
              {t}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Slot: MyReadingStats goes here -->
    <slot />

  </div>
</div>

<style>
  .qi-hidden { display: none; }
</style>

<script>
  document.querySelectorAll('[data-qi-toggle]').forEach((btn) => {
    const section = btn.closest('[data-qi-section]')
    if (!section) return
    const hidden = section.querySelectorAll('[data-qi-hidden]')
    const count = parseInt((btn as HTMLElement).dataset.count ?? '0')
    let expanded = false
    btn.addEventListener('click', () => {
      expanded = !expanded
      hidden.forEach((el) => el.classList.toggle('qi-hidden', !expanded))
      btn.textContent = expanded ? 'show less' : `+${count} more`
    })
  })
</script>
