---
import { SlidersHorizontal, Check, Sparkles, LayoutGrid, X } from "@lucide/astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const palettes = [
  { id: "asuka", name: "Asuka", color: "oklch(0.650 0.240 30)", desc: "Vibrant Crimson" },
  { id: "ayanami", name: "Ayanami", color: "oklch(0.626 0.098 247.46)", desc: "Azure Blue" },
  { id: "miku", name: "Miku", color: "oklch(0.711 0.123 185.28)", desc: "Cyan Teal" },
  { id: "inanis", name: "Ina'nis", color: "oklch(0.663 0.102 301.22)", desc: "Royal Violet" },
  { id: "amelia", name: "Amelia", color: "oklch(0.710 0.090 72.47)", desc: "Warm Amber" },
  { id: "fubuki", name: "Fubuki", color: "oklch(0.78 0 0)", desc: "Clean Monochrome" },
];
---

<div class={`settings-flyout-root relative ${className}`} data-settings-root>
  <button
    type="button"
    class="icon-button settings-trigger inline-flex items-center gap-1.5"
    data-settings-trigger
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Customize interface"
    title="Customize site theme & accents"
  >
    <SlidersHorizontal class="w-4 h-4" />
    <span class="text-xs font-bold sm:hidden">Customization</span>
  </button>

  <!-- Mobile Backdrop Overlay -->
  <div
    class="settings-backdrop fixed inset-0 bg-black/60 z-[90] hidden sm:hidden backdrop-blur-xs transition-opacity"
    data-settings-backdrop
    aria-hidden="true"
  ></div>

  <!-- Flyout Menu (Desktop) / Bottom Sheet (Mobile) -->
  <div
    class="settings-popover hidden fixed sm:absolute inset-x-3 bottom-4 sm:bottom-auto sm:inset-x-auto sm:right-0 sm:top-full sm:mt-2 w-auto sm:w-72 max-h-[85vh] sm:max-h-[calc(100vh-5rem)] overflow-y-auto p-4 sm:p-3 rounded-2xl sm:rounded-xl border border-[var(--border)] bg-[var(--surface-elv)] shadow-2xl z-[100] backdrop-blur-xl overscroll-contain"
    data-settings-menu
    role="dialog"
    aria-modal="true"
    aria-label="Interface Customization"
  >
    <div class="flex items-center justify-between pb-2 mb-3 border-b border-[var(--border)]">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-[var(--text)]">
          Interface Customization
        </span>
        <span class="text-[0.7rem] px-1.5 py-0.5 rounded bg-[var(--surface)] text-[var(--muted)] border border-[var(--border)]">
          Saved
        </span>
      </div>

      <!-- Mobile Close Button -->
      <button
        type="button"
        class="close-button p-1 rounded-lg text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--surface)] sm:hidden transition-colors"
        data-settings-close
        aria-label="Close settings"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Accent Palette Picker -->
    <div class="mb-3">
      <div class="flex items-center gap-1.5 text-xs font-semibold text-[var(--text)] mb-2">
        <Sparkles class="w-3.5 h-3.5 text-[var(--accent)]" />
        <span>Accent Palette</span>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:gap-1.5" role="radiogroup" aria-label="Accent Palette">
        {palettes.map((p) => (
          <button
            type="button"
            class="palette-btn min-h-[44px] sm:min-h-0 flex items-center justify-between p-2 sm:p-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface)] hover:border-[var(--border-strong)] transition-colors text-left text-xs"
            data-accent-choice={p.id}
            role="radio"
            aria-checked="false"
          >
            <div class="flex items-center gap-2 sm:gap-1.5">
              <span class="w-3.5 h-3.5 sm:w-3 sm:h-3 rounded-full flex-shrink-0" style={`background-color: ${p.color};`} />
              <span class="font-medium text-[var(--text)] truncate">{p.name}</span>
            </div>
            <Check class="palette-check w-3.5 h-3.5 sm:w-3 sm:h-3 text-[var(--accent)] opacity-0" />
          </button>
        ))}
      </div>
    </div>

    <!-- Background Tint Toggle -->
    <div class="pt-2 mb-3 border-t border-[var(--border)]">
      <label class="flex items-center justify-between text-xs cursor-pointer text-[var(--text)] min-h-[36px]">
        <span class="font-medium">Accent Tint Background</span>
        <input
          type="checkbox"
          class="accent-bg-checkbox w-4 h-4 rounded border-[var(--border)] bg-[var(--surface)] accent-[var(--accent)] cursor-pointer"
          data-accent-bg-toggle
        />
      </label>
      <p class="text-[0.72rem] text-[var(--muted)] mt-0.5">
        Infuse subtle accent glow into surfaces.
      </p>
    </div>

    <!-- Card Display Density -->
    <div class="pt-2 border-t border-[var(--border)]">
      <div class="flex items-center gap-1.5 text-xs font-semibold text-[var(--text)] mb-2">
        <LayoutGrid class="w-3.5 h-3.5 text-[var(--muted)]" />
        <span>Review Card Layout</span>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:gap-1.5">
        <button
          type="button"
          class="density-btn min-h-[40px] sm:min-h-0 text-xs py-1.5 sm:py-1 px-2 rounded-lg border border-[var(--border)] bg-[var(--surface)] hover:border-[var(--border-strong)] text-[var(--text)] font-medium text-center transition-colors"
          data-density-choice="magazine"
        >
          Magazine
        </button>
        <button
          type="button"
          class="density-btn min-h-[40px] sm:min-h-0 text-xs py-1.5 sm:py-1 px-2 rounded-lg border border-[var(--border)] bg-[var(--surface)] hover:border-[var(--border-strong)] text-[var(--text)] font-medium text-center transition-colors"
          data-density-choice="compact"
        >
          Compact
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initSettingsFlyout() {
    const root = document.querySelector('[data-settings-root]') as HTMLElement | null;
    if (!root) return;

    const trigger = root.querySelector('[data-settings-trigger]') as HTMLButtonElement | null;
    const menu = root.querySelector('[data-settings-menu]') as HTMLElement | null;
    const backdrop = root.querySelector('[data-settings-backdrop]') as HTMLElement | null;
    const closeBtn = root.querySelector('[data-settings-close]') as HTMLButtonElement | null;
    const bgToggle = root.querySelector('[data-accent-bg-toggle]') as HTMLInputElement | null;
    const paletteButtons = root.querySelectorAll('[data-accent-choice]');
    const densityButtons = root.querySelectorAll('[data-density-choice]');

    if (!trigger || !menu || !backdrop) return;

    // Portal modal to document.body on mobile viewports (< 640px)
    // to break out of sticky site-header's backdrop-filter containing block
    function syncPortal() {
      const isMobile = window.innerWidth < 640;
      if (isMobile) {
        if (menu && menu.parentElement !== document.body) {
          document.body.appendChild(backdrop!);
          document.body.appendChild(menu);
        }
      } else {
        if (menu && menu.parentElement !== root) {
          root?.appendChild(backdrop!);
          root?.appendChild(menu);
        }
      }
    }

    syncPortal();
    window.addEventListener('resize', syncPortal, { passive: true });

    function openMenu() {
      syncPortal();
      menu?.classList.remove('hidden');
      backdrop?.classList.remove('hidden');
      trigger?.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      menu?.classList.add('hidden');
      backdrop?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeMenu();
    });

    backdrop.addEventListener('click', (e) => {
      e.stopPropagation();
      closeMenu();
    });

    // Don't bubble clicks from inside the menu out to document
    menu.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!root.contains(target) && !menu.contains(target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });

    // Sync current values from documentElement or localStorage
    const currentAccent = document.documentElement.getAttribute('data-accent') || 'asuka';
    const currentBg = document.documentElement.getAttribute('data-accent-bg') === 'true';
    const currentDensity = document.documentElement.getAttribute('data-card-density') || 'magazine';

    function updatePaletteUI(activeId: string) {
      paletteButtons.forEach((btn) => {
        const id = btn.getAttribute('data-accent-choice');
        const check = btn.querySelector('.palette-check');
        const isActive = id === activeId;
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
        if (isActive) {
          btn.classList.add('border-[var(--accent)]', 'bg-[var(--surface-2)]');
          check?.classList.remove('opacity-0');
        } else {
          btn.classList.remove('border-[var(--accent)]', 'bg-[var(--surface-2)]');
          check?.classList.add('opacity-0');
        }
      });
    }

    function updateDensityUI(activeDensity: string) {
      densityButtons.forEach((btn) => {
        const d = btn.getAttribute('data-density-choice');
        const isActive = d === activeDensity;
        if (isActive) {
          btn.classList.add('border-[var(--accent)]', 'text-[var(--accent)]', 'bg-[var(--surface-2)]');
        } else {
          btn.classList.remove('border-[var(--accent)]', 'text-[var(--accent)]', 'bg-[var(--surface-2)]');
        }
      });
    }

    updatePaletteUI(currentAccent);
    updateDensityUI(currentDensity);
    if (bgToggle) bgToggle.checked = currentBg;

    paletteButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-accent-choice');
        if (!id) return;
        document.documentElement.setAttribute('data-accent', id);
        try {
          localStorage.setItem('preference-accent-color', id);
        } catch {}
        updatePaletteUI(id);
      });
    });

    if (bgToggle) {
      bgToggle.addEventListener('change', () => {
        const val = bgToggle.checked;
        document.documentElement.setAttribute('data-accent-bg', val ? 'true' : 'false');
        try {
          localStorage.setItem('preference-accent-bg', val ? 'true' : 'false');
        } catch {}
      });
    }

    densityButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const d = btn.getAttribute('data-density-choice');
        if (!d) return;
        document.documentElement.setAttribute('data-card-density', d);
        try {
          localStorage.setItem('preference-card-density', d);
        } catch {}
        updateDensityUI(d);
      });
    });
  }

  initSettingsFlyout();
  document.addEventListener('astro:page-load', initSettingsFlyout);
</script>
