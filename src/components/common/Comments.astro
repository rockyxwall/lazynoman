---
import { WALINE_SERVER_URL } from '../../consts';
import '@waline/client/style';
---

<div id="waline" class="mt-16 pt-8 border-t border-border" data-server-url={WALINE_SERVER_URL}></div>


<script>
  import { init } from '@waline/client/full';

  const initWaline = () => {
    const walineEl = document.querySelector('#waline');
    if (walineEl instanceof HTMLElement) {
      const serverURL = walineEl.dataset.serverUrl;
      init({
        el: '#waline',
        serverURL: serverURL || '',
        lang: 'en',
        dark: 'html.dark',
      });
    }
  };

  // Run on initial load
  initWaline();

  // Run on View Transitions navigation
  document.addEventListener('astro:after-swap', initWaline);
</script>

<style is:global>
  /* Customize Waline theme to match project oklch variables if needed */
  :root {
    --waline-theme-color: var(--p-primary);
    --waline-active-color: var(--p-primary);
    --waline-badge-color: var(--p-primary);
    --waline-border-color: var(--p-border);
    --waline-bgcolor: var(--p-bg);
    --waline-bgcolor-light: var(--p-secondary);
    --waline-bgcolor-hover: var(--p-secondary);
    --waline-color: var(--p-fg);
  }
</style>
