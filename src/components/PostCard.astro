---
import type { Post } from "../lib/content";
import { displayDate, summary } from "../lib/content";
import Card from "@/components/Item/Card.astro";

interface Props {
  post: Post;
  heading?: "h2" | "h3";
  priority?: boolean;
}

const { post, heading = "h2" } = Astro.props;
const image = post.data.image
  ? `/${post.data.image.replace(/^\//, "")}`
  : "/images/bannerbackground.webp";
const category = post.data.categories[0];
const eyebrowText = category
  ? `${category} · ${displayDate(post)}`
  : displayDate(post);
---

<Card
  variant="stacked"
  image={image}
  imageAlt={`${post.data.title} featured image`}
  eyebrow={eyebrowText}
  heading={post.data.title}
  headingTag={heading}
  text={summary(post, 150)}
  buttonLabel="Read review"
  buttonHref={post.data.url}
/>
