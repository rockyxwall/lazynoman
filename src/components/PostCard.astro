---
import type { Post } from "../lib/content";
import { displayDate, summary } from "../lib/content";

interface Props {
  post: Post;
  heading?: "h2" | "h3";
  priority?: boolean;
}

const { post, heading = "h2", priority = false } = Astro.props;
const image = post.data.image
  ? `/${post.data.image.replace(/^\//, "")}`
  : "/images/bannerbackground.webp";
const category = post.data.categories[0];
const HeadingTag = heading;
---

<article class="wotaku-card">
  <a href={post.data.url} class="card-link" aria-label={post.data.title}>
    <div class="card-visual">
      <img
        src={image}
        alt={`${post.data.title} featured image`}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : undefined}
        width="1200"
        height="675"
      />
    </div>
    <div class="card-body">
      <div class="card-meta">
        {category && <span class="card-badge">{category}</span>}
        <time datetime={post.data.date} class="card-date"
          >{displayDate(post)}</time
        >
      </div>
      <HeadingTag class="card-title">{post.data.title}</HeadingTag>
      <p class="card-text">{summary(post, 140)}</p>
    </div>
  </a>
</article>
