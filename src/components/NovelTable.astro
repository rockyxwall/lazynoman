---
import { ExternalLink, BookOpen, Star } from "@lucide/astro";

interface NovelRow {
  rank: number | string;
  tier: "s" | "a" | "b" | "c";
  title: string;
  url?: string;
  sourceUrl?: string;
  status: "Ongoing" | "Completed" | "Hiatus";
  score: string;
  tropes: string[];
  note?: string;
}

interface Props {
  caption?: string;
  novels: NovelRow[];
}

const { caption, novels } = Astro.props;
---

<div class="novel-table-wrapper my-6">
  <table class="novel-table">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        <th class="w-16">Tier</th>
        <th>Title</th>
        <th>Tropes / Subgenre</th>
        <th class="w-24">Status</th>
        <th class="w-20">Score</th>
        <th class="w-28 text-right">Links</th>
      </tr>
    </thead>
    <tbody>
      {novels.map((n) => {
        const tierClass = `tier-${n.tier.toLowerCase()}`;
        const statusClass =
          n.status === "Ongoing"
            ? "status-ongoing"
            : n.status === "Completed"
            ? "status-completed"
            : "status-hiatus";

        return (
          <tr>
            <td>
              <span class={`tier-badge ${tierClass}`}>
                {n.tier.toUpperCase()}
              </span>
            </td>
            <td>
              <div class="font-bold text-[var(--text)]">
                {n.url ? (
                  <a href={n.url} class="hover:text-[var(--accent)] transition-colors no-underline">
                    {n.title}
                  </a>
                ) : (
                  n.title
                )}
              </div>
              {n.note && (
                <div class="text-xs text-[var(--muted)] mt-0.5 line-clamp-1">
                  {n.note}
                </div>
              )}
            </td>
            <td>
              <div class="flex items-center gap-1 flex-wrap">
                {n.tropes.map((t) => (
                  <span class="text-[0.7rem] px-1.5 py-0.5 rounded bg-[var(--surface-2)] text-[var(--muted)] border border-[var(--border)]">
                    {t}
                  </span>
                ))}
              </div>
            </td>
            <td class="text-xs whitespace-nowrap">
              <span class="inline-flex items-center">
                <span class={`status-dot ${statusClass}`} />
                <span>{n.status}</span>
              </span>
            </td>
            <td>
              <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-400">
                <Star class="w-3 h-3 fill-current" />
                <span>{n.score}</span>
              </span>
            </td>
            <td class="text-right whitespace-nowrap">
              <div class="inline-flex items-center gap-2">
                {n.sourceUrl && (
                  <a
                    href={n.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--muted)] hover:text-[var(--text)] transition-colors"
                    title="External Source"
                  >
                    <ExternalLink class="w-3.5 h-3.5" />
                  </a>
                )}
                {n.url && (
                  <a
                    href={n.url}
                    class="text-[var(--accent)] hover:text-[var(--accent-strong)] transition-colors font-semibold text-xs inline-flex items-center gap-0.5"
                    title="Read Review"
                  >
                    <BookOpen class="w-3.5 h-3.5" />
                    <span>Review</span>
                  </a>
                )}
              </div>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

