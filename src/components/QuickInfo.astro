---
interface Props {
  title: string
  novelInfo?: {
    officialTitle?: string
    itemAuthor?: string
    rating?: number
    novelGenres?: string[]
    novelTags?: string[]
    status?: string
    chapterCount?: number
    platform?: string
    novelDescription?: string
  }
  placement: 'mobile' | 'desktop'
}

const {
  title,
  novelInfo = {},
  placement,
} = Astro.props

const {
  officialTitle,
  itemAuthor,
  rating,
  novelGenres = [],
  novelTags = [],
  status,
  chapterCount,
  platform,
  novelDescription,
} = novelInfo

const novelName = officialTitle || title
const filledStars = rating ? Math.floor(rating / 2) : 0
const emptyStars = 5 - filledStars
const starDisplay = '★'.repeat(filledStars) + '☆'.repeat(emptyStars)

const visibleLimit = 5
const genreVisible = novelGenres.slice(0, visibleLimit)
const genreHidden = novelGenres.slice(visibleLimit)
const hasGenreHidden = genreHidden.length > 0
const tagVisible = novelTags.slice(0, visibleLimit)
const tagHidden = novelTags.slice(visibleLimit)
const hasTagHidden = tagHidden.length > 0

const wrapperClass =
  placement === 'mobile'
    ? 'mb-6 lg:hidden'
    : 'hidden lg:block sticky top-24'
---

<div class={wrapperClass}>
  <div class="bg-card text-card-foreground flex flex-col gap-4 rounded-xl border border-border py-5 shadow-sm">
    <div class="px-5 space-y-1">
      <h3 class="font-semibold leading-tight text-base">{novelName}</h3>
      {itemAuthor && <p class="text-sm text-muted-foreground">by {itemAuthor}</p>}
    </div>

    <div class="px-5 space-y-3">
      {rating && (
        <div class="flex items-center gap-2">
          <span class="text-amber-500 text-sm tracking-wide">{starDisplay}</span>
          <span class="font-mono text-sm font-bold">{rating}/10</span>
        </div>
      )}

      {novelGenres.length > 0 && (
        <div class="space-y-1">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Genres</span>
          <div class="flex flex-wrap gap-1" data-novel-items>
            {genreVisible.map((g) => (
              <span class="inline-flex items-center rounded-full border border-border bg-secondary px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-secondary-foreground leading-none">
                {g}
              </span>
            ))}
            {genreHidden.map((g) => (
              <span class="hidden-item inline-flex items-center rounded-full border border-border bg-secondary px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-secondary-foreground leading-none" data-hidden>
                {g}
              </span>
            ))}
            {hasGenreHidden && (
              <button class="inline-flex items-center rounded-full border border-border bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground leading-none cursor-pointer hover:bg-accent" data-toggle-btn type="button">
                +{genreHidden.length} more
              </button>
            )}
          </div>
        </div>
      )}

      {novelTags.length > 0 && (
        <div class="space-y-1">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">Tags</span>
          <div class="flex flex-wrap gap-1" data-novel-items>
            {tagVisible.map((t) => (
              <span class="inline-flex items-center rounded-full border border-border bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground leading-none">
                {t}
              </span>
            ))}
            {tagHidden.map((t) => (
              <span class="hidden-item inline-flex items-center rounded-full border border-border bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground leading-none" data-hidden>
                {t}
              </span>
            ))}
            {hasTagHidden && (
              <button class="inline-flex items-center rounded-full border border-border bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground leading-none cursor-pointer hover:bg-accent" data-toggle-btn type="button">
                +{tagHidden.length} more
              </button>
            )}
          </div>
        </div>
      )}

      <div class="space-y-1 border-t border-border pt-3 text-sm">
        {status && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Status</span>
            <span class="font-medium">{status}</span>
          </div>
        )}
        {chapterCount && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Chapters</span>
            <span class="font-medium">~{chapterCount}</span>
          </div>
        )}
        {platform && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Platform</span>
            <span class="font-medium">{platform}</span>
          </div>
        )}
      </div>

      {novelDescription && (
        <p class="text-xs text-muted-foreground leading-relaxed border-t border-border pt-3">
          {novelDescription}
        </p>
      )}
    </div>
  </div>
</div>

<script>
  const containers = document.querySelectorAll('[data-novel-items]')
  for (const container of containers) {
    const btn = container.querySelector('[data-toggle-btn]')
    const hidden = container.querySelectorAll('[data-hidden]')
    if (btn && hidden.length) {
      btn.addEventListener('click', () => {
        hidden.forEach(el => el.classList.remove('hidden-item'))
        btn.remove()
      })
    }
  }
</script>

<style>
  .hidden-item { display: none; }
</style>
