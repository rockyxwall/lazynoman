---
interface Props {
  title: string
  quickInfo?: {
    officialTitle?: string
    itemAuthor?: string
    rating?: number
    novelGenres?: string[]
    novelTags?: string[]
    status?: string
    chapterCount?: number
    platform?: string
    novelDescription?: string
    novelType?: string
  }
  placement: 'mobile' | 'desktop'
}

const {
  title,
  quickInfo = {},
  placement,
} = Astro.props

const {
  officialTitle,
  itemAuthor,
  rating,
  novelGenres = [],
  novelTags = [],
  status,
  chapterCount,
  platform,
  novelDescription,
  novelType,
} = quickInfo

const novelName = officialTitle || title

const visibleLimit = 5
const genreVisible = novelGenres.slice(0, visibleLimit)
const genreHidden = novelGenres.slice(visibleLimit)
const hasGenreHidden = genreHidden.length > 0
const tagVisible = novelTags.slice(0, visibleLimit)
const tagHidden = novelTags.slice(visibleLimit)
const hasTagHidden = tagHidden.length > 0

const wrapperClass =
  placement === 'mobile'
    ? 'mb-6 lg:hidden'
    : 'hidden lg:block sticky top-24'
---

<div class={wrapperClass}>
  <div class="flex flex-col gap-2">
    <h3 class="text-sm font-bold uppercase tracking-wider text-muted-foreground pb-2 border-b border-border">
      Quick Info
    </h3>
    <div class="space-y-1">
      <span class="text-xs font-semibold text-muted-foreground">Title</span>
      <p class="text-sm font-semibold leading-tight">{novelName}</p>
    </div>
    {itemAuthor && (
      <div class="space-y-1">
        <span class="text-xs font-semibold text-muted-foreground">Author</span>
        <p class="text-sm text-muted-foreground">{itemAuthor}</p>
      </div>
    )}
    {novelType && (
      <div class="space-y-1">
        <span class="text-xs font-semibold text-muted-foreground">Type</span>
        <p class="text-sm text-muted-foreground">{novelType}</p>
      </div>
    )}

      {novelDescription && (
        <div class="space-y-1">
          <span class="text-xs font-semibold text-muted-foreground">Description</span>
          <p class="text-sm text-muted-foreground leading-relaxed">
            {novelDescription}
          </p>
        </div>
      )}

    <div class="space-y-2">
      {novelGenres.length > 0 && (
        <div class="space-y-1.5" data-novel-section>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-muted-foreground">Genres</span>
            {hasGenreHidden && (
              <button class="text-xs text-muted-foreground/70 hover:text-foreground cursor-pointer transition-colors" data-toggle-btn data-hidden-count={genreHidden.length} type="button">
                +{genreHidden.length} more
              </button>
            )}
          </div>
          <div class="flex flex-wrap gap-1.5" data-novel-items>
            {genreVisible.map((g) => (
              <span class="text-sm text-muted-foreground underline underline-offset-2 decoration-muted-foreground/50">
                {g}
              </span>
            ))}
            {genreHidden.map((g) => (
              <span class="hidden-item text-sm text-muted-foreground underline underline-offset-2 decoration-muted-foreground/50" data-hidden>
                {g}
              </span>
            ))}
          </div>
        </div>
      )}

      {novelTags.length > 0 && (
        <div class="space-y-1.5" data-novel-section>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-muted-foreground">Tags</span>
            {hasTagHidden && (
              <button class="text-xs text-muted-foreground/70 hover:text-foreground cursor-pointer transition-colors" data-toggle-btn data-hidden-count={tagHidden.length} type="button">
                +{tagHidden.length} more
              </button>
            )}
          </div>
          <div class="flex flex-wrap gap-1.5" data-novel-items>
            {tagVisible.map((t) => (
              <span class="text-sm text-muted-foreground underline underline-offset-2 decoration-muted-foreground/50">
                {t}
              </span>
            ))}
            {tagHidden.map((t) => (
              <span class="hidden-item text-sm text-muted-foreground underline underline-offset-2 decoration-muted-foreground/50" data-hidden>
                {t}
              </span>
            ))}
          </div>
        </div>
      )}

      <div class="space-y-1 text-sm">
        {rating && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Rating</span>
            <span class="font-medium">{rating}/10</span>
          </div>
        )}
        {status && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Status</span>
            <span class="font-medium">{status}</span>
          </div>
        )}
        {chapterCount && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Chapters</span>
            <span class="font-medium">~{chapterCount}</span>
          </div>
        )}
        {platform && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">Platform</span>
            <span class="font-medium">{platform}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<script>
  const btns = document.querySelectorAll('[data-toggle-btn]')
  for (const btn of btns) {
    const section = btn.closest('[data-novel-section]')
    const hidden = section.querySelectorAll('[data-hidden]')
    const count = parseInt(btn.dataset.hiddenCount)
    btn.addEventListener('click', () => {
      const expanded = btn.dataset.expanded === 'true'
      if (expanded) {
        hidden.forEach(el => el.classList.add('hidden-item'))
        btn.dataset.expanded = 'false'
        btn.textContent = `+${count} more`
      } else {
        hidden.forEach(el => el.classList.remove('hidden-item'))
        btn.dataset.expanded = 'true'
        btn.textContent = 'show less'
      }
    })
  }
</script>

<style>
  .hidden-item { display: none; }
</style>
