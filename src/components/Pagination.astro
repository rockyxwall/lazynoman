---
interface Props {
  page: number;
  pages: number;
  base: string;
}

const { page, pages, base } = Astro.props;
const route = (value: number) => (value === 1 ? base : `${base}page/${value}/`);
---

{
  pages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      <span class="pagination-prev">
        {page > 1 && (
          <a
            rel="prev"
            href={route(page - 1)}
            class="icon-button text-xs font-semibold px-3 py-1.5 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text)] transition-colors inline-flex items-center gap-1"
          >
            <span>← Newer</span>
          </a>
        )}
      </span>
      <span class="pagination-status text-xs font-medium text-[var(--muted)] px-3 py-1 rounded-full bg-[var(--surface)] border border-[var(--border)]">
        Page {page} of {pages}
      </span>
      <span class="pagination-next">
        {page < pages && (
          <a
            rel="next"
            href={route(page + 1)}
            class="icon-button text-xs font-semibold px-3 py-1.5 rounded-lg border border-[var(--border)] hover:border-[var(--accent)] text-[var(--text)] transition-colors inline-flex items-center gap-1"
          >
            <span>Older →</span>
          </a>
        )}
      </span>
    </nav>
  )
}
