---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RecentPosts from '../components/RecentPosts.astro';
import QuickInfo from '../components/QuickInfo.astro';
import { Tag } from '../components/ui/tag';
import { SITE_TITLE } from '../consts';
import '../styles/markdown.css';

type Props = CollectionEntry<'post'>['data'] & {
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  tags,
  headings = [],
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} ogType="article" />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WC6RL4N6"
    height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />

    <main class="pt-12 overflow-x-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 lg:gap-12">
        <article class="lg:col-span-3 min-w-0">

        {/* ── Post Header ── */}
        <header class="post-header mb-12">
          {/* Post title */}
          <h1 class="post-title mb-6">{title}</h1>

          {/* Dateline & Category */}
          <div class="post-meta-row text-muted-foreground">
            <div class="post-dateline flex flex-wrap items-center gap-x-6 gap-y-3 text-xs tracking-wider font-medium opacity-80">
              {category && (
                <span class="flex items-center gap-1.5 font-medium leading-none capitalize">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M20 20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.9a2 2 0 0 0 1.42-.83l.66-.84a2 2 0 0 1 1.42-.83H18a2 2 0 0 1 2 2Z"/></svg>
                  <span class="inline-block">{category}</span>
                </span>
              )}
              
              <span class="flex items-center gap-1.5 leading-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/></svg>
                <time datetime={pubDate.toISOString()} class="inline-block">
                  <FormattedDate date={pubDate} />
                </time>
              </span>

              {updatedDate && (
                <span class="dateline-updated flex items-center gap-1.5 leading-none">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M12 7v5l4 2"/></svg>
                  <span class="inline-block">Updated <FormattedDate date={updatedDate} /></span>
                </span>
              )}
            </div>
          </div>
        </header>

        {/* ── Hero Image ── */}
        {heroImage && (
          <div class="hero-wrap rounded-lg overflow-hidden mb-12 shadow-sm border border-border/50">
            <Image
              src={heroImage}
              alt={`Cover for ${title}`}
              class="hero-img"
              loading="eager"
            />
          </div>
        )}

        {/* ── Quick Info (mobile) ── */}
        <QuickInfo {...Astro.props} placement="mobile" />

        {/* ── Table of Contents ── */}
        <TableOfContents headings={headings} />

        {/* ── Prose Body ── */}
        <div class="markdown-body">
          <span id="review-start" class="block" style="scroll-margin-top: 5rem;"></span>
          <slot />
        </div>

        {/* ── Tags ── */}
        {tags && tags.length > 0 && (
          <div class="post-tags mt-12 mb-4">
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <Tag>{tag}</Tag>
              ))}
            </div>
          </div>
        )}

        <Comments />

      </article>

      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-12">
          <QuickInfo {...Astro.props} placement="desktop" />
          <RecentPosts />
        </div>
      </aside>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  :root {
    --p-bg:        oklch(1 0 0);
    --p-fg:        oklch(0.145 0 0);
    --p-primary:   oklch(0.205 0 0);
    --p-secondary: oklch(0.97 0 0);
    --p-border:    oklch(0.922 0 0);
    --p-muted:     oklch(0.50 0 0);
    --p-radius:    0.625rem;
  }

  :global(.dark) {
    --p-bg:        oklch(0.19 0 0);
    --p-fg:        oklch(0.92 0 0);
    --p-primary:   oklch(0.92 0 0);
    --p-secondary: oklch(0.28 0 0);
    --p-border:    oklch(0.35 0 0);
    --p-muted:     oklch(0.62 0 0);
  }

  .hero-wrap {
    position: relative;
    width: 100%;
    height: auto;
    max-height: 60vh;
    display: flex;
    justify-content: center;
    background: var(--p-bg);
  }
 
  .hero-img {
    width: 100%;
    height: auto;
    max-height: 60vh;
    display: block;
    object-fit: cover;
  }
 
  .post-title {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--p-fg);
  }

  .dateline-category {
    color: var(--p-primary);
  }
</style>