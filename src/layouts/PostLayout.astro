---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'post'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  creator,
  medium,
  status,
  platform,
  progress,
  tags,
  summary,
  officialTitle,
  synonyms,
} = Astro.props;

const metaItems = [
  { label: 'Creator',  value: creator  },
  { label: 'Medium',   value: medium   },
  { label: 'Status',   value: status   },
  { label: 'Platform', value: platform },
  { label: 'Progress', value: progress },
].filter((item): item is { label: string; value: string } => Boolean(item.value));
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} ogType="article" />
  </head>

  <body>
    <Header />

    <main>
      <article>

        {/* ── Hero Image ── */}
        {heroImage && (
          <div class="hero-wrap">
            <Image
              src={heroImage}
              alt={`Cover for ${title}`}
              class="hero-img"
            />
            <div class="hero-veil" aria-hidden="true" />
          </div>
        )}

        {/* ── Post Header ── */}
        <header class={`post-header mx-auto max-w-4xl px-6 ${heroImage ? 'has-hero' : 'no-hero'}`}>

          {/* Dateline */}
          <p class="post-dateline">
            {category && <span class="dateline-category">{category}</span>}
            {category && <span class="dateline-sep" aria-hidden="true">·</span>}
            <time datetime={pubDate.toISOString()}>
              <FormattedDate date={pubDate} />
            </time>
            {updatedDate && (
              <span class="dateline-updated">
                · Updated <FormattedDate date={updatedDate} />
              </span>
            )}
          </p>

          {/* Post title — reviewer's headline */}
          <h1 class="post-title">{title}</h1>

          {/* Official title + synonyms */}
          {(officialTitle || (synonyms && synonyms.length > 0)) && (
            <p class="official-title-line">
              {officialTitle && <span class="official-name">{officialTitle}</span>}
              {synonyms && synonyms.length > 0 && (
                <span class="official-synonyms">
                  {officialTitle ? ' · ' : ''}{synonyms.join(' · ')}
                </span>
              )}
            </p>
          )}

          {/* Summary — the real lede */}
          {summary && <p class="post-summary">{summary}</p>}

          {/* Metadata strip */}
          {metaItems.length > 0 && (
            <dl class="meta-strip">
              {metaItems.map(({ label, value }) => (
                <div class="meta-pair">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          )}

          {/* Tags */}
          {tags && tags.length > 0 && (
            <div class="post-tags" role="list" aria-label="Tags">
              {tags.map((tag: string) => (
                <span class="tag" role="listitem">{tag}</span>
              ))}
            </div>
          )}

        </header>

        {/* ── Divider ── */}
        <div class="post-divider mx-auto max-w-4xl px-6" aria-hidden="true" />

        {/* ── Prose Body ── */}
        <div class="mx-auto max-w-4xl px-6 pb-24 pt-8">
          <div class="post-prose">
            <slot />
          </div>
        </div>

      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  /*
   * ─────────────────────────────────────────────────────
   * THEME BRIDGE
   * Mirrors the site's @theme OKLCH tokens; stays in sync
   * when .dark is toggled on <html>.
   * ─────────────────────────────────────────────────────
   */
  :root {
    --p-bg:        oklch(1 0 0);
    --p-fg:        oklch(0.145 0 0);
    --p-primary:   oklch(0.205 0 0);
    --p-secondary: oklch(0.97 0 0);
    --p-border:    oklch(0.922 0 0);
    --p-muted:     oklch(0.50 0 0);
    --p-radius:    0.625rem;
  }

  :global(.dark) {
    --p-bg:        oklch(0.19 0 0);
    --p-fg:        oklch(0.92 0 0);
    --p-primary:   oklch(0.92 0 0);
    --p-secondary: oklch(0.28 0 0);
    --p-border:    oklch(0.28 0 0);
    --p-muted:     oklch(0.62 0 0);
  }


  /* ═══════════════════════════
     HERO
  ═══════════════════════════ */

  .hero-wrap {
    position: relative;
    width: 100%;
    line-height: 0; /* collapses whitespace gap below img */
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center 30%;
  }

  /*
   * Gradient veil: transparent → page-bg.
   * Starts late (40%) so the image reads fully before fading.
   */
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 40%,
      color-mix(in oklch, var(--p-bg) 18%, transparent) 60%,
      color-mix(in oklch, var(--p-bg) 68%, transparent) 80%,
      var(--p-bg) 100%
    );
  }


  /* ═══════════════════════════
     POST HEADER
  ═══════════════════════════ */

  .post-header {
    position: relative;
    z-index: 2;
  }

  /* Pulls the header up into the faded veil zone */
  .post-header.has-hero { margin-top: -5.5rem; }
  .post-header.no-hero  { margin-top: 3.5rem;  }


  /* ── Dateline ── */

  .post-dateline {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-muted);
    margin: 0 0 0.875rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dateline-category {
    color: var(--p-primary);
    opacity: 0.8;
  }

  .dateline-sep {
    opacity: 0.35;
  }

  .dateline-updated {
    font-weight: 400;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.03em;
  }


  /* ── Post Title ── */

  .post-title {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--p-fg);
    margin: 0 0 0.625rem;
    /*
     * Soft glow aids legibility when sitting over the hero veil.
     * Invisible on plain backgrounds.
     */
    text-shadow:
      0 1px 14px color-mix(in oklch, var(--p-bg) 72%, transparent),
      0 3px 32px color-mix(in oklch, var(--p-bg) 48%, transparent);
  }


  /* ── Official Title & Synonyms ── */

  .official-title-line {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0 0 1.375rem;
    display: flex;
    flex-wrap: wrap;
  }

  .official-name {
    font-weight: 600;
    color: var(--p-fg);
    opacity: 0.55;
  }

  .official-synonyms {
    font-weight: 400;
    color: var(--p-muted);
  }


  /* ── Summary / Lede ── */

  .post-summary {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(1.0625rem, 1.2vw + 0.65rem, 1.1875rem);
    line-height: 1.7;
    color: var(--p-muted);
    font-style: italic;
    margin: 0 0 1.75rem;
  }


  /* ── Metadata Strip ── */

  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .meta-pair {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  /*
   * Vertical hairline separator between pairs.
   * Lives as a flex child via ::before — no extra markup needed.
   */
  .meta-pair:not(:first-child)::before {
    content: '';
    display: block;
    width: 1px;
    height: 0.75em;
    background: var(--p-border);
    margin: 0 0.75rem;
    align-self: center;
    flex-shrink: 0;
  }

  .meta-pair dt {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--p-muted);
  }

  .meta-pair dd {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--p-fg);
    margin: 0;
  }


  /* ── Tags ── */

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 1.625rem;
  }

  .tag {
    font-family: 'Geist Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: calc(var(--p-radius) * 0.7);
    background: var(--p-secondary);
    color: var(--p-muted);
    border: 1px solid var(--p-border);
    transition: color 0.15s, border-color 0.15s;
  }

  .tag:hover {
    color: var(--p-primary);
    border-color: color-mix(in oklch, var(--p-primary) 45%, transparent);
  }


  /* ── Post Divider ── */

  .post-divider {
    height: 1px;
    background: var(--p-border);
    margin-bottom: 0; /* prose container supplies top padding */
  }


  /* ═══════════════════════════
     PROSE BODY
  ═══════════════════════════ */

  .post-prose {
    font-family: 'Atkinson', 'Geist Variable', sans-serif;
    font-size: clamp(1.0625rem, 1.2vw + 0.75rem, 1.25rem);
    line-height: 1.75;
    color: var(--p-fg);
  }

  .post-prose :global(p) { margin-bottom: 1.75em; }

  .post-prose :global(h2) {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 2.2em 0 0.8em;
    color: var(--p-fg);
  }

  .post-prose :global(h3) {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(1.5rem, 4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 2em 0 0.7em;
    color: var(--p-fg);
  }

  .post-prose :global(h4) {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
    margin: 1.8em 0 0.6em;
    color: var(--p-fg);
  }

  .post-prose :global(h5) {
    font-family: 'Atkinson', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 1.6em 0 0.5em;
    color: var(--p-fg);
  }

  .post-prose :global(h6) {
    font-family: 'Atkinson', sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 1.6em 0 0.5em;
    color: var(--p-muted);
  }

  .post-prose :global(blockquote) {
    border-left: 3px solid var(--p-primary);
    background: var(--p-secondary);
    margin: 2.25em 0;
    padding: 1.1em 1.5em;
    border-radius: 0 var(--p-radius) var(--p-radius) 0;
    font-size: 1.1rem;
    font-style: italic;
    color: var(--p-muted);
  }

  .post-prose :global(blockquote p) { margin: 0; }

  .post-prose :global(:not(pre) > code) {
    font-family: 'Geist Mono', monospace;
    font-size: 0.875em;
    background: var(--p-secondary);
    color: var(--p-primary);
    padding: 0.15em 0.45em;
    border-radius: calc(var(--p-radius) / 2);
    border: 1px solid var(--p-border);
  }

  .post-prose :global(pre) {
    font-family: 'Geist Mono', monospace;
    font-size: 0.875rem;
    background: var(--p-secondary);
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 2em 0;
    line-height: 1.65;
  }

  .post-prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  .post-prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--p-border);
    margin: 2.5em 0;
  }

  .post-prose :global(a) {
    color: var(--p-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity 0.15s;
  }

  .post-prose :global(a:hover) { opacity: 0.65; }

  .post-prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--p-radius);
    border: 1px solid var(--p-border);
    margin: 2em 0;
    display: block;
  }

  .post-prose :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.55em;
  }

  .post-prose :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.55em;
  }

  .post-prose :global(li) {
    margin-bottom: 0.45em;
    padding-left: 0.35rem;
  }

  .post-prose :global(li > p) {
    margin-top: 0.45em;
    margin-bottom: 0.45em;
  }

  .post-prose :global(ul ul),
  .post-prose :global(ol ol),
  .post-prose :global(ul ol),
  .post-prose :global(ol ul) {
    margin-top: 0.45em;
    margin-bottom: 0.45em;
  }

  .post-prose :global(li::marker) {
    color: var(--p-muted);
    font-weight: 600;
  }

  .post-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2em 0;
    font-size: 0.95em;
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius);
    overflow: hidden;
  }

  .post-prose :global(th),
  .post-prose :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--p-border);
    text-align: left;
  }

  .post-prose :global(th) {
    background: var(--p-secondary);
    color: var(--p-fg);
    font-weight: 700;
  }

  .post-prose :global(tr:nth-child(even)) {
    background: color-mix(in oklch, var(--p-secondary) 30%, transparent);
  }

  .post-prose :global(strong) {
    font-weight: 700;
    color: var(--p-fg);
  }


  /* ═══════════════════════════
     RESPONSIVE
  ═══════════════════════════ */

  @media (max-width: 768px) {
    .post-header.has-hero { margin-top: -3.5rem; }
    .post-header.no-hero  { margin-top: 2rem; }

    .meta-pair:not(:first-child)::before { margin: 0 0.5rem; }
  }

  @media (max-width: 480px) {
    .post-header.has-hero { margin-top: -2rem; }

    .post-title { font-size: clamp(1.625rem, 7.5vw, 2.25rem); }

    /* On very narrow screens the meta strip naturally wraps — no override needed */
  }
</style>