---
import "../styles/global.css";
import { site } from "../lib/content";
import SkipLink from "@/components/Global/SkipLink.astro";
import Nav from "@/components/Global/Nav.astro";
import Footer from "@/components/Global/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  robots?: string;
  preloadImage?: string;
  previous?: string;
  next?: string;
  feed?: string;
}

const {
  title = site.title,
  description = site.description,
  canonical = Astro.url.pathname,
  image = site.socialImage ?? "/img-border.png",
  type = "website",
  publishedTime,
  robots,
  preloadImage,
  previous,
  next,
  feed,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(canonical, site.url).toString();
const imageUrl = new URL(
  image.startsWith("/") ? image : `/${image}`,
  site.url,
).toString();
const canonicalSegments =
  canonicalUrl === `${site.url}/`
    ? []
    : new URL(canonicalUrl).pathname.split("/").filter(Boolean);
const paginationPage =
  canonicalSegments.at(-2) === "page" &&
  /^\d+$/.test(canonicalSegments.at(-1) ?? "")
    ? canonicalSegments.at(-1)
    : undefined;
const breadcrumbSegments = paginationPage
  ? canonicalSegments.slice(0, -2)
  : canonicalSegments;
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
  ...breadcrumbSegments.map((segment, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name:
      !paginationPage && index === breadcrumbSegments.length - 1
        ? title
        : segment.replaceAll("-", " "),
    item: new URL(
      `/${breadcrumbSegments.slice(0, index + 1).join("/")}/`,
      site.url,
    ).toString(),
  })),
  ...(paginationPage
    ? [
        {
          "@type": "ListItem",
          position: breadcrumbSegments.length + 2,
          name: `${title} page ${paginationPage}`,
          item: canonicalUrl,
        },
      ]
    : []),
];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": `${site.url}/#website` },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    ...(type === "article"
      ? [
          {
            "@type": "BlogPosting",
            "@id": `${canonicalUrl}#article`,
            headline: title,
            description,
            image: imageUrl,
            datePublished: publishedTime,
            author: { "@type": "Person", name: site.author },
            mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      previous && (
        <link rel="prev" href={new URL(previous, site.url).toString()} />
      )
    }
    {next && <link rel="next" href={new URL(next, site.url).toString()} />}
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    {
      feed && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={site.title}
          href={new URL(feed, site.url).toString()}
        />
      )
    }
    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage}
          as="image"
          fetchpriority="high"
        />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      document.documentElement.classList.add("js");
      const saved = localStorage.getItem("theme");
      document.documentElement.dataset.theme = saved ?? "dark";
    </script>
  </head>
  <body>
    <SkipLink />
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
