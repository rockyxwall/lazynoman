---
import "../styles/global.css";
import { site } from "../lib/content";
import { Sun, Moon, Menu as MenuIcon, Search as SearchIcon } from "@lucide/astro";
import SettingsFlyout from "../components/SettingsFlyout.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  robots?: string;
  preloadImage?: string;
  previous?: string;
  next?: string;
  feed?: string;
}

const {
  title = site.title,
  description = site.description,
  canonical = Astro.url.pathname,
  image = site.socialImage ?? "/img-border.png",
  type = "website",
  publishedTime,
  robots,
  preloadImage,
  previous,
  next,
  feed,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(canonical, site.url).toString();
const imageUrl = new URL(
  image.startsWith("/") ? image : `/${image}`,
  site.url,
).toString();
const canonicalSegments =
  canonicalUrl === `${site.url}/`
    ? []
    : new URL(canonicalUrl).pathname.split("/").filter(Boolean);
const paginationPage =
  canonicalSegments.at(-2) === "page" &&
  /^\d+$/.test(canonicalSegments.at(-1) ?? "")
    ? canonicalSegments.at(-1)
    : undefined;
const breadcrumbSegments = paginationPage
  ? canonicalSegments.slice(0, -2)
  : canonicalSegments;
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
  ...breadcrumbSegments.map((segment, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name:
      !paginationPage && index === breadcrumbSegments.length - 1
        ? title
        : segment.replaceAll("-", " "),
    item: new URL(
      `/${breadcrumbSegments.slice(0, index + 1).join("/")}/`,
      site.url,
    ).toString(),
  })),
  ...(paginationPage
    ? [
        {
          "@type": "ListItem",
          position: breadcrumbSegments.length + 2,
          name: `${title} page ${paginationPage}`,
          item: canonicalUrl,
        },
      ]
    : []),
];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": `${site.url}/#website` },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    ...(type === "article"
      ? [
          {
            "@type": "BlogPosting",
            "@id": `${canonicalUrl}#article`,
            headline: title,
            description,
            image: imageUrl,
            datePublished: publishedTime,
            author: { "@type": "Person", name: site.author },
            mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
  ],
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      previous && (
        <link rel="prev" href={new URL(previous, site.url).toString()} />
      )
    }
    {next && <link rel="next" href={new URL(next, site.url).toString()} />}
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    {
      feed && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={site.title}
          href={new URL(feed, site.url).toString()}
        />
      )
    }
    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage}
          as="image"
          fetchpriority="high"
        />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <!-- Zero-Flash Pre-Paint Theme & Customization Init -->
    <script is:inline>
      (function() {
        try {
          var el = document.documentElement;
          el.classList.add("js");
          var theme = localStorage.getItem("theme");
          el.dataset.theme = theme ?? "dark";

          var accent = localStorage.getItem("preference-accent-color");
          if (accent) el.setAttribute("data-accent", accent);

          var accentBg = localStorage.getItem("preference-accent-bg");
          if (accentBg) el.setAttribute("data-accent-bg", accentBg);

          var density = localStorage.getItem("preference-card-density");
          if (density) el.setAttribute("data-card-density", density);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav container" aria-label="Primary navigation">
        <a class="nav-logo" href="/" aria-label="LazyNoman Home">
          <img
            src="/images/navlogo.webp"
            width="38"
            height="38"
            alt="LazyNoman"
          />
        </a>

        <!-- Mobile Menu Hamburger -->
        <button
          class="menu-button icon-button"
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="primary-links"
        >
          <MenuIcon class="w-4 h-4 mr-1 inline-block" />
          <span>Menu</span>
        </button>

        <div class="nav-links" id="primary-links" data-menu>
          <a href="/posts/">Posts</a>
          <a href="/categories/">Topics</a>
          <a href="/tags/">Tags</a>
          <a
            href="/search/"
            class="icon-button inline-flex items-center gap-1.5"
            aria-label="Search"
            title="Search reviews"
          >
            <SearchIcon class="w-4 h-4" />
            <span>Search</span>
          </a>

          <div class="nav-controls flex items-center gap-2 pt-2 border-t border-[var(--border)] sm:border-t-0 sm:pt-0 sm:ml-auto">
            <!-- UI Customization Flyout -->
            <SettingsFlyout />

            <!-- Theme Toggle Button -->
            <button
              class="icon-button"
              type="button"
              data-theme-toggle
              aria-label="Switch to light theme"
            >
              <Sun class="w-4 h-4 hidden [html[data-theme='light']_&]:block" />
              <Moon class="w-4 h-4 block [html[data-theme='light']_&]:hidden" />
              <span class="sr-only" data-theme-icon aria-hidden="true">☀</span>
              <span class="sr-only">Change color theme</span>
            </button>
          </div>
        </div>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-links">
          <a href="/posts/">Posts</a>
          <a href="/categories/">Topics</a>
          <a href="/tags/">Tags</a>
          <a href="/rss/">RSS</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms-conditions/">Terms</a>
        </div>
        <p>© {new Date().getFullYear()} {site.name} · Independent webfiction reviews & curated rankings</p>
      </div>
    </footer>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
