---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import '../styles/markdown.css';

type Props = CollectionEntry<'post'>['data'];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  creator,
  medium,
  status,
  platform,
  progress,
  tags,
  summary,
  officialTitle,
  synonyms,
} = Astro.props;

const metaItems = [
  { label: 'Creator',  value: creator  },
  { label: 'Medium',   value: medium   },
  { label: 'Status',   value: status   },
  { label: 'Platform', value: platform },
  { label: 'Progress', value: progress },
].filter((item): item is { label: string; value: string } => Boolean(item.value));
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} ogType="article" />
  </head>

  <body>
    <Header />

    <main class="mx-auto w-full max-w-[90rem] px-4 pt-12 pb-24 overflow-x-hidden">
      <article class="flex flex-col lg:flex-row items-start justify-center gap-8 xl:gap-12 relative">

        <div class="post-content-column w-full max-w-4xl lg:flex-1 lg:mx-0">
          {/* ── Post Header ── */}
          <header class="post-header mb-8">
            {/* Post title — reviewer's headline */}
            <h1 class="post-title mb-6">{title}</h1>

            {/* Dateline & Category */}
            <div class="post-meta-row mb-0 text-muted-foreground">
              <div class="post-dateline flex flex-wrap items-center gap-x-6 gap-y-3">
                {category && (
                  <span class="dateline-category flex items-center gap-1.5 font-bold leading-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 block"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <span class="inline-block">{category}</span>
                  </span>
                )}
                
                <span class="flex items-center gap-1.5 leading-none">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 block"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/></svg>
                  <time datetime={pubDate.toISOString()} class="inline-block">
                    <FormattedDate date={pubDate} />
                  </time>
                </span>

                {updatedDate && (
                  <span class="dateline-updated flex items-center gap-1.5 opacity-80 leading-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 block"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M12 7v5l4 2"/></svg>
                    <span class="inline-block">Updated <FormattedDate date={updatedDate} /></span>
                  </span>
                )}
              </div>
            </div>
          </header>

          {/* ── Hero Image ── */}
          {heroImage && (
            <div class="hero-wrap rounded-lg overflow-hidden mb-12">
              <Image
                src={heroImage}
                alt={`Cover for ${title}`}
                class="hero-img"
              />
            </div>
          )}

          {/* ── Prose Body ── */}
          <div class="markdown-body">
            <slot />
          </div>
        </div>

        {/* ── Sticky Sidebar ── */}
        <aside class="w-full lg:w-[320px] lg:sticky lg:top-24 space-y-8">
          {/* ── Metadata Accordion ── */}
          <details class="metadata-accordion group border border-border rounded-xl bg-secondary/10 p-1">
            <summary class="accordion-trigger list-none cursor-pointer flex items-center justify-between p-4 font-bold text-[0.6875rem] uppercase tracking-widest text-muted-foreground select-none hover:bg-secondary/20 rounded-lg transition-colors">
              <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                Media Info
              </span>
              <span class="trigger-icon transition-transform group-open:rotate-90">▶</span>
            </summary>
            
            <div class="accordion-content p-4 pt-2 border-t border-border/50 mt-2">
              
              {/* Official title + synonyms */}
              {(officialTitle || (synonyms && synonyms.length > 0)) && (
                <div class="mb-6">
                  <h4 class="text-[0.625rem] font-bold uppercase tracking-widest text-primary/60 mb-2">Alternative Titles</h4>
                  <p class="official-title-line m-0">
                    {officialTitle && <span class="official-name block mb-1">{officialTitle}</span>}
                    {synonyms && synonyms.length > 0 && (
                      <span class="official-synonyms text-xs leading-relaxed italic block">
                        {synonyms.join(' · ')}
                      </span>
                    )}
                  </p>
                </div>
              )}

              {/* Metadata strip (Creator, Medium, etc) */}
              {metaItems.length > 0 && (
                <div class="mb-6">
                   <h4 class="text-[0.625rem] font-bold uppercase tracking-widest text-primary/60 mb-3">Technical Data</h4>
                   <dl class="flex flex-col gap-3">
                    {metaItems.map(({ label, value }) => (
                      <div class="flex justify-between items-baseline gap-4 border-b border-border/30 pb-1">
                        <dt class="text-[0.625rem] font-bold uppercase tracking-tight text-muted-foreground shrink-0">{label}</dt>
                        <dd class="text-xs font-medium text-foreground text-right">{value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}

              {/* Tags */}
              {tags && tags.length > 0 && (
                <div class="mb-6">
                  <h4 class="text-[0.625rem] font-bold uppercase tracking-widest text-primary/60 mb-3">Tags</h4>
                  <div class="flex flex-wrap gap-1.5">
                    {tags.map((tag: string) => (
                      <span class="tag text-[10px]! px-2! py-0.5!">{tag}</span>
                    ))}
                  </div>
                </div>
              )}

              {/* Summary */}
              {summary && (
                <div class="post-summary-box p-3 rounded-lg bg-secondary/30 border border-border/50">
                  <h4 class="text-[0.625rem] font-bold uppercase tracking-widest text-primary mb-2">Official Summary</h4>
                  <p class="text-xs italic leading-relaxed text-muted-foreground m-0">{summary}</p>
                </div>
              )}
            </div>
          </details>
        </aside>

      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  /*
   * ─────────────────────────────────────────────────────
   * THEME BRIDGE
   * Mirrors the site's @theme OKLCH tokens; stays in sync
   * when .dark is toggled on <html>.
   * ─────────────────────────────────────────────────────
   */
  :root {
    --p-bg:        oklch(1 0 0);
    --p-fg:        oklch(0.145 0 0);
    --p-primary:   oklch(0.205 0 0);
    --p-secondary: oklch(0.97 0 0);
    --p-border:    oklch(0.922 0 0);
    --p-muted:     oklch(0.50 0 0);
    --p-radius:    0.625rem;
  }

  :global(.dark) {
    --p-bg:        oklch(0.19 0 0);
    --p-fg:        oklch(0.92 0 0);
    --p-primary:   oklch(0.92 0 0);
    --p-secondary: oklch(0.28 0 0);
    --p-border:    oklch(0.35 0 0);
    --p-muted:     oklch(0.62 0 0);
  }


  /* ═══════════════════════════
     HERO
  ═══════════════════════════ */
 
  .hero-wrap {
    position: relative;
    width: 100%;
    height: auto;
    max-height: 80vh;
    display: flex;
    justify-content: center;
    background: var(--p-bg);
  }
 
  .hero-img {
    width: 100%;
    height: auto;
    max-height: 80vh;
    display: block;
    object-fit: contain;
  }
 
 
  /* ═══════════════════════════
     POST HEADER
  ═══════════════════════════ */
 
  .post-header {
    position: relative;
    z-index: 2;
  }
 
 
  /* ── Dateline ── */
 
  .post-dateline {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--p-muted);
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dateline-category {
    color: var(--p-primary);
    opacity: 0.8;
  }

  .dateline-sep {
    opacity: 0.35;
  }

  .dateline-updated {
    font-weight: 400;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.03em;
  }


  /* ── Post Title ── */

  .post-title {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--p-fg);
    margin: 0 0 0.625rem;
    /*
     * Soft glow aids legibility when sitting over the hero veil.
     * Invisible on plain backgrounds.
     */
    text-shadow:
      0 1px 14px color-mix(in oklch, var(--p-bg) 72%, transparent),
      0 3px 32px color-mix(in oklch, var(--p-bg) 48%, transparent);
  }


  /* ── Official Title & Synonyms ── */

  .official-title-line {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0 0 1.375rem;
    display: flex;
    flex-wrap: wrap;
  }

  .official-name {
    font-weight: 600;
    color: var(--p-fg);
    opacity: 0.55;
  }

  .official-synonyms {
    font-weight: 400;
    color: var(--p-muted);
  }


  /* ── Summary / Lede ── */

  .post-summary {
    font-family: 'Atkinson', sans-serif;
    font-size: clamp(1.0625rem, 1.2vw + 0.65rem, 1.1875rem);
    line-height: 1.7;
    color: var(--p-muted);
    font-style: normal;
    margin: 0 0 1.75rem;
  }


  /* ── Metadata Strip ── */

  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .meta-pair {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  /*
   * Vertical hairline separator between pairs.
   * Lives as a flex child via ::before — no extra markup needed.
   */
  .meta-pair:not(:first-child)::before {
    content: '';
    display: block;
    width: 1px;
    height: 0.75em;
    background: var(--p-border);
    margin: 0 0.75rem;
    align-self: center;
    flex-shrink: 0;
  }

  .meta-pair dt {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--p-muted);
  }

  .meta-pair dd {
    font-family: 'Atkinson', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--p-fg);
    margin: 0;
  }


  /* ── Tags ── */

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 1.625rem;
  }

  .tag {
    font-family: 'Geist Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: calc(var(--p-radius) * 0.7);
    background: var(--p-secondary);
    color: var(--p-muted);
    border: 1px solid var(--p-border);
    transition: color 0.15s, border-color 0.15s;
  }

  .tag:hover {
    color: var(--p-primary);
    border-color: color-mix(in oklch, var(--p-primary) 45%, transparent);
  }


  /* ── Post Divider ── */

  .post-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0; /* prose container supplies top padding */
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--p-border);
  }

  .divider-diamond {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    background: var(--p-primary);
    transform: rotate(45deg);
    border-radius: 1px;
    opacity: 0.8;
  }


  /* ═══════════════════════════
     RESPONSIVE
  ═══════════════════════════ */

  @media (max-width: 768px) {
    .meta-pair:not(:first-child)::before { margin: 0 0.5rem; }
  }

  @media (max-width: 480px) {
    .post-title { font-size: clamp(1.625rem, 7.5vw, 2.25rem); }
  }
</style>