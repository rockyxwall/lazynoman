---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Comments from "../components/Comments.astro";
import { Badge } from "../components/ui/badge";
import "../styles/markdown.css";

interface Props {
  novel: any;
  review?: any;
}

const { novel, review } = Astro.props;

// Metadata from review if available, otherwise from novel
const title = review?.data.title || novel.name;
const description = review?.data.description || `Read my review and track progress for ${novel.name}.`;
const heroImage = review?.data.heroImage || novel.cover_url;
const pubDate = review?.data.pubDate;
const updatedDate = review?.data.updatedDate;
const category = review?.data.category || "novel";
const tags = review?.data.tags || novel.genres;

// Schema.org
const schema = {
  "@context": "https://schema.org",
  "@type": "Review",
  name: title,
  reviewBody: description,
  datePublished: pubDate ? pubDate.toISOString() : undefined,
  dateModified: updatedDate ? updatedDate.toISOString() : undefined,
  author: {
    "@type": "Person",
    name: "lazyman",
  },
  itemReviewed: {
    "@type": "Book",
    name: novel.name,
    author: review?.data.itemAuthor ? { "@type": "Person", name: review.data.itemAuthor } : undefined,
  },
  reviewRating: review?.data.rating
    ? {
        "@type": "Rating",
        ratingValue: review.data.rating,
        bestRating: "10",
        worstRating: "1",
      }
    : undefined,
};
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      ogType="article"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Header />

    <main class="mx-auto w-full max-w-4xl px-4 pt-12 pb-24 overflow-x-hidden">
      <article class="space-y-12">
        {/* ── Novel Info Header ── */}
        <header class="flex flex-col md:flex-row gap-12 items-start">
          <div class="w-full md:w-72 aspect-[3/4] bg-muted rounded-xl border border-border overflow-hidden shadow-2xl flex-shrink-0">
            <img 
              src={novel.cover_url || '/img/placeholder.webp'} 
              alt={novel.name} 
              class="w-full h-full object-cover" 
            />
          </div>

          <div class="flex-grow space-y-8">
            <div class="space-y-4">
              <div class="flex flex-wrap gap-2 items-center">
                <span class="bg-primary text-primary-foreground font-mono text-[10px] font-bold tracking-widest px-3 py-1 rounded-full uppercase">
                  {novel.status}
                </span>
                {novel.rating && (
                  <span class="bg-muted border border-border text-foreground font-mono text-[10px] font-bold tracking-widest px-3 py-1 rounded-full uppercase">
                    {novel.rating} / 10
                  </span>
                )}
                {novel.media_type && (
                  <span class="bg-muted border border-border text-muted-foreground font-mono text-[10px] font-bold tracking-widest px-3 py-1 rounded-full uppercase">
                    {novel.media_type}
                  </span>
                )}
              </div>
              <h1 class="novel-title italic uppercase">
                {novel.name}
              </h1>
            </div>

            <div class="grid grid-cols-2 gap-6">
              <div class="p-6 bg-card border border-border rounded-xl group hover:bg-muted transition-colors">
                <p class="text-[10px] uppercase tracking-[0.2em] font-black text-muted-foreground mb-2 font-mono italic">Chapters Read</p>
                <p class="text-3xl font-black italic tracking-tighter">{novel.read_chapters.toLocaleString()}</p>
              </div>
              <div class="p-6 bg-card border border-border rounded-xl group hover:bg-muted transition-colors">
                <p class="text-[10px] uppercase tracking-[0.2em] font-black text-muted-foreground mb-2 font-mono italic">Total Chapters</p>
                <p class="text-3xl font-black italic tracking-tighter text-muted-foreground/30">{novel.total_chapters ? novel.total_chapters.toLocaleString() : '???'}</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-border">
              {tags.map((tag: string) => (
                <span class="text-[10px] font-bold font-mono uppercase tracking-[0.15em] text-muted-foreground/60">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </header>

        {/* ── Review Content Wrapper ── */}
        <div class="pt-16 border-t border-border space-y-12">
          {review && (
            <div class="space-y-6">
              <h2 class="review-title">{title}</h2>
              <div class="post-meta-row text-muted-foreground border-b border-border/50 pb-6">
                <div class="post-dateline flex flex-wrap items-center gap-x-8 gap-y-3 text-[10px] tracking-[0.2em] font-bold uppercase font-mono">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary/30"></span>
                    <time datetime={pubDate.toISOString()}>
                      <FormattedDate date={pubDate} />
                    </time>
                  </span>
                  {updatedDate && (
                    <span class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-yellow-500/30"></span>
                      <span>Updated <FormattedDate date={updatedDate} /></span>
                    </span>
                  )}
                </div>
              </div>
            </div>
          )}
          
          <div class="markdown-body">
            <slot />
          </div>
        </div>

        {review && <Comments />}
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .novel-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .review-title {
    font-family: "Atkinson", sans-serif;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
</style>
