---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Comments from "../components/Comments.astro";
import { Badge } from "../components/ui/badge";
import "../styles/markdown.css";

interface Props {
  novel: any;
  review?: any;
}

const { novel, review } = Astro.props;

// Metadata from review if available, otherwise from novel
const title = review?.data.title || novel.name;
const description = review?.data.description || `Read my review and track progress for ${novel.name}.`;
const heroImage = review?.data.heroImage || novel.cover_url;
const pubDate = review?.data.pubDate;
const updatedDate = review?.data.updatedDate;
const category = review?.data.category || "novel";
const tags = review?.data.tags || novel.genres;

// Schema.org
const schema = {
  "@context": "https://schema.org",
  "@type": "Review",
  name: title,
  reviewBody: description,
  datePublished: pubDate ? pubDate.toISOString() : undefined,
  dateModified: updatedDate ? updatedDate.toISOString() : undefined,
  author: {
    "@type": "Person",
    name: "lazyman",
  },
  itemReviewed: {
    "@type": "Book",
    name: novel.name,
    author: review?.data.itemAuthor ? { "@type": "Person", name: review.data.itemAuthor } : undefined,
  },
  reviewRating: review?.data.rating
    ? {
        "@type": "Rating",
        ratingValue: review.data.rating,
        bestRating: "10",
        worstRating: "1",
      }
    : undefined,
};
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      ogType="article"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <Header />

    <main class="mx-auto w-full max-w-4xl px-4 pt-12 pb-24 overflow-x-hidden">
      <article class="space-y-12">
        {/* ── Novel Info Header ── */}
        <header class="flex flex-col md:flex-row gap-8 items-start">
          <div class="w-full md:w-64 aspect-[3/4] bg-muted rounded-3xl border border-border overflow-hidden shadow-2xl flex-shrink-0">
            <img 
              src={novel.cover_url || '/img/placeholder.webp'} 
              alt={novel.name} 
              class="w-full h-full object-cover" 
            />
          </div>

          <div class="flex-grow space-y-6">
            <div class="space-y-2">
              <div class="flex flex-wrap gap-2 items-center">
                <Badge variant="outline" className="font-black uppercase italic tracking-widest text-[10px]">
                  {novel.status}
                </Badge>
                {novel.rating && (
                  <span class="text-sm font-black text-yellow-500 flex items-center gap-1">
                    ★ {novel.rating} / 10
                  </span>
                )}
                {novel.media_type && (
                  <Badge variant="secondary" className="font-bold uppercase text-[10px]">
                    {novel.media_type}
                  </Badge>
                )}
              </div>
              <h1 class="novel-title">
                {novel.name}
              </h1>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 bg-muted/50 rounded-2xl border border-border">
                <p class="text-[10px] uppercase tracking-widest font-black text-muted-foreground mb-1 italic">Chapters Read</p>
                <p class="text-2xl font-black">{novel.read_chapters}</p>
              </div>
              <div class="p-4 bg-muted/50 rounded-2xl border border-border">
                <p class="text-[10px] uppercase tracking-widest font-black text-muted-foreground mb-1 italic">Total Chapters</p>
                <p class="text-2xl font-black">{novel.total_chapters || '?'}</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              {novel.genres.map((genre: string) => (
                <Badge variant="secondary" className="font-bold">#{genre}</Badge>
              ))}
            </div>
          </div>
        </header>

        {/* ── Review Content Wrapper ── */}
        <div class="pt-12 border-t border-border space-y-8">
          {review && (
            <div class="space-y-4">
              <h2 class="review-title">{title}</h2>
              <div class="post-meta-row text-muted-foreground">
                <div class="post-dateline flex flex-wrap items-center gap-x-6 gap-y-3 text-xs tracking-wider font-medium opacity-80">
                  <span class="flex items-center gap-1.5 leading-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><path d="M3 10h18"></path><path d="M8 2v4"></path><path d="M16 2v4"></path></svg>
                    <time datetime={pubDate.toISOString()} class="inline-block">
                      <FormattedDate date={pubDate} />
                    </time>
                  </span>
                  {updatedDate && (
                    <span class="dateline-updated flex items-center gap-1.5 leading-none">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M12 7v5l4 2" /></svg>
                      <span class="inline-block">Updated <FormattedDate date={updatedDate} /></span>
                    </span>
                  )}
                </div>
              </div>
            </div>
          )}
          
          <slot />
        </div>

        {review && <Comments />}
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .novel-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .review-title {
    font-family: "Atkinson", sans-serif;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
</style>
